  "exerciseRules": [
    {
      "id": "upper-back-load-uses-back-squat-setup",
      "description": "An upper-back straight bar is the reviewed free-weight back-squat setup; this value does not fabricate an unreported high- versus low-bar site.",
      "when": {
        "field": "variant.loadPlacement",
        "operator": "equals",
        "value": "upperBackBarbell"
