{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "bilateral-squat",
  "name": "Bilateral Squat",
  "definition": "A two-leg closed-chain compound squat in which both feet remain planted while the hips and knees flex to a source-reviewed endpoint, then the athlete returns to standing through hip extension, knee extension, and ankle plantarflexion. The roster owns loaded thigh-parallel barbell, kettlebell, and exact Smith fixtures plus one stable-floor bodyweight fixture ending at approximately 100 degrees of knee flexion; those endpoints are not treated as equivalent. Implement-specific hand and shoulder demands apply only to loaded branches. Split-stance, lateral, box, wall, jump, thruster, unstable-surface, one-leg, differently loaded, partial, and full-depth variants remain outside this contract.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "armstrong-2022-squat-movement-dynamics",
    "gorsic-2024-squat-load-placement",
    "joseph-2020-back-belt-squat",
    "kubo-2019-squat-depth-hypertrophy",
    "mccormick-2023-front-back-squat-bracing",
    "purzel-2026-powerlifting-squat-joint-moments",
    "sinclair-2022-back-squat-foot-angle",
    "yavuz-2015-front-back-squat-emg",
    "nasm-2026-goblet-squat",
    "collins-2021-goblet-landmine-squat",
    "lee-2017-smith-squat-human-machine",
    "escamilla-2025-bodyweight-floor-squat"
  ],
