  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether both distal feet remain fixed against the floor while the body moves.",
      "allowedValues": [
        "closed"
      ]
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "description": "The gross whole-body posture at the start and end of each repetition.",
      "allowedValues": [
        "standing"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "Whether an external surface supports the torso during the repetition.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "stanceConfiguration",
      "valueType": "enum",
      "required": true,
      "description": "The bilateral relationship of the two feet; every admitted fixture uses a symmetric, non-split stance.",
      "allowedValues": [
        "symmetricBilateral"
      ]
    },
    {
      "id": "stanceWidth",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed heel-to-heel stance width relative to the athlete's hips.",
      "allowedValues": [
        "hipWidth",
        "shoulderWidth",
        "slightlyWiderThanHipWidth"
      ]
    },
    {
      "id": "loadPlacement",
      "valueType": "enum",
      "required": true,
      "description": "Where the bar or single kettlebell is supported during the exact squat fixture.",
      "allowedValues": [
        "upperBackBarbell",
        "anteriorDeltoidClavicleBarbell",
        "kettlebellVerticalAtChestByHorns",
        "none"
      ]
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "The bilateral hand configuration used to control the bar or kettlebell in the exact fixture.",
      "allowedValues": [
        "pronated",
        "cleanGrip",
        "hornGrip",
        "notApplicable"
      ]
    },
    {
      "id": "rangeOfMotion",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed depth class; the upper thighs reach approximately parallel to the floor before the ascent.",
      "allowedValues": [
        "thighParallel",
        "approximately100DegreesKneeFlexion"
      ]
    },
    {
      "id": "spineMotion",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed studies measured load- and bracing-sensitive lumbar alignment rather than a literally fixed spinal angle; deliberate spinal motion is not a prime action, but the exact path is not standardized.",
      "allowedValues": [
        "nonstandardized"
      ]
    },
    {
      "id": "hipMotion",
      "valueType": "enum",
      "required": true,
      "description": "The dynamic concentric hip motion that returns the athlete to standing.",
      "allowedValues": [
        "extends"
      ]
    },
    {
      "id": "kneeMotion",
      "valueType": "enum",
      "required": true,
      "description": "The dynamic concentric knee motion that returns the athlete to standing.",
      "allowedValues": [
        "extends"
      ]
    },
    {
      "id": "ankleMotion",
      "valueType": "enum",
      "required": true,
      "description": "The dynamic concentric ankle motion from bottom-position dorsiflexion toward the standing position.",
      "allowedValues": [
        "plantarflexes"
      ]
    },
    {
      "id": "footMotion",
      "valueType": "enum",
      "required": true,
      "description": "Whether deliberate toe motion creates the repetition; the reviewed squat keeps the foot planted and position-held.",
      "allowedValues": [
        "positionHeld"
      ]
    },
    {
      "id": "footContact",
      "valueType": "enum",
      "required": true,
      "description": "Whether both feet retain continuous floor contact through descent, ascent, and standing lockout.",
      "allowedValues": [
        "continuous"
      ]
    },
    {
      "id": "interRepSupport",
      "valueType": "enum",
      "required": true,
      "description": "Whether an external support receives the body or load between repetitions.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "description": "Whether rails constrain the implement path; only the exact Smith-machine branch is fixed."
    },
    {
      "id": "implementConfiguration",
      "valueType": "enum",
      "required": true,
      "description": "The implement arrangement used by the exact fixture.",
      "allowedValues": [
        "straightBarbell",
        "singleKettlebell",
        "verticalSmithBar",
        "none"
      ]
    },
    {
      "id": "loadAccounting",
      "valueType": "enum",
      "required": true,
      "description": "How the entered load maps to the free-weight or machine fixture.",
      "allowedValues": [
        "totalBarAndPlates",
        "totalSingleImplement",
        "enteredExternalLoadSameFixtureOnly",
        "notApplicable"
      ]
    },
    {
      "id": "railOrientationDegrees",
      "valueType": "number",
      "required": false,
      "description": "The Smith rail angle from vertical for the directly reviewed machine.",
      "minimum": 0,
      "maximum": 0
    },
    {
      "id": "footOffsetFromBarCm",
      "valueType": "number",
      "required": false,
      "description": "The horizontal foot offset from the Smith bar line in the source fixture.",
      "minimum": 0,
      "maximum": 0
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "description": "Which lower-body joint motions deliberately create the concentric repetition.",
      "allowedValues": [
        "compoundHipKneeAnkleExtension"
      ]
    },
    {
      "id": "footOrientation",
      "valueType": "enum",
      "required": false,
      "description": "The exact bodyweight protocol's self-selected outward foot angle.",
      "allowedValues": ["selfSelectedToeOut"]
    },
    {
      "id": "supportSurface",
      "valueType": "enum",
      "required": false,
      "description": "The stable support surface beneath both feet.",
      "allowedValues": ["floor"]
    },
    {
      "id": "cadenceProtocol",
      "valueType": "enum",
      "required": false,
      "description": "The approximate source-controlled angular pace rather than a universal training cadence.",
      "allowedValues": ["approximately45DegreesPerSecond"]
    }
  ],
  "recommended": {
    "defaultReps": {
      "minimum": 3,
      "maximum": 12
    }
  },
  "exerciseRules": [
    {
      "id": "upper-back-load-uses-back-squat-setup",
      "description": "An upper-back bar uses a pronated control grip; free-bar records do not fabricate an unreported high- versus low-bar site, while the Smith branch separately pins its rail geometry.",
      "when": {
        "field": "variant.loadPlacement",
        "operator": "equals",
        "value": "upperBackBarbell"
      },
      "then": [
        {
          "field": "variant.gripOrientation",
          "value": "pronated"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "externalRotators",
          "role": "stabilizer"
        }
      ]
    },
    {
      "id": "pronated-grip-is-back-squat",
      "description": "The reviewed pronated bar-control setup belongs to the upper-back barbell back squat.",
      "when": {
        "field": "variant.gripOrientation",
        "operator": "equals",
        "value": "pronated"
      },
      "then": [
        {
          "field": "variant.loadPlacement",
          "value": "upperBackBarbell"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "anterior-load-uses-clean-grip",
      "description": "An anterior-deltoid and clavicle bar position uses the canonical clean-grip front-rack setup; the grip is figure- and mechanics-derived rather than a controlled study factor.",
      "when": {
        "field": "variant.loadPlacement",
        "operator": "equals",
        "value": "anteriorDeltoidClavicleBarbell"
      },
      "then": [
        {
          "field": "variant.gripOrientation",
          "value": "cleanGrip"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "deltoidAnterior",
          "role": "stabilizer"
        }
      ]
    },
    {
      "id": "clean-grip-is-front-rack-squat",
      "description": "The canonical clean-grip setup belongs to the anterior-deltoid and clavicle front squat; this rule bounds a mechanics-derived product choice.",
      "when": {
        "field": "variant.gripOrientation",
        "operator": "equals",
        "value": "cleanGrip"
      },
      "then": [
        {
          "field": "variant.loadPlacement",
          "value": "anteriorDeltoidClavicleBarbell"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "barbell-fixtures-use-free-straight-bar-accounting",
      "description": "Free-bar squat records log total bar-and-plate load and have no Smith geometry.",
      "when": {"field": "equipment", "operator": "equals", "value": "barbell"},
      "then": [
        {"field": "variant.stanceWidth", "value": "hipWidth"},
        {"field": "variant.fixedPath", "value": false},
        {"field": "variant.implementConfiguration", "value": "straightBarbell"},
        {"field": "variant.loadAccounting", "value": "totalBarAndPlates"}
      ],
      "requirePresent": [],
      "requireAbsent": ["variant.railOrientationDegrees", "variant.footOffsetFromBarCm"]
    },
    {
      "id": "goblet-fixture-pins-single-kettlebell",
      "description": "The reviewed goblet squat holds one vertical kettlebell by its horns at the chest.",
      "when": {"field": "equipment", "operator": "equals", "value": "kettlebell"},
      "then": [
        {"field": "variant.stanceWidth", "value": "shoulderWidth"},
        {"field": "variant.loadPlacement", "value": "kettlebellVerticalAtChestByHorns"},
        {"field": "variant.gripOrientation", "value": "hornGrip"},
        {"field": "variant.fixedPath", "value": false},
        {"field": "variant.implementConfiguration", "value": "singleKettlebell"},
        {"field": "variant.loadAccounting", "value": "totalSingleImplement"}
      ],
      "requirePresent": [],
      "requireAbsent": ["variant.railOrientationDegrees", "variant.footOffsetFromBarCm"]
    },
    {
      "id": "smith-fixture-pins-reviewed-vertical-zero-offset-path",
      "description": "The reviewed Smith squat uses a vertical rail, zero horizontal foot offset from the bar line, and upper-back placement.",
      "when": {"field": "equipment", "operator": "equals", "value": "machine"},
      "then": [
        {"field": "variant.stanceWidth", "value": "shoulderWidth"},
        {"field": "variant.loadPlacement", "value": "upperBackBarbell"},
        {"field": "variant.gripOrientation", "value": "pronated"},
        {"field": "variant.fixedPath", "value": true},
        {"field": "variant.implementConfiguration", "value": "verticalSmithBar"},
        {"field": "variant.loadAccounting", "value": "enteredExternalLoadSameFixtureOnly"},
        {"field": "variant.railOrientationDegrees", "value": 0},
        {"field": "variant.footOffsetFromBarCm", "value": 0}
      ],
      "requirePresent": ["variant.railOrientationDegrees", "variant.footOffsetFromBarCm"],
      "requireAbsent": []
    },
    {
      "id": "horn-grip-identifies-goblet-load",
      "description": "A horn grip belongs to the single-kettlebell goblet fixture.",
      "when": {"field": "variant.gripOrientation", "operator": "equals", "value": "hornGrip"},
      "then": [
        {"field": "equipment", "value": "kettlebell"},
        {"field": "variant.loadPlacement", "value": "kettlebellVerticalAtChestByHorns"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "loaded-squats-require-implement-support-contract",
      "description": "Every loaded branch retains its hand and shoulder support-chain requirements, while the bodyweight fixture does not inherit them.",
      "when": {"field": "equipment", "operator": "notEquals", "value": "bodyweight"},
      "then": [
        {"field": "loadMode", "value": "external"},
        {"field": "variant.rangeOfMotion", "value": "thighParallel"}
      ],
      "requirePresent": [],
      "requireAbsent": ["variant.footOrientation", "variant.supportSurface", "variant.cadenceProtocol"],
      "requireMuscleRequirements": [
        {"anyOf": ["fingerFlexors"], "minimumRole": "stabilizer"},
        {"anyOf": ["extensorCarpiRadialis"], "minimumRole": "stabilizer"},
        {"anyOf": ["deltoidAnterior", "externalRotators"], "minimumRole": "stabilizer"},
        {"anyOf": ["trapeziusUpper"], "minimumRole": "stabilizer"},
        {"anyOf": ["brachialis"], "minimumRole": "stabilizer"}
      ],
      "requireAdditionalStabilityDemands": ["shoulder", "scapula", "elbow", "wrist", "hand"]
    },
    {
      "id": "bodyweight-depth-is-bodyweight-only",
      "description": "The approximately 100-degree depth belongs only to the reviewed bodyweight floor squat.",
      "when": {"field": "variant.rangeOfMotion", "operator": "equals", "value": "approximately100DegreesKneeFlexion"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "bodyweight-stance-is-bodyweight-only",
      "description": "The slightly-wider-than-hip stance belongs only to the reviewed bodyweight floor squat.",
      "when": {"field": "variant.stanceWidth", "operator": "equals", "value": "slightlyWiderThanHipWidth"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "no-load-placement-is-bodyweight-only",
      "description": "No implement placement belongs only to the reviewed bodyweight floor squat.",
      "when": {"field": "variant.loadPlacement", "operator": "equals", "value": "none"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "not-applicable-grip-is-bodyweight-only",
      "description": "A not-applicable grip belongs only to the reviewed bodyweight floor squat.",
      "when": {"field": "variant.gripOrientation", "operator": "equals", "value": "notApplicable"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "no-implement-is-bodyweight-only",
      "description": "No implement configuration belongs only to the reviewed bodyweight floor squat.",
      "when": {"field": "variant.implementConfiguration", "operator": "equals", "value": "none"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "not-applicable-load-accounting-is-bodyweight-only",
      "description": "Not-applicable load accounting belongs only to the reviewed bodyweight floor squat.",
      "when": {"field": "variant.loadAccounting", "operator": "equals", "value": "notApplicable"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "bodyweight-floor-squat-fixture",
      "description": "The bodyweight branch is the exact stable-floor, two-leg squat to approximately 100 degrees of knee flexion with no implement.",
      "when": {"field": "equipment", "operator": "equals", "value": "bodyweight"},
      "then": [
        {"field": "loadMode", "value": "nonComparable"},
        {"field": "bodyweightFraction", "value": 0},
        {"field": "variant.stanceWidth", "value": "slightlyWiderThanHipWidth"},
        {"field": "variant.loadPlacement", "value": "none"},
        {"field": "variant.gripOrientation", "value": "notApplicable"},
        {"field": "variant.rangeOfMotion", "value": "approximately100DegreesKneeFlexion"},
        {"field": "variant.fixedPath", "value": false},
        {"field": "variant.implementConfiguration", "value": "none"},
        {"field": "variant.loadAccounting", "value": "notApplicable"},
        {"field": "variant.footOrientation", "value": "selfSelectedToeOut"},
        {"field": "variant.supportSurface", "value": "floor"},
        {"field": "variant.cadenceProtocol", "value": "approximately45DegreesPerSecond"}
      ],
      "requirePresent": ["variant.footOrientation", "variant.supportSurface", "variant.cadenceProtocol"],
      "requireAbsent": ["variant.railOrientationDegrees", "variant.footOffsetFromBarCm"],
      "requireAdditionalStabilityDemands": []
    }
  ],
