      "execution": {
        "startingPosition": "Stand with your heels about hip-width apart and a straight barbell resting securely across your upper back. Hold the bar with both hands in an overhand grip.",
        "movement": "Bend your hips and knees, letting your knees travel forward naturally.",
        "endpoint": "End the descent when your upper thighs are about parallel to the floor.",
