  "exerciseRules": [
    {
      "id": "upper-back-load-uses-back-squat-setup",
      "description": "An upper-back bar uses a pronated control grip; free-bar records do not fabricate an unreported high- versus low-bar site, while the Smith branch separately pins its rail geometry.",
      "when": {
        "field": "variant.loadPlacement",
        "operator": "equals",
        "value": "upperBackBarbell"
      },
      "then": [
        {
          "field": "variant.gripOrientation",
          "value": "pronated"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "externalRotators",
          "role": "stabilizer"
        }
      ]
    },
    {
      "id": "pronated-grip-is-back-squat",
      "description": "The reviewed pronated bar-control setup belongs to the upper-back barbell back squat.",
      "when": {
        "field": "variant.gripOrientation",
        "operator": "equals",
        "value": "pronated"
      },
      "then": [
        {
          "field": "variant.loadPlacement",
          "value": "upperBackBarbell"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "anterior-load-uses-clean-grip",
      "description": "An anterior-deltoid and clavicle bar position uses the canonical clean-grip front-rack setup; the grip is figure- and mechanics-derived rather than a controlled study factor.",
      "when": {
        "field": "variant.loadPlacement",
        "operator": "equals",
        "value": "anteriorDeltoidClavicleBarbell"
      },
      "then": [
        {
          "field": "variant.gripOrientation",
          "value": "cleanGrip"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "deltoidAnterior",
          "role": "stabilizer"
        }
      ]
    },
    {
      "id": "clean-grip-is-front-rack-squat",
      "description": "The canonical clean-grip setup belongs to the anterior-deltoid and clavicle front squat; this rule bounds a mechanics-derived product choice.",
      "when": {
        "field": "variant.gripOrientation",
        "operator": "equals",
        "value": "cleanGrip"
      },
      "then": [
        {
          "field": "variant.loadPlacement",
          "value": "anteriorDeltoidClavicleBarbell"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "barbell-fixtures-use-free-straight-bar-accounting",
      "description": "Free-bar squat records log total bar-and-plate load and have no Smith geometry.",
      "when": {"field": "equipment", "operator": "equals", "value": "barbell"},
      "then": [
        {"field": "variant.fixedPath", "value": false},
        {"field": "variant.implementConfiguration", "value": "straightBarbell"},
        {"field": "variant.loadAccounting", "value": "totalBarAndPlates"}
      ],
      "requirePresent": [],
      "requireAbsent": ["variant.railOrientationDegrees", "variant.footOffsetFromBarCm"]
    },
    {
      "id": "goblet-fixture-pins-single-kettlebell",
      "description": "The reviewed goblet squat holds one vertical kettlebell by its horns at the chest.",
      "when": {"field": "equipment", "operator": "equals", "value": "kettlebell"},
      "then": [
        {"field": "variant.stanceWidth", "value": "shoulderWidth"},
        {"field": "variant.loadPlacement", "value": "kettlebellVerticalAtChestByHorns"},
        {"field": "variant.gripOrientation", "value": "hornGrip"},
        {"field": "variant.fixedPath", "value": false},
        {"field": "variant.implementConfiguration", "value": "singleKettlebell"},
        {"field": "variant.loadAccounting", "value": "totalSingleImplement"}
      ],
      "requirePresent": [],
      "requireAbsent": ["variant.railOrientationDegrees", "variant.footOffsetFromBarCm"]
    },
    {
      "id": "smith-fixture-pins-reviewed-vertical-zero-offset-path",
      "description": "The reviewed Smith squat uses a vertical rail, zero horizontal foot offset from the bar line, and upper-back placement.",
      "when": {"field": "equipment", "operator": "equals", "value": "machine"},
      "then": [
        {"field": "variant.stanceWidth", "value": "shoulderWidth"},
        {"field": "variant.loadPlacement", "value": "upperBackBarbell"},
        {"field": "variant.gripOrientation", "value": "pronated"},
        {"field": "variant.fixedPath", "value": true},
        {"field": "variant.implementConfiguration", "value": "verticalSmithBar"},
        {"field": "variant.loadAccounting", "value": "enteredExternalLoadSameFixtureOnly"},
        {"field": "variant.railOrientationDegrees", "value": 0},
        {"field": "variant.footOffsetFromBarCm", "value": 0}
      ],
      "requirePresent": ["variant.railOrientationDegrees", "variant.footOffsetFromBarCm"],
      "requireAbsent": []
    },
    {
      "id": "horn-grip-identifies-goblet-load",
      "description": "A horn grip belongs to the single-kettlebell goblet fixture.",
      "when": {"field": "variant.gripOrientation", "operator": "equals", "value": "hornGrip"},
      "then": [
        {"field": "equipment", "value": "kettlebell"},
        {"field": "variant.loadPlacement", "value": "kettlebellVerticalAtChestByHorns"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    }
  ],
