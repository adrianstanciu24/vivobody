{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "horizontal-press",
  "name": "Horizontal Press",
  "definition": "A compound press whose concentric phase combines shoulder horizontal adduction with elbow extension in either an open or closed kinetic chain. The resistance path is approximately perpendicular to the torso's longitudinal axis; inclined, declined, vertical, and elbow-isolation presses belong to other families. Grip-width variants remain horizontal presses but are deferred until a hand-spacing axis is reviewed. Feet-elevated and hands-elevated push-ups are future incline-press and decline-press variants respectively, once those contracts admit closed-chain bodyweight exercises.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "borges-2019-bench-machine-scapula",
    "boroto-2018-scapular-stabilizers-press",
    "cabral-2022-pectoralis-regions",
    "coratella-2020-bench-press-variations",
    "van-den-tillaar-2019-pushup-bench"
  ],
  "fixed": {
    "mechanic": "compound",
    "pattern": "push",
    "direction": "horizontal",
    "planes": [
      "transverse"
    ]
  },
  "groupPolicy": {
    "default": "chest",
    "allowed": [
      "chest"
    ]
  },
  "allowed": {
    "equipment": [
      "barbell",
      "dumbbell",
      "cable",
      "machine",
      "bodyweight"
    ],
    "modalities": [
      "dynamicStrength"
    ],
    "trackingModes": [
      "reps"
    ],
    "loadModes": [
      "external",
      "bodyweightAdded"
    ],
    "lateralities": [
      "bilateral",
      "unilateral"
    ]
  },
  "movementSignature": {
    "planeBasisActions": [
      "shoulder.horizontalAdduction"
    ],
    "primeActions": [
      "shoulder.horizontalAdduction",
      "elbow.extension"
    ],
    "forbiddenPrimeActions": [
      "shoulder.flexion",
      "shoulder.extension"
    ],
    "stabilityDemands": [
      "shoulder",
      "scapula"
    ]
  },
  "musclePolicy": {
    "requirements": [
      {
        "anyOf": [
          "pectoralisMajorSternocostal"
        ],
        "minimumRole": "primary"
      },
      {
        "anyOf": [
          "triceps"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "deltoidAnterior"
        ],
        "minimumRole": "secondary"
      }
    ],
    "allowedByRole": {
      "primary": [
        "pectoralisMajorSternocostal"
      ],
      "secondary": [
        "pectoralisMajorClavicular",
        "deltoidAnterior",
        "triceps",
        "serratus"
      ],
      "stabilizer": [
        "serratus",
        "trapeziusMiddle",
        "externalRotators",
        "abs",
        "obliques"
      ]
    }
  },
  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether the distal segment moves freely or remains fixed.",
      "allowedValues": [
        "open",
        "closed"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "The external surface directly supporting the torso during the press.",
      "allowedValues": [
        "bench",
        "floor",
        "machinePad",
        "none"
      ]
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "description": "Whether external posterior support limits scapular translation along the thorax; this does not classify scapular rotation or tilt.",
      "allowedValues": [
        "free",
        "supportConstrained"
      ]
    },
    {
      "id": "pressInclinationDegrees",
      "valueType": "number",
      "required": true,
      "description": "Signed inclination of the canonical torso-relative press from horizontal: positive toward overhead and negative toward decline; a supported free-weight press uses backrest angle as the proxy.",
      "minimum": 0,
      "maximum": 0
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "Canonical forearm and hand orientation through the working range.",
      "allowedValues": [
        "pronated",
        "neutral",
        "rotating"
      ]
    },
    {
      "id": "rangeOfMotion",
      "valueType": "enum",
      "required": true,
      "description": "Whether the canonical lowering phase is unrestricted or stopped when the upper arm contacts the floor.",
      "allowedValues": [
        "full",
        "floorLimited"
      ]
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "description": "Whether rails or a lever constrain the external load path."
    },
    {
      "id": "machineType",
      "valueType": "enum",
      "required": false,
      "description": "The machine mechanism when equipment is machine.",
      "allowedValues": [
        "smith",
        "convergingChestPress"
      ]
    },
    {
      "id": "lowerBodySupport",
      "valueType": "enum",
      "required": true,
      "description": "The lower-body contact or support that materially changes effective bodyweight loading; none when no such contact participates.",
      "allowedValues": [
        "none",
        "feet",
        "knees"
      ]
    }
  ],
  "exerciseRules": [
    {
      "id": "bodyweight-closed-chain",
      "description": "Bodyweight horizontal presses use a closed kinetic chain, bodyweight-derived loading, free scapular translation, and an explicit lower-body support point.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "bodyweight"
      },
      "then": [
        {
          "field": "loadMode",
          "value": "bodyweightAdded"
        },
        {
          "field": "variant.kineticChain",
          "value": "closed"
        },
        {
          "field": "variant.torsoSupport",
          "value": "none"
        },
        {
          "field": "variant.scapularTranslation",
          "value": "free"
        },
        {
          "field": "variant.lowerBodySupport",
          "allowedValues": [
            "feet",
            "knees"
          ]
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "external-implement-open-chain",
      "description": "Non-bodyweight horizontal presses use external resistance in an open kinetic chain and explicitly declare that no lower-body contact changes effective bodyweight loading.",
      "when": {
        "field": "equipment",
        "operator": "notEquals",
        "value": "bodyweight"
      },
      "then": [
        {
          "field": "loadMode",
          "value": "external"
        },
        {
          "field": "variant.kineticChain",
          "value": "open"
        },
        {
          "field": "variant.lowerBodySupport",
          "value": "none"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "machine-requires-fixed-path-and-type",
      "description": "Machine horizontal presses use a constrained load path and declare the machine mechanism.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "machine"
      },
      "then": [
        {
          "field": "variant.fixedPath",
          "value": true
        }
      ],
      "requirePresent": [
        "variant.machineType"
      ],
      "requireAbsent": []
    },
    {
      "id": "non-machine-requires-free-path",
      "description": "Non-machine horizontal presses are not constrained by machine rails or levers and do not declare a machine mechanism.",
      "when": {
        "field": "equipment",
        "operator": "notEquals",
        "value": "machine"
      },
      "then": [
        {
          "field": "variant.fixedPath",
          "value": false
        }
      ],
      "requirePresent": [],
      "requireAbsent": [
        "variant.machineType"
      ]
    },
    {
      "id": "smith-uses-bench",
      "description": "A Smith horizontal press uses a bench and a pronated grip beneath the rails.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "smith"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "bench"
        },
        {
          "field": "variant.gripOrientation",
          "value": "pronated"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "chest-press-machine-uses-pad",
      "description": "A converging horizontal chest-press machine supports the torso against its pad and uses the canonical neutral handles.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "convergingChestPress"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "machinePad"
        },
        {
          "field": "variant.gripOrientation",
          "value": "neutral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "unsupported-torso-allows-scapular-translation",
      "description": "Without posterior torso support, external contact does not constrain scapular translation during the press.",
      "when": {
        "field": "variant.torsoSupport",
        "operator": "equals",
        "value": "none"
      },
      "then": [
        {
          "field": "variant.scapularTranslation",
          "value": "free"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "supported-torso-limits-scapular-translation",
      "description": "A bench, floor, or machine pad limits scapular translation through posterior support contact without implying that scapular rotation or tilt is absent.",
      "when": {
        "field": "variant.torsoSupport",
        "operator": "notEquals",
        "value": "none"
      },
      "then": [
        {
          "field": "variant.scapularTranslation",
          "value": "supportConstrained"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "floor-support-limits-range",
      "description": "Floor-supported presses stop when the upper arm contacts the floor.",
      "when": {
        "field": "variant.torsoSupport",
        "operator": "equals",
        "value": "floor"
      },
      "then": [
        {
          "field": "variant.rangeOfMotion",
          "value": "floorLimited"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "floor-limited-range-requires-floor",
      "description": "Only a floor-supported press may use the floor-limited range marker.",
      "when": {
        "field": "variant.rangeOfMotion",
        "operator": "equals",
        "value": "floorLimited"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "floor"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "support-constrained-translation-requires-stabilizer-pair",
      "description": "A torso-supported press with support-constrained scapular translation records both serratus and middle trapezius as stabilizers; support type does not select one of them.",
      "when": {
        "field": "variant.scapularTranslation",
        "operator": "equals",
        "value": "supportConstrained"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "serratus",
          "role": "stabilizer"
        },
        {
          "muscle": "trapeziusMiddle",
          "role": "stabilizer"
        }
      ]
    }
  ],
