{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "knee-extension",
  "name": "Knee Extension",
  "definition": "A strict open-chain machine isolation in which the lower leg extends at the knee while the hip, pelvis, spine, ankle, and foot remain held. The initial roster contains only the directly trained unilateral lever-machine conditions at approximately 40 and 90 degrees of hip flexion. Vasti remain primary in both; rectus femoris is primary in the reclined 40-degree condition and secondary in the upright 90-degree condition because the directly reviewed intervention found substantially greater rectus-femoris hypertrophy with reduced hip flexion but did not make it cease contributing upright. Bilateral machines, cables, bands, reverse Nordics, sissy squats, rehabilitation terminal extensions, partial ranges, and compound knee-extension tasks remain outside this family.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "larsen-2025-leg-extension-hip-flexion",
    "mitsuya-2023-leg-extension-hip-flexion"
  ],
  "fixed": {
    "mechanic": "isolation",
    "pattern": null,
    "direction": null,
    "planes": [
      "sagittal"
    ]
  },
  "groupPolicy": {
    "default": "legs",
    "allowed": [
      "legs"
    ]
  },
  "allowed": {
