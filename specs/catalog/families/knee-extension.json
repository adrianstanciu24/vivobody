{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "knee-extension",
  "name": "Knee Extension",
  "definition": "A strict open-chain lever-machine isolation in which one lower leg or both linked lower legs extend at the knee while the hip, pelvis, spine, ankle, and foot remain held. The roster contains directly trained unilateral conditions at approximately 40 and 90 degrees of hip flexion plus a manufacturer-defined upright bilateral fixture whose exact hip and knee angles are source-unreported. Vasti remain primary throughout; rectus femoris is primary in the reclined 40-degree condition and secondary in the upright unilateral condition. The bilateral vasti-primary and rectus-femoris-secondary roles are conservative action-and-anatomy inferences, not outcomes extrapolated from the unilateral trials. Independent alternating lever arms, cables, bands, reverse Nordics, sissy squats, rehabilitation terminal extensions, partial ranges, and compound knee-extension tasks remain outside this family.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "cybex-2008-mg500-manual",
    "larsen-2025-leg-extension-hip-flexion",
    "mitsuya-2023-leg-extension-hip-flexion"
  ],
