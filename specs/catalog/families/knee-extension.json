        "endpoint": "Finish with the knee completely straight.",
        "returnPhase": "Return under control.",
        "controlledJoints": "Keep your pelvis, back, hip, ankle, and foot still.",
        "supportAndPosture": "Keep your back against the reclined machine pad and your pelvis on the seat.",
        "disqualifyingCompensations": [
          "Rocking the pelvis or arching the back to move the pad turns the leg extension into a trunk-driven heave.",
          "Swinging the lower leg up with momentum turns the leg extension into a leg swing."
        ],
        "sideOrDirection": "Complete the set with one leg, then repeat with the other leg."
