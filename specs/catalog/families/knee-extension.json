  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "open"
      ],
      "description": "Whether the distal lower leg moves freely or remains fixed to the environment."
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "reclined",
        "seated",
        "seatedSourceUnreportedAngles"
      ],
      "description": "The reviewed torso relationship; the bilateral manufacturer fixture is upright but does not report a numeric hip angle."
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "machinePad"
      ],
      "description": "The machine back pad supporting the torso during the repetition."
    },
    {
      "id": "pelvisSupport",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "machineSeat"
      ],
      "description": "The machine seat supporting the pelvis while hip position remains held."
    },
    {
      "id": "pelvisMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "positionHeld"
      ],
      "description": "Whether the pelvis remains held rather than moving to create the repetition."
    },
    {
      "id": "spineMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "positionHeld"
      ],
      "description": "Whether spinal position remains held rather than moving to create the repetition."
    },
    {
      "id": "hipMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "positionHeld"
      ],
      "description": "Whether hip angle remains held rather than contributing a dynamic hip action."
    },
    {
      "id": "hipFlexionDegrees",
      "valueType": "number",
      "required": false,
      "minimum": 40,
      "maximum": 90,
      "description": "Held hip flexion from anatomical neutral for the unilateral research fixtures; omitted when the manufacturer source reports no numeric angle."
    },
    {
      "id": "kneeMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "extends"
      ],
      "description": "The dynamic knee motion that creates the concentric repetition."
    },
    {
      "id": "kneeStartFlexionDegrees",
      "valueType": "number",
      "required": false,
      "minimum": 110,
      "maximum": 110,
      "description": "Knee flexion at the start of the unilateral research fixtures; omitted for the source-unreported bilateral range."
    },
    {
      "id": "kneeEndFlexionDegrees",
      "valueType": "number",
      "required": false,
      "minimum": 0,
      "maximum": 0,
      "description": "Knee flexion at the endpoint of the unilateral research fixtures; omitted for the source-unreported bilateral range."
    },
    {
      "id": "ankleMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "positionHeld"
      ],
      "description": "Whether ankle position remains held rather than adding a dynamic ankle action."
    },
    {
      "id": "footMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "positionHeld"
      ],
      "description": "Whether foot and toe position remain held rather than creating the repetition."
    },
    {
      "id": "movingSegment",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "lowerLeg"
      ],
      "description": "The segment whose knee-relative motion defines the repetition."
    },
    {
      "id": "loadInterface",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "distalShinPad"
      ],
      "description": "The machine pad applies resistance to the distal anterior lower leg."
    },
    {
      "id": "machineType",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "leverKneeExtension"
      ],
      "description": "The reviewed knee-extension machine mechanism."
    },
    {
      "id": "limbSequence",
      "valueType": "enum",
      "required": false,
      "description": "The linked bilateral fixture moves both lower legs together; unilateral fixtures omit this field.",
      "allowedValues": [
        "simultaneousBilateral"
      ]
    },
    {
      "id": "loadAccounting",
      "valueType": "enum",
      "required": true,
      "description": "The entered stack or machine value is comparable only on the same machine fixture.",
      "allowedValues": [
        "enteredExternalLoadSameFixtureOnly"
      ]
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "fixedValue": true,
      "description": "Whether a machine lever constrains the external-load path."
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "isolatedJointMotion"
      ],
      "description": "Whether the named knee action alone creates the repetition rather than propulsion from another lower-body joint."
    }
  ],
  "exerciseRules": [
    {
      "id": "reclined-leg-extension-uses-reviewed-hip-angle",
      "description": "The reclined fixture uses the reviewed 40-degree hip-flexion target and promotes rectus femoris to primary.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "equals",
        "value": "reclined"
      },
      "then": [
        {
          "field": "variant.hipFlexionDegrees",
          "value": 40
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "rectusFemoris",
          "role": "primary"
        }
      ]
    },
    {
      "id": "forty-degree-leg-extension-is-reclined",
      "description": "The reviewed 40-degree hip-flexion fixture is the reclined condition.",
      "when": {
        "field": "variant.hipFlexionDegrees",
        "operator": "equals",
        "value": 40
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "value": "reclined"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "seated-leg-extension-uses-reviewed-hip-angle",
      "description": "The upright seated fixture uses 90 degrees of hip flexion and keeps rectus femoris secondary.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "equals",
        "value": "seated"
      },
      "then": [
        {
          "field": "variant.hipFlexionDegrees",
          "value": 90
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "rectusFemoris",
          "role": "secondary"
        }
      ]
    },
    {
      "id": "ninety-degree-leg-extension-is-seated",
      "description": "The reviewed 90-degree hip-flexion fixture is the upright seated condition.",
      "when": {
        "field": "variant.hipFlexionDegrees",
        "operator": "equals",
        "value": 90
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "value": "seated"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "bilateral-leg-extension-moves-together",
      "description": "The manufacturer-defined bilateral fixture uses linked simultaneous lower-leg motion while preserving its source-unreported joint angles.",
      "when": {
        "field": "laterality",
        "operator": "equals",
        "value": "bilateral"
      },
      "then": [
        {
          "field": "variant.limbSequence",
          "value": "simultaneousBilateral"
        },
        {
          "field": "variant.bodyPosition",
          "value": "seatedSourceUnreportedAngles"
        }
      ],
      "requirePresent": [
        "variant.limbSequence"
      ],
      "requireAbsent": [
        "variant.hipFlexionDegrees",
        "variant.kneeStartFlexionDegrees",
        "variant.kneeEndFlexionDegrees"
      ]
    },
    {
      "id": "unilateral-leg-extension-omits-bilateral-sequence",
      "description": "Single-leg research fixtures retain their measured joint-angle tuple and cannot claim simultaneous bilateral motion.",
      "when": {
        "field": "laterality",
        "operator": "equals",
        "value": "unilateral"
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "allowedValues": [
            "reclined",
            "seated"
          ]
        }
      ],
      "requirePresent": [
        "variant.hipFlexionDegrees",
        "variant.kneeStartFlexionDegrees",
        "variant.kneeEndFlexionDegrees"
      ],
      "requireAbsent": [
        "variant.limbSequence"
      ]
    }
  ],
