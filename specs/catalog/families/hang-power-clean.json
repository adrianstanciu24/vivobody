      "execution": {
        "startingPosition": "Log the total bar plus plates. Stand upright with the bar held at arms' length against the hips in a comfortable overhand clean grip.",
        "movement": "Lower the bar to just above the knees, hold for approximately one second, then extend the hips, knees, and ankles explosively and bend the elbows only after that extension to pull under.",
        "endpoint": "Receive the bar in the front rack with the hip crease above the knees.",
        "returnPhase": "Stand fully from the catch, then lower the bar under control to the upright arms-length position before the next repetition.",
        "controlledJoints": "Control hip and knee flexion during loading and receiving while keeping the bar close.",
        "supportAndPosture": "Brace the trunk and keep a secure two-hand grip without external support.",
        "disqualifyingCompensations": ["Starting from the floor changes the exercise into a floor power clean.", "Skipping the approximately one-second hold changes the reviewed hang setup.", "Receiving below power depth changes the exercise into a full clean.", "Stopping without a front-rack catch changes the repetition into a clean pull."]
      }
    }
