      "execution": {
        "startingPosition": "Select the stack weight on the Life Fitness Insignia SS-AB. Adjust the seat so your lower back rests against the lumbar pad, keep your hips on the seat, and grip the handles. Record the selected stack weight and compare it only on the same machine and setup.",
        "movement": "Curl your upper torso forward in a controlled crunch. Let your arms guide the handles without pulling them down.",
        "endpoint": "Finish the upper-body curl while keeping your hips seated.",
        "returnPhase": "Return slowly to the starting position without letting the stack drop.",
        "controlledJoints": "Create the repetition by curling your back rather than deliberately hinging at your hips.",
        "supportAndPosture": "Keep your lower back supported and your hips in contact with the seat.",
        "disqualifyingCompensations": [
          "Pulling down with the arms changes the abdominal crunch into an arm-driven repetition.",
          "Lifting the hips or deliberately folding at the hips changes the strict seated crunch.",
          "Dropping the stack replaces the controlled return with momentum."
        ]
      }
    }
