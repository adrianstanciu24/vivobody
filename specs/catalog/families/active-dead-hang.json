      "execution": {
        "startingPosition": "Take a shoulder-width closed overhand grip on a horizontal pull-up bar, fully extend both elbows, and lift your feet clear of the floor.",
        "movement": "Pull your shoulders slightly away from your ears and hold the shoulder blades down without bending your elbows.",
        "endpoint": "Hold the active suspended position for the set time without losing the grip or shoulder position.",
        "controlledJoints": "Keep both elbows fully extended and keep the shoulder blades down without repeatedly raising and lowering them.",
        "supportAndPosture": "Support your full bodyweight through both hands with no foot assistance and no deliberate swing.",
        "disqualifyingCompensations": [
          "Letting the shoulders rise toward the ears turns the exercise into a Passive Dead Hang.",
          "Bending the elbows turns the exercise into a flexed-arm hold.",
          "Repeatedly raising and lowering the shoulders turns the exercise into a shoulder-blade pull-up."
        ]
      }
