{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "decline-press",
  "name": "Decline Press",
  "definition": "A chest-oriented compound press whose reviewed path is declined relative to the torso. The family owns supported open-chain barbell, dumbbell, and machine fixtures at negative press angles plus one closed-chain bodyweight fixture with both hands on a 30.48-centimeter horizontal support. The concentric phase combines shoulder horizontal adduction with elbow extension; the elevated push-up additionally allows free shoulder-blade travel through protraction. Its two pectoralis-major regions are co-primary as a generic push-up and anatomy transfer because the exact elevated-fixture evidence does not establish angle-specific regional emphasis. The 0.55 body-mass coefficient is an exact-fixture upper-limb force proxy, not constant equivalent external load. Flat, inclined, dip, fly, unilateral, knee-supported, differently elevated, and unsupported open-chain presses remain outside this family.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "borges-2019-bench-machine-scapula",
    "boroto-2018-scapular-stabilizers-press",
    "coratella-2020-bench-press-variations",
    "lauver-2016-bench-angle",
    "lee-2019-pectoralis-force-direction",
    "saeterbakken-2017-bench-press-variations",
    "ebben-2011-pushup-load",
    "suprak-2013-pushup-scapula",
    "van-den-tillaar-2019-pushup-bench"
  ],
