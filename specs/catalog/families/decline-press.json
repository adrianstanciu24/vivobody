        "externalRotators",
        "abs"
      ]
    }
  },
  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether the distal segment moves freely or remains fixed.",
      "allowedValues": [
        "open",
        "closed"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "The support that fixes the torso at the authored decline.",
      "allowedValues": [
        "bench",
        "machinePad",
        "none"
      ]
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "description": "Whether external posterior support limits scapular translation along the thorax; this does not classify scapular rotation or tilt.",
      "allowedValues": [
        "supportConstrained",
        "free"
      ]
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "Canonical forearm and hand orientation through the working range.",
      "allowedValues": [
        "pronated",
        "neutral"
      ]
    },
    {
      "id": "pressInclinationDegrees",
      "valueType": "number",
      "required": false,
      "description": "Signed inclination of the canonical torso-relative press from horizontal: positive toward overhead and negative toward decline; a supported free-weight press uses backrest angle as the proxy.",
      "minimum": -30,
      "maximum": -10
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "description": "Whether rails or a lever constrain the external load path."
    },
    {
      "id": "machineType",
      "valueType": "enum",
      "required": false,
      "description": "The machine mechanism when equipment is machine.",
      "allowedValues": [
        "smith",
        "convergingChestPress"
      ]
    },
    {
      "id": "supportElevationCm",
      "valueType": "number",
      "required": false,
      "description": "The exact elevation of the closed-chain hand support.",
      "minimum": 30.48,
      "maximum": 30.48
    },
    {
      "id": "elevatedSegment",
      "valueType": "enum",
      "required": false,
      "description": "The body segment supported above floor height.",
      "allowedValues": ["hands"]
    },
    {
      "id": "lowerBodySupport",
      "valueType": "enum",
      "required": true,
      "description": "The lower-body floor contact in the exact push-up fixture.",
      "allowedValues": ["none", "feet"]
    }
  ],
  "exerciseRules": [
    {
      "id": "machine-requires-fixed-path-and-type",
      "description": "Machine decline presses use a constrained load path and declare the machine mechanism.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "machine"
      },
      "then": [
        {
          "field": "variant.fixedPath",
          "value": true
        }
      ],
      "requirePresent": [
        "variant.machineType"
      ],
      "requireAbsent": []
    },
    {
      "id": "non-machine-requires-free-path",
      "description": "Barbell and dumbbell decline presses keep a free load path and do not declare a machine mechanism.",
      "when": {
        "field": "equipment",
        "operator": "notEquals",
        "value": "machine"
      },
      "then": [
        {
          "field": "variant.fixedPath",
          "value": false
        }
      ],
      "requirePresent": [],
      "requireAbsent": [
        "variant.machineType"
      ]
    },
    {
      "id": "barbell-requires-bench",
      "description": "A free barbell decline press uses a decline bench and a pronated grip.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "barbell"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "bench"
        },
        {
          "field": "variant.gripOrientation",
          "value": "pronated"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "dumbbell-requires-bench",
      "description": "A dumbbell decline press uses a decline bench.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "dumbbell"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "bench"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "smith-uses-bench",
      "description": "A Smith decline press uses a decline bench and a pronated grip beneath the rails.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "smith"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "bench"
        },
        {
          "field": "variant.gripOrientation",
          "value": "pronated"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "decline-chest-press-machine-uses-pad",
      "description": "A converging decline chest-press machine supports the torso against its pad and uses the canonical neutral handles.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "convergingChestPress"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "machinePad"
        },
        {
          "field": "variant.gripOrientation",
          "value": "neutral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "support-constrained-translation-requires-stabilizer-pair",
      "description": "A torso-supported press with support-constrained scapular translation records both serratus and middle trapezius as stabilizers; support type does not select one of them.",
      "when": {
        "field": "variant.scapularTranslation",
        "operator": "equals",
        "value": "supportConstrained"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "serratus",
          "role": "stabilizer"
        },
        {
          "muscle": "trapeziusMiddle",
          "role": "stabilizer"
        }
      ]
    },
    {
      "id": "non-bodyweight-is-supported-open-chain",
      "description": "Every non-bodyweight decline fixture is a support-constrained open-chain press with a reviewed angle and no elevated-push-up axes.",
      "when": {"field": "equipment", "operator": "notEquals", "value": "bodyweight"},
      "then": [
        {"field": "loadMode", "value": "external"},
        {"field": "bodyweightFraction", "value": 0},
        {"field": "variant.kineticChain", "value": "open"},
        {"field": "variant.scapularTranslation", "value": "supportConstrained"},
        {"field": "variant.lowerBodySupport", "value": "none"}
      ],
      "requirePresent": ["variant.pressInclinationDegrees"],
      "requireAbsent": ["variant.supportElevationCm", "variant.elevatedSegment"],
      "requireInvolvement": [
        {"muscle": "pectoralisMajorSternocostal", "role": "primary"},
        {"muscle": "pectoralisMajorClavicular", "role": "secondary"}
      ],
      "requireAdditionalPrimeActions": [],
      "requireAdditionalStabilityDemands": []
    },
    {
      "id": "closed-chain-is-bodyweight-only",
      "description": "Closed-chain decline vocabulary belongs only to the hands-elevated bodyweight fixture.",
      "when": {"field": "variant.kineticChain", "operator": "equals", "value": "closed"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "free-scapular-translation-is-bodyweight-only",
      "description": "Free scapular translation belongs only to the hands-elevated bodyweight fixture.",
      "when": {"field": "variant.scapularTranslation", "operator": "equals", "value": "free"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "hand-elevation-is-bodyweight-only",
      "description": "The elevated-hands axis cannot leak onto an open-chain decline press.",
      "when": {"field": "variant.elevatedSegment", "operator": "equals", "value": "hands"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": ["variant.supportElevationCm"],
      "requireAbsent": []
    },
    {
      "id": "feet-lower-body-support-is-bodyweight-only",
      "description": "Feet as the authored lower-body support belongs only to the push-up branch.",
      "when": {"field": "variant.lowerBodySupport", "operator": "equals", "value": "feet"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "bodyweight-hands-elevated-fixture",
      "description": "The bodyweight branch is exactly the 30.48-centimeter hands-elevated push-up with free shoulder-blade travel and the measured force proxy.",
      "when": {"field": "equipment", "operator": "equals", "value": "bodyweight"},
      "then": [
        {"field": "loadMode", "value": "bodyweightAdded"},
        {"field": "bodyweightFraction", "value": 0.55},
        {"field": "variant.kineticChain", "value": "closed"},
        {"field": "variant.torsoSupport", "value": "none"},
        {"field": "variant.scapularTranslation", "value": "free"},
        {"field": "variant.gripOrientation", "value": "pronated"},
        {"field": "variant.supportElevationCm", "value": 30.48},
        {"field": "variant.elevatedSegment", "value": "hands"},
        {"field": "variant.lowerBodySupport", "value": "feet"},
        {"field": "variant.fixedPath", "value": false}
      ],
      "requirePresent": ["variant.supportElevationCm", "variant.elevatedSegment", "variant.lowerBodySupport"],
      "requireAbsent": ["variant.pressInclinationDegrees", "variant.machineType"],
      "requireInvolvement": [
        {"muscle": "pectoralisMajorSternocostal", "role": "primary"},
        {"muscle": "pectoralisMajorClavicular", "role": "primary"},
        {"muscle": "serratus", "role": "secondary"},
        {"muscle": "abs", "role": "stabilizer"}
      ],
      "requireAdditionalPrimeActions": ["scapula.protraction"],
      "requireAdditionalStabilityDemands": ["spine", "pelvis"]
    }
  ],
