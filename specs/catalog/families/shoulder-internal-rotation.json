{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "shoulder-internal-rotation",
  "name": "Shoulder Internal Rotation",
  "definition": "A strict unilateral isolation whose concentric phase internally rotates the humerus at the glenohumeral joint while the upper arm remains beside the torso, the elbow angle remains fixed, and the scapula and torso do not create the repetition. The initial roster is deliberately limited to the directly studied dynamic cable and elastic-resistance geometry at zero humerothoracic elevation. The subscapularis is the training emphasis, while the larger internal rotators remain real synergists rather than being erased by the family label. Belly-press and lift-off tests, 90-degree-abduction and overhead throwing positions, diagonal patterns, presses, flies, pullovers, and exercises that add shoulder adduction, extension, horizontal adduction, scapular motion, or elbow movement remain outside this contract. Exercise studies report whole-pectoralis recruitment; assignment of both Vivobody pectoralis-major regions as secondary combines that evidence with their independently reviewed internal-rotation capability rather than claiming head-resolved exercise EMG.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "dark-2007-shoulder-rotation-recruitment",
    "ginn-2017-subscapularis-internal-rotation",
    "hintermeister-1998-elastic-shoulder-rehabilitation",
    "holzbaur-2005-upper-extremity"
  ],
