  "exerciseRules": [
    {
      "id": "rope-curl-requires-neutral-forearm",
      "description": "The directly reviewed rope cable curl holds a neutral forearm orientation.",
      "when": {
        "field": "variant.handleType",
        "operator": "equals",
        "value": "rope"
      },
      "then": [
        {
          "field": "variant.forearmOrientation",
          "value": "neutral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "neutral-curl-requires-rope",
      "description": "Neutral forearm orientation is admitted only through the directly reviewed rope cable fixture.",
      "when": {
        "field": "variant.forearmOrientation",
        "operator": "equals",
        "value": "neutral"
      },
      "then": [
        {
          "field": "variant.handleType",
          "value": "rope"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "supinated-curl-promotes-biceps-brachii",
      "description": "The reviewed supinated cable curl assigns biceps brachii as a co-primary elbow flexor.",
      "when": {
        "field": "variant.forearmOrientation",
        "operator": "equals",
        "value": "supinated"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "bicepsBrachii",
          "role": "primary"
        }
      ]
    },
    {
      "id": "non-supinated-curl-keeps-biceps-brachii-secondary",
      "description": "Neutral and pronated cable curls retain biceps brachii as a secondary elbow flexor rather than removing its contribution or promoting it to primary.",
      "when": {
        "field": "variant.forearmOrientation",
        "operator": "notEquals",
        "value": "supinated"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "bicepsBrachii",
          "role": "secondary"
        }
      ]
    },
    {
      "id": "cable-curl-pins-cable-interface",
      "description": "Cable records retain the reviewed low-cable interfaces.",
      "when": {"field": "equipment", "operator": "equals", "value": "cable"},
      "then": [
        {"field": "laterality", "value": "bilateral"},
        {"field": "variant.handleType", "allowedValues": ["straightBar", "rope"]},
        {"field": "variant.resistanceGeometry", "value": "lowCableCurl"}
      ],
      "requirePresent": [], "requireAbsent": []
    },
    {
      "id": "barbell-curl-pins-straight-bar-fixture",
      "description": "The reviewed free-weight barbell branch is bilateral and supinated.",
      "when": {"field": "equipment", "operator": "equals", "value": "barbell"},
      "then": [
        {"field": "laterality", "value": "bilateral"}, {"field": "variant.forearmOrientation", "value": "supinated"},
        {"field": "variant.handleType", "value": "straightBarbell"}, {"field": "variant.resistanceGeometry", "value": "gravityLoadedBarbell"}
      ],
      "requirePresent": [], "requireAbsent": []
    },
    {
      "id": "dumbbell-curl-pins-single-arm-fixture",
      "description": "The reviewed dumbbell branch is unilateral and held supinated.",
      "when": {"field": "equipment", "operator": "equals", "value": "dumbbell"},
      "then": [
        {"field": "laterality", "value": "unilateral"}, {"field": "variant.forearmOrientation", "value": "supinated"},
        {"field": "variant.handleType", "value": "dumbbellHandle"}, {"field": "variant.resistanceGeometry", "value": "gravityLoadedDumbbell"}
      ],
      "requirePresent": [], "requireAbsent": []
    }
  ],
