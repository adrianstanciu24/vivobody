          "muscle": "bicepsBrachii",
          "role": "primary"
        }
      ]
    },
    {
      "id": "non-supinated-curl-keeps-biceps-brachii-secondary",
      "description": "Neutral and pronated cable curls retain biceps brachii as a secondary elbow flexor rather than removing its contribution or promoting it to primary.",
      "when": {
        "field": "variant.forearmOrientation",
        "operator": "notEquals",
        "value": "supinated"
      },
