{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "elbow-flexion",
  "name": "Elbow Flexion",
  "definition": "A strict open-chain isolation movement in which the elbow flexes while the upper arm remains at the side, forearm orientation and neutral wrist are held, and the torso, scapulae, and lower body do not create the repetition. Brachialis is the orientation-neutral primary baseline; biceps brachii is additionally primary only in the reviewed supinated curl and secondary in the neutral and pronated curls. Brachioradialis remains secondary across the initial roster because controlled slow elbow flexion and loaded cable-curl studies report conflicting orientation-dependent excitation orders. Finger flexors author the static implement hold, while extensor carpi radialis supplies mechanics-derived counter-control of the neutral wrist rather than a dynamic wrist-extension action. The three directly reviewed standing cable fixtures intentionally exclude rotating dumbbell curls, semisupinated EZ bars, supported curls, machines, and exercises that add shoulder or scapular prime actions.",
  "evidenceRefs": [
    "holzbaur-2005-upper-extremity",
    "murray-1995-elbow-forearm-moment-arms",
    "coratella-2023-curl-handgrips",
    "kleiber-2015-elbow-flexion-hand-position"
  ],
  "fixed": {
    "mechanic": "isolation",
    "pattern": null,
    "direction": null,
    "planes": [
      "sagittal"
    ]
  },
