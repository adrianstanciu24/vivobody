      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "neutral-curl-requires-rope",
      "description": "Neutral forearm orientation is admitted only through the directly reviewed rope cable fixture.",
      "when": {
        "field": "variant.forearmOrientation",
        "operator": "equals",
        "value": "neutral"
      },
      "then": [
