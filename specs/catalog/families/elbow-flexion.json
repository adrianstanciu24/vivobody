    {"id": "handleType", "valueType": "enum", "required": true, "description": "The reviewed load-to-hand interface without inferring an unreported bar shape.", "allowedValues": ["straightBar", "rope", "straightBarbell", "dumbbellHandle", "barbellShapeUnreported"]},
    {"id": "resistanceGeometry", "valueType": "enum", "required": true, "description": "How resistance reaches the hand.", "allowedValues": ["lowCableCurl", "gravityLoadedBarbell", "gravityLoadedDumbbell"]},
    {"id": "loadAccounting", "valueType": "enum", "required": false, "description": "Paired-dumbbell fixtures log one dumbbell's weight rather than the pair total.", "allowedValues": ["perImplement"]},
    {"id": "preacherPadAngle", "valueType": "enum", "required": false, "description": "The source-reported preacher pad angle; absent outside preacher fixtures.", "allowedValues": ["unreported"]},
    {"id": "cadence", "valueType": "enum", "required": false, "description": "The source-controlled repetition cadence; absent where not fixture-defining.", "allowedValues": ["oneSecondConcentricTwoSecondEccentric"]},
    {"id": "fixedPath", "valueType": "boolean", "required": true, "fixedValue": false, "description": "Whether rails or a lever constrain the external load path."},
    {"id": "lowerBodyContribution", "valueType": "enum", "required": true, "description": "Whether lower-body drive contributes.", "allowedValues": ["none"]}
