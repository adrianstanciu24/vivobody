{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "elbow-flexion",
  "name": "Elbow Flexion",
  "definition": "A strict standing open-chain isolation in which the elbow flexes while the upper arm stays at the side, forearm orientation and neutral wrist are held, and the torso, scapulae, and lower body do not create the repetition. The roster owns three cable grips plus a bilateral straight-bar barbell curl and a unilateral supinated dumbbell curl. Brachialis is the orientation-neutral primary baseline; biceps brachii is co-primary in supination and secondary in the neutral and pronated records. Rotating curls, semisupinated EZ bars, supported curls, machines, and variants adding shoulder or scapular prime actions remain outside this contract.",
  "evidenceRefs": [
    "holzbaur-2005-upper-extremity",
    "murray-1995-elbow-forearm-moment-arms",
    "coratella-2023-curl-handgrips",
    "kleiber-2015-elbow-flexion-hand-position",
    "marcolin-2018-curl-variants",
    "oliveira-2009-dumbbell-curl-shoulder-position"
  ],
