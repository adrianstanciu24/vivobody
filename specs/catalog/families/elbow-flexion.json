    {"id": "forearmSupport", "valueType": "enum", "required": true, "description": "Whether the forearm itself is externally supported.", "allowedValues": ["none"]},
    {"id": "upperArmSupport", "valueType": "enum", "required": true, "description": "The external surface supporting the upper arm.", "allowedValues": ["none", "preacherPad"]},
