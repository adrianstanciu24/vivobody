  "exercises": [
    {
      "catalogID": "barbell-good-morning-25-percent-body-mass",
      "name": "25% Body-Mass Barbell Good Morning",
      "execution": {
        "startingPosition": "Stand upright with your feet approximately shoulder-width apart and naturally turned slightly outward. Place a free bar securely across the back of your shoulders and upper back in a comfortable hand position. Load the bar with 25 percent of your body weight; use 45 lb or 20 kg only if that matches your calculated weight.",
        "movement": "Push your hips backward as far as you can while keeping a natural back position.",
        "endpoint": "End the descent when your hips have moved as far back as they comfortably can.",
        "returnPhase": "Straighten your hips and return to standing at the same controlled speed used for the descent, keeping the bar on your body for all eight repetitions.",
        "controlledJoints": "Allow only a small bend in the knees throughout the movement.",
        "supportAndPosture": "Keep your head aligned with your spine, brace your trunk, and keep both feet planted.",
        "disqualifyingCompensations": [
          "Bending the knees deeply turns the hinge into a squat.",
          "Rounding the back turns the hinge into a rounded-back pull."
        ]
      },
