        "approximatelyHipWidth"
      ]
    },
    {
      "id": "footOrientation",
      "valueType": "enum",
      "required": true,
      "description": "The exact research fixture prescribes a slight natural toe-out; the everyday strength standard permits forward or slightly externally rotated feet.",
      "allowedValues": [
        "slightNaturalToeOut",
        "forwardOrSlightToeOut"
      ]
    },
    {
      "id": "footContact",
      "valueType": "enum",
