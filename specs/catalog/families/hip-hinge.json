    {
      "catalogID": "barbell-good-morning",
      "name": "Barbell Good Morning",
      "execution": {
        "startingPosition": "Stand upright with your feet approximately hip-width apart and pointing forward or slightly outward. Place a free bar across your upper trapezius, take an overhand grip with your hands equally spaced from the center, and use the total bar-plus-plate load selected for your training program.",
        "movement": "Brace your trunk, maintain a slight knee bend, and push your hips backward at a controlled self-selected pace. Keep your back as neutral and controlled as you comfortably can.",
        "endpoint": "Stop at the deepest position you can control without turning the movement into a squat or losing a controlled neutral back position.",
        "returnPhase": "Extend your hips and bring your trunk back to upright under control, keeping the bar on your body between repetitions.",
        "controlledJoints": "Maintain the slight knee bend rather than using deeper knee flexion to drive the repetition; heavier loads can increase knee excursion, which is a limit to correct rather than a goal.",
        "supportAndPosture": "Keep both feet planted, the bar secure, and your trunk movement controlled throughout the repetition.",
        "disqualifyingCompensations": [
          "Bending the knees deeply turns the hinge into a squat.",
          "Losing a controlled neutral back position or the secure bar position ends the repetition."
        ]
      },
