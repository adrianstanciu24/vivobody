        "continuous"
      ]
    },
    {
      "id": "loadPlacement",
      "valueType": "enum",
      "required": true,
      "description": "The exact research fixture uses a deliberately coarse posterior shoulder and upper-back surface; the everyday technique standard places the bar across the upper trapezius.",
      "allowedValues": [
        "posteriorShoulderUpperBack",
        "upperTrapeziusHighBar"
      ]
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "The source-exact study required a comfortable hand position without reporting forearm orientation; Ross et al. prescribe an overhand grip with hands equidistant from bar center.",
      "allowedValues": [
        "comfortableUnreported",
        "overhandEquidistant"
      ]
    },
    {
      "id": "externalLoadPrescription",
      "valueType": "enum",
      "required": true,
      "description": "The exact research fixture normalizes load to body mass; the everyday record accepts the external load selected for the user's program.",
      "allowedValues": [
        "twentyFivePercentBodyMass",
        "programSelectedExternalLoad"
      ]
    },
    {
      "id": "hipMotion",
      "valueType": "enum",
      "required": true,
      "description": "The dynamic concentric hip action during the return from the deepest hinge position.",
      "allowedValues": [
        "extends"
      ]
    },
    {
      "id": "spineMotion",
      "valueType": "enum",
      "required": true,
      "description": "Measured spinal excursion reverses during the ascent and is represented honestly as dynamic spinal extension; the values distinguish the original segment-resolved fixture from the everyday lumbar-measured fixture.",
      "allowedValues": [
        "extendsWithMeasuredSegmentalExcursion",
        "extendsAfterMeasuredLumbarExcursion"
      ]
    },
    {
      "id": "kneeMotion",
      "valueType": "enum",
      "required": true,
      "description": "Knee motion does not define the task and is never promoted to a knee-extension prime; the everyday technique maintains a slight bend while disclosing Vigotsky et al.'s observed load-dependent excursion as a limitation.",
      "allowedValues": [
        "measuredSmallNondefiningExcursion",
        "slightFlexionMaintainedWithObservedLoadDependentExcursion"
      ]
    },
    {
      "id": "rangeOfMotion",
      "valueType": "enum",
      "required": true,
      "description": "The exact fixture uses maximum hip flexion with its technique cue; the everyday record stops at the athlete's controlled training depth.",
      "allowedValues": [
