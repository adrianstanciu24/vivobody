      "execution": {
        "startingPosition": "Set the straps to mid-calf, place both toes in the foot cradles with the top foot slightly forward, and lie on one side with the lower forearm on the floor and elbow below the shoulder.",
        "movement": "Lift the hips into one straight line from shoulder through feet and raise the free arm toward the ceiling.",
        "endpoint": "Hold the straight suspended side bridge for the set time without twisting or letting the straps swing.",
        "controlledJoints": "Keep the shoulders and hips stacked, both legs straight, and the lower elbow below the shoulder.",
        "supportAndPosture": "Press the lower forearm into the floor, keep both toes settled in the foot cradles, and repeat the same hold on the other side.",
        "disqualifyingCompensations": [
          "Dropping or repeatedly lifting the hips turns the hold into a hip-dip repetition.",
          "Turning the chest toward the floor adds rotation and leaves the reviewed side plank.",
          "Lifting the top leg changes the exercise into a raised-leg side plank."
        ],
        "sideOrDirection": "Hold for the set time on one side, then repeat the same duration on the other side."
