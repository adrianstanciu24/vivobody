      "execution": {
        "startingPosition": "Sit with the upper back anchored against a 35.5-centimeter bench and a padded barbell across the pelvis. Plant your feet at shoulder width so your knees finish near 90 degrees, and steady the bar with your palms facing up.",
        "movement": "Raise the pelvis.",
        "endpoint": "End the lift when your hips reach neutral.",
        "returnPhase": "Lower until the plates return to the floor without arching your back or letting your knees drift outward.",
        "controlledJoints": "Keep both feet planted throughout the repetition.",
        "supportAndPosture": "Anchor your upper back against the bench and brace your trunk.",
        "disqualifyingCompensations": [
          "Setting the feet so the knees finish far past 90 degrees turns the hip thrust into a glute bridge.",
          "Letting the knees drift outward turns the hip thrust into a frog pump.",
          "Arching the back to push past neutral turns the hip thrust into a back hyperextension."
        ]
      }
    },
