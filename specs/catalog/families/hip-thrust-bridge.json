        },
        {
          "field": "variant.kneeEndFlexionDegrees",
          "value": 90
        },
        {
          "field": "variant.benchHeightCm",
          "value": 35.5
        }
      ],
      "requirePresent": [
        "variant.benchHeightCm"
      ],
      "requireAbsent": []
