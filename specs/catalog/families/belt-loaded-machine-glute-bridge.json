      "execution": {
        "startingPosition": "Select the stack weight on the Life Fitness Insignia SS-GLB. Rest your upper body on the back pad, fasten the belt snugly over your hip bones with the buckle centered, and place both feet as far back on the footplate as is comfortable. Cross your arms over your chest. Record the selected stack weight and compare it only on the same machine and setup.",
        "movement": "Raise your hips into the belt by straightening at the hips, allowing your knees to straighten as your hips rise. Keep both feet planted.",
        "endpoint": "Stop when your thighs line up with your torso, then pause briefly.",
        "returnPhase": "Lower your hips slowly to the starting position without letting the stack drop.",
        "controlledJoints": "Keep your knees aligned with your feet and avoid deliberately arching or curling your back to lift the belt.",
        "supportAndPosture": "Keep your upper body against the back pad, the belt snug and centered, and both feet on the footplate.",
        "disqualifyingCompensations": [
          "Lifting one foot changes the two-leg bridge into a one-leg variation.",
          "Arching the back to raise the belt adds deliberate back motion.",
          "Using loose or off-center belt contact changes the supported load interface."
        ]
      }
    }
