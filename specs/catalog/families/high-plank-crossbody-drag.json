      "execution": {
        "startingPosition": "Set a high plank with both palms flat, elbows straight, and a weight on the floor just behind one hand. Log the weight's mass.",
        "movement": "Shift support onto the hand beside the weight, lift the opposite hand, and drag the weight along the floor under your body to the other side.",
        "endpoint": "Set the weight down on the far side with your hips and shoulders still parallel to the floor.",
        "returnPhase": "Replace the dragging hand to re-establish the two-palm high plank before the other arm drags the weight back.",
        "controlledJoints": "Keep the supporting elbow straight and resist low-back sag and trunk rotation throughout the drag.",
        "supportAndPosture": "Keep the supporting palm and both feet firmly planted.",
        "sideOrDirection": "Alternate arms; count each completed drag as one repetition and use an even total.",
        "disqualifyingCompensations": [
          "Rowing the weight off the floor changes the exercise.",
          "Using two weights changes the single-implement setup.",
