{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "shoulder-flexion-raise",
  "name": "Front Raise",
  "definition": "A strict single-joint raise in which one open-chain upper arm or both upper arms simultaneously flex from the side to shoulder height in the sagittal plane while the elbow angle, neutral humeral rotation, torso, and lower body remain controlled. Scapular upward rotation and posterior tilt are normal coupled elevation actions, not fixed-ratio claims. Upper trapezius is a secondary dynamic contributor to the declared upward rotation, not merely a stabilizer: a loaded arm-elevation model validated against EMG places superior trapezius among the greatest activity and positive-work contributors during flexion, and a small unweighted held-position study observed its activity increasing gradually in both flexion and abduction. Those sources support a categorical dynamic role without claiming equal magnitude or target emphasis across paths. The single-arm and simultaneous bilateral neutral-rotation setups are transparently bounded applications of direct dumbbell-flexion evidence. NSCA directly defines a strict simultaneous two-dumbbell front raise to shoulder height but uses palms-down hand orientation; the active neutral humeral-rotation boundary comes from the existing family rather than a claim that NSCA tested the combined fixture. Alternating raises, plate or bar raises, internal-rotation variants, and above-shoulder endpoints remain outside this contract.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "holzbaur-2005-upper-extremity",
    "seth-2019-shoulder-work",
    "ludewig-2009-multiplanar-humeral-elevation",
    "morihara-2011-scapular-muscles-flexion-abduction",
    "parry-2012-dumbbell-shoulder-elevation",
    "hecker-2021-deltoid-flexion-abduction",
    "nsca-2012-basics-strength-conditioning"
  ],
