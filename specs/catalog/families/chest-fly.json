  "exerciseRules": [
    {
      "id": "dumbbell-fly-uses-supported-external-load",
      "description": "The reviewed dumbbell fly is supine on a bench with posterior support limiting scapular translation and uses comparable external load.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "dumbbell"
      },
      "then": [
        {
          "field": "loadMode",
          "value": "external"
        },
        {
          "field": "variant.bodyPosition",
          "value": "supine"
        },
        {
          "field": "variant.torsoSupport",
          "value": "bench"
        },
        {
          "field": "variant.scapularTranslation",
          "value": "supportConstrained"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "band-fly-uses-standing-free-scapula-semantics",
      "description": "The reviewed band fly is standing and unsupported, permits free scapular translation, uses non-comparable resistance, and explicitly declares spinal stabilization.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "band"
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "value": "standing"
        },
        {
          "field": "variant.torsoSupport",
          "value": "none"
        },
        {
          "field": "variant.scapularTranslation",
          "value": "free"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireMuscleRequirements": [
        {
          "anyOf": [
            "abs",
            "obliques",
            "lumbarExtensors"
          ],
          "minimumRole": "stabilizer"
        }
      ],
      "requireAdditionalStabilityDemands": [
        "spine"
      ]
    },
    {
      "id": "non-cable-fly-preserves-reviewed-arm-fixture",
      "description": "The dumbbell and band branches retain the neutral grip, flared shoulder-height arm path, and omit every cable-only setup field.",
      "when": {
        "field": "equipment",
        "operator": "notEquals",
        "value": "cable"
      },
      "then": [
        {"field": "variant.gripOrientation", "value": "neutral"},
        {"field": "variant.upperArmPath", "value": "flared"},
        {"field": "variant.upperArmElevationDegrees", "value": 90}
      ],
      "requirePresent": ["variant.upperArmElevationDegrees"],
      "requireAbsent": [
        "variant.handleType",
        "variant.cableAnchorHeight",
        "variant.stanceConfiguration",
        "variant.torsoInclination",
        "variant.resistanceGeometry",
        "variant.loadDistribution",
        "variant.loadAccounting"
      ]
    },
    {
      "id": "dual-cable-fly-pins-reviewed-tower-geometry",
      "description": "The cable branch preserves the exact two-tower standing fixture and per-stack load meaning.",
      "when": {"field": "equipment", "operator": "equals", "value": "cable"},
      "then": [
        {"field": "loadMode", "value": "external"}, {"field": "variant.bodyPosition", "value": "standing"},
        {"field": "variant.torsoSupport", "value": "none"}, {"field": "variant.scapularTranslation", "value": "free"},
        {"field": "variant.gripOrientation", "value": "unreported"}, {"field": "variant.upperArmPath", "value": "sidewaysInCablePlane"},
        {"field": "variant.handleType", "value": "singleCableHandles"}, {"field": "variant.cableAnchorHeight", "value": "headLevel"},
        {"field": "variant.stanceConfiguration", "value": "lungeEitherLegForward"}, {"field": "variant.torsoInclination", "value": "forwardNonNumeric"},
        {"field": "variant.resistanceGeometry", "value": "dualCableCoplanar"}, {"field": "variant.loadDistribution", "value": "equalAcrossTwoTowers"},
        {"field": "variant.loadAccounting", "value": "perStack"}
      ],
      "requirePresent": ["variant.handleType", "variant.cableAnchorHeight", "variant.stanceConfiguration", "variant.torsoInclination", "variant.resistanceGeometry", "variant.loadDistribution", "variant.loadAccounting"],
      "requireAbsent": ["variant.upperArmElevationDegrees"],
      "requireMuscleRequirements": [{"anyOf": ["abs", "obliques", "lumbarExtensors"], "minimumRole": "stabilizer"}],
      "requireAdditionalStabilityDemands": ["spine", "pelvis"]
    }
