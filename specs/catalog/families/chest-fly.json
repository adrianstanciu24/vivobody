      "execution": {
        "startingPosition": "Lie on your back on a flat bench with one dumbbell over each shoulder, your palms facing each other, and your elbows held in a fixed slight bend.",
        "movement": "Lower the upper arms outward at shoulder height.",
        "endpoint": "End with the upper arms lowered out to the sides at shoulder height.",
        "returnPhase": "Sweep your upper arms together until the dumbbells meet over your chest without pressing, changing the elbow bend, or deliberately reaching your shoulder blades forward.",
        "controlledJoints": "Hold your elbows in a fixed slight bend.",
        "supportAndPosture": "Keep your back supported on the flat bench and your torso still.",
        "disqualifyingCompensations": [
          "Bending and straightening the elbows turns the fly into a dumbbell press.",
          "Arching the back or lifting the hips to heave the dumbbells turns the fly into a full-body heave."
        ]
