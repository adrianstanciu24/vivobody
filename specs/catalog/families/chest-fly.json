      "execution": {
        "startingPosition": "Stand between the anchored ends of an elastic band with the upper arms held at shoulder height, the palms facing inward, and the elbows in a fixed slight bend.",
        "movement": "Sweep your upper arms together until your hands meet in front of your chest.",
        "endpoint": "End the sweep when your hands meet in front of your chest.",
        "returnPhase": "Return under control without pressing, changing the elbow bend, or deliberately reaching your shoulder blades forward.",
        "controlledJoints": "Hold your elbows in a fixed slight bend.",
        "supportAndPosture": "Brace your torso while standing between the anchored band ends.",
        "disqualifyingCompensations": [
