  "exerciseRules": [
    {
      "id": "dumbbell-fly-uses-supported-external-load",
      "description": "The reviewed dumbbell fly is supine on a bench with posterior support limiting scapular translation and uses comparable external load.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "dumbbell"
      },
