      "execution": {
        "startingPosition": "Stand with feet together and mark a side step equal to 60 percent of your standing height.",
        "movement": "Step directly to one side, accept weight on that leg, and lower through the lead hip and knee while the other leg stays long.",
        "endpoint": "Reach a controlled bottom position with the lead foot planted.",
        "returnPhase": "Drive through the lead foot and push back to the original feet-together stance.",
