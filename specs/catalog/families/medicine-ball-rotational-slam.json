      "execution": {
        "startingPosition": "Stand about hip-width, hold a low-bounce medicine ball in both hands near one hip, and keep the floor clear around both feet.",
        "movement": "Sweep the ball up and around overhead as you turn away, then reverse hard, turn through the feet and torso, and release the ball into the floor outside the opposite foot.",
        "endpoint": "The repetition ends when the released ball strikes the direction-specific floor target beside the opposite foot.",
        "returnPhase": "Let the ball settle, retrieve it safely, and reset at the starting hip before the next repetition.",
        "controlledJoints": "Keep the knees tracking with the feet, pivot the back foot, and keep the elbows from becoming the main source of the throw.",
        "supportAndPosture": "Use both hands, stay balanced on both feet, and complete equal work in the mirrored direction.",
        "disqualifyingCompensations": ["Slamming straight down at the midline changes the exercise into a standing overhead slam.", "Throwing into a wall changes the target and family.", "Keeping the back foot fixed while twisting through the knee removes the reviewed pivot."],
        "sideOrDirection": "Complete the set toward one floor target, then mirror the start and complete equal repetitions toward the other side."
      }
    }
