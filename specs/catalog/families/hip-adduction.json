      "execution": {
        "startingPosition": "Sit upright against the Technogym support at about eighty degrees of hip flexion with the knees near ninety degrees, hips opened about forty-five degrees, inner thighs against the pads, and hands on the handles.",
        "movement": "Move both thighs together over approximately one second toward the neutral position.",
        "endpoint": "Bring both thighs to the reviewed neutral endpoint without bouncing or crossing.",
        "returnPhase": "Open both thighs back to approximately forty-five degrees over one second while controlling the lever.",
        "controlledJoints": "Keep the pelvis, spine, and knees still and move both thighs symmetrically.",
        "supportAndPosture": "Remain upright against the back support with both hands on the handles.",
