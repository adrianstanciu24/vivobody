{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "shoulder-external-rotation",
  "name": "Shoulder External Rotation",
  "definition": "A strict unilateral isolation whose concentric phase externally rotates the humerus at the glenohumeral joint while the upper arm remains beside the torso, the elbow angle remains fixed, and the scapula and torso do not create the repetition. The initial contract admits standing cable and elastic resistance plus a side-lying dumbbell setup because those dynamic tasks have direct exercise-specific evidence. Externally rotating face pulls, Cuban presses, reverse flies, prone 90-degree-abduction rotations, throwing motions, isometric holds, and exercises that add shoulder elevation, horizontal abduction, scapular retraction, or elbow movement remain outside this narrow contract.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "dark-2007-shoulder-rotation-recruitment",
    "hintermeister-1998-elastic-shoulder-rehabilitation",
    "holzbaur-2005-upper-extremity",
    "reinold-2004-shoulder-external-rotation"
  ],
  "fixed": {
    "mechanic": "isolation",
    "pattern": null,
    "direction": null,
    "planes": [
      "transverse"
    ]
  },
  "groupPolicy": {
    "default": "shoulders",
    "allowed": [
      "shoulders"
    ]
  },
  "allowed": {
    "equipment": [
      "dumbbell",
      "cable",
      "band"
    ],
    "modalities": [
      "dynamicStrength"
    ],
    "trackingModes": [
      "reps"
    ],
    "loadModes": [
      "external",
      "nonComparable"
    ],
    "lateralities": [
      "unilateral"
    ]
  },
  "movementSignature": {
    "planeBasisActions": [
      "shoulder.externalRotation"
    ],
    "primeActions": [
      "shoulder.externalRotation"
    ],
    "forbiddenPrimeActions": [
      "shoulder.flexion",
      "shoulder.extension",
      "shoulder.abduction",
      "shoulder.adduction",
      "shoulder.horizontalAdduction",
      "shoulder.horizontalAbduction",
      "shoulder.internalRotation",
      "scapula.elevation",
      "scapula.depression",
      "scapula.protraction",
      "scapula.retraction",
      "scapula.upwardRotation",
      "scapula.downwardRotation",
      "scapula.anteriorTilt",
      "scapula.posteriorTilt",
      "elbow.flexion",
      "elbow.extension",
      "forearm.pronation",
      "forearm.supination",
      "wrist.flexion",
      "wrist.extension",
      "wrist.radialDeviation",
      "wrist.ulnarDeviation",
      "spine.flexion",
      "spine.extension",
      "spine.lateralFlexion",
      "spine.rotation",
      "hip.extension",
      "knee.extension",
      "ankle.plantarflexion"
    ],
    "stabilityDemands": [
      "shoulder",
      "scapula"
    ]
  },
  "musclePolicy": {
    "requirements": [
      {
        "anyOf": [
          "externalRotators"
        ],
        "minimumRole": "primary"
      },
      {
        "anyOf": [
          "deltoidPosterior"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "subscapularis"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "trapeziusMiddle"
        ],
        "minimumRole": "stabilizer"
      }
    ],
