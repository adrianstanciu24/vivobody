      "primary": [
        "externalRotators"
      ],
      "secondary": [
        "deltoidPosterior"
      ],
      "stabilizer": [
        "subscapularis",
        "trapeziusMiddle"
      ]
    }
  },
  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "open"
      ],
      "description": "Whether the distal segment moves freely or remains fixed."
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "standing",
        "sideLying"
      ],
      "description": "The torso orientation used to align the resistance with glenohumeral rotation."
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none",
        "bench"
      ],
      "description": "The external surface supporting the torso; a side-lying bench supports the lateral torso without defining scapular translation."
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "free"
      ],
      "description": "Whether external posterior support limits scapular translation along the thorax; lateral bench contact does not by itself constrain the posterior scapula."
    },
    {
      "id": "humerothoracicElevationDegrees",
      "valueType": "number",
      "required": true,
      "minimum": 0,
      "maximum": 0,
      "description": "Canonical thorax-relative upper-arm elevation held throughout the repetition; zero means the upper arm remains beside the torso and does not declare an elevation action."
    },
    {
      "id": "elbowMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "angleHeld"
      ],
      "description": "Whether the elbow angle remains materially unchanged or contributes dynamic flexion or extension."
    },
    {
      "id": "elbowPosture",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "flexed"
      ],
      "description": "The canonical fixed elbow posture, approximately 90 degrees of flexion in the admitted rotation setups."
    },
    {
      "id": "upperArmSupport",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none",
        "towelRoll"
      ],
      "description": "Whether a towel roll supports or spaces the proximal upper arm without moving the humerus or supporting the torso."
    },
    {
      "id": "rotationResistanceGeometry",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "medialAnchor",
        "gravity"
      ],
      "description": "The source geometry that creates an internal-rotation external torque for the working arm to overcome: an anchor medial to the working shoulder or gravity in side lying."
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "fixedValue": false,
      "description": "Whether rails or a lever constrain the external load path."
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none"
      ],
      "description": "Whether hip, knee, or ankle drive contributes to the concentric rotation."
    }
  ],
  "exerciseRules": [
    {
      "id": "cable-external-rotation-uses-standing-medial-anchor",
      "description": "The reviewed cable setup is a free-path external load anchored medial to a standing working shoulder.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "cable"
      },
      "then": [
        { "field": "loadMode", "value": "external" },
        { "field": "variant.bodyPosition", "value": "standing" },
        { "field": "variant.torsoSupport", "value": "none" },
        { "field": "variant.upperArmSupport", "value": "none" },
        { "field": "variant.rotationResistanceGeometry", "value": "medialAnchor" }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "band-external-rotation-uses-standing-medial-anchor",
      "description": "The reviewed elastic setup uses non-comparable resistance, a towel roll, and an anchor medial to a standing working shoulder.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "band"
      },
      "then": [
        { "field": "variant.bodyPosition", "value": "standing" },
        { "field": "variant.torsoSupport", "value": "none" },
        { "field": "variant.upperArmSupport", "value": "towelRoll" },
        { "field": "variant.rotationResistanceGeometry", "value": "medialAnchor" }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "dumbbell-external-rotation-uses-side-lying-gravity",
      "description": "The reviewed dumbbell setup uses gravity while the lateral torso rests on a bench and the upper arm is spaced by a towel roll.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "dumbbell"
      },
      "then": [
        { "field": "loadMode", "value": "external" },
        { "field": "variant.bodyPosition", "value": "sideLying" },
        { "field": "variant.torsoSupport", "value": "bench" },
        { "field": "variant.upperArmSupport", "value": "towelRoll" },
        { "field": "variant.rotationResistanceGeometry", "value": "gravity" }
      ],
      "requirePresent": [],
      "requireAbsent": []
    }
  ],
  "recommended": {
    "defaultReps": {
      "minimum": 8,
      "maximum": 20
    }
  },
