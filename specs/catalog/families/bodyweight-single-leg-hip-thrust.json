      "execution": {
        "startingPosition": "Rest the upper back on the edge of a bench. Set the feet about hip-width apart with the working ankle under its knee, then lift the other leg and hold that knee near a right angle.",
        "movement": "Press through the planted heel with its toes lifted and raise the pelvis by extending the working hip.",
        "endpoint": "Stop at full hip extension with the pelvis level and without arching the low back.",
        "returnPhase": "Lower the pelvis under control while keeping the free leg lifted.",
        "controlledJoints": "Keep the free knee bent near a right angle and its toe drawn toward the shin.",
        "supportAndPosture": "Keep the upper back supported on the bench and the trunk braced against pelvic rotation.",
        "disqualifyingCompensations": [
          "Putting both feet on the floor changes this to a two-leg thrust.",
          "Adding a band across the pelvis changes the resistance fixture.",
          "Resting the upper back on the floor changes the exercise to a glute bridge."
        ],
        "sideOrDirection": "Complete the set on one planted heel, then mirror the setup on the other side."
