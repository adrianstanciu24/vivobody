{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "scapular-elevation",
  "name": "Scapular Elevation",
  "definition": "A strict open-chain scapular isolation whose concentric phase elevates one or both scapulae while humeral and elbow angles remain fixed. The contract admits single-arm and simultaneous bilateral side-held dumbbell shrugs, a standing bilateral front-held barbell shrug, and Lee et al.'s exact bilateral stabilization shrug at 30 degrees of frontal-plane abduction. The paired-dumbbell fixture preserves ACE's split stance and logs one dumbbell; the single-dumbbell, barbell, and no-implement branches retain separate accounting. All model upward rotation as a coupled prime action instead of pretending that a shrug is pure vertical translation. Rolling, overhead, behind-body, trap-bar, machine, carry, upright-row, neck-motion, strapped, and leg-driven variants remain outside this narrow contract.",
  "evidenceRefs": [
    "castelein-2016-scapular-muscles-shrug",
    "lee-2016-stabilization-shrug-upward-rotation",
    "seth-2019-shoulder-work",
    "werthel-2019-trapezius-transfer",
    "ace-2026-shrug",
    "ace-2026-standing-dumbbell-shrug"
  ],
  "fixed": {
    "mechanic": "isolation",
    "trainingRole": "pull",
    "pattern": null,
    "direction": null,
    "planes": [
      "frontal"
    ]
  },
