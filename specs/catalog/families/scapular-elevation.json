  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "open"
      ],
      "description": "Whether the dumbbell-bearing hand moves freely or remains fixed to the environment."
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "standing"
      ],
      "description": "The gross body position used by the measured shoulder-shrug fixture."
    },
    {
      "id": "stanceConfiguration",
      "valueType": "enum",
      "required": true,
      "allowedValues": ["sourceUnreported", "splitStance", "hipWidthBilateral", "shoulderWidthBilateral"],
      "description": "The source-authored lower-body stance retained while the legs do not create the shrug."
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none"
      ],
      "description": "Whether an external surface supports the torso during the repetition."
    },
    {
      "id": "contralateralSupport",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none"
      ],
      "description": "Whether the non-working side braces against an external support during the unilateral repetition."
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "free"
      ],
      "description": "Whether external posterior support limits scapular translation along the thorax."
    },
    {
      "id": "upperArmPosition",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "atSide",
        "abducted30"
      ],
      "description": "The maintained humerothoracic position: beside the torso in the loaded dumbbell and barbell fixtures or abducted 30 degrees in the stabilization fixture, without dynamic humeral elevation."
    },
    {
      "id": "humerothoracicElevationDegrees",
      "valueType": "number",
      "required": true,
      "minimum": 0,
      "maximum": 30,
      "description": "The fixed thorax-relative upper-arm angle used by the reviewed fixture, not a dynamic shoulder-abduction action."
    },
    {
      "id": "elevationPlane",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "notApplicable",
        "frontal"
      ],
      "description": "The plane of the held humeral angle; it is not applicable with the arm at the side and is frontal in the exact 30-degree stabilization shrug."
    },
    {
      "id": "humeralRotation",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "neutral",
        "notReported"
      ],
      "description": "The maintained axial humeral orientation when the source reports it; Lee et al. did not report this coordinate for the stabilization shrug."
    },
    {
      "id": "elbowMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "angleHeld"
      ],
      "description": "Whether the elbow angle remains materially unchanged or contributes dynamic motion."
    },
    {
      "id": "elbowPosture",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "extended"
      ],
      "description": "The extended elbow posture held throughout the scapular excursion."
    },
    {
      "id": "forearmMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "angleHeld"
      ],
      "description": "Whether radioulnar orientation remains fixed or contributes dynamic rotation."
    },
    {
      "id": "forearmOrientation",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "neutral",
        "pronated",
        "notReported"
      ],
      "description": "The thumb-forward dumbbell posture, palms-down barbell posture, or explicitly unreported radioulnar orientation in Lee et al.'s no-implement fixture."
    },
    {
      "id": "handTask",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "staticImplementHold",
        "none"
      ],
      "description": "Whether the hands statically hold the dumbbell or barbell implement or carry no training implement in the laboratory stabilization shrug."
    },
    {
      "id": "implementConfiguration",
      "valueType": "enum",
      "required": true,
      "allowedValues": ["singleDumbbell", "pairedDumbbells", "straightBarbell", "none"],
      "description": "The exact implement count and arrangement, which keeps single- and paired-dumbbell histories distinct."
    },
    {
      "id": "scapularSequence",
      "valueType": "enum",
      "required": true,
      "allowedValues": ["unilateralWorkingSide", "simultaneousBilateral"],
      "description": "Whether one working scapula or both scapulae elevate during each repetition."
    },
    {
      "id": "resistanceGeometry",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "gravityLoadedDumbbell",
        "gravityLoadedBarbell",
        "armSegmentGravity"
      ],
      "description": "Whether a dumbbell or barbell supplies the downward load or the laboratory task elevates only the arm segments against gravity."
    },
    {
      "id": "gripWidth",
      "valueType": "enum",
      "required": false,
      "description": "The barbell hand spacing; non-barbell fixtures omit this field.",
      "allowedValues": ["shoulderWidth"]
    },
    {
      "id": "loadAccounting",
      "valueType": "enum",
      "required": true,
      "description": "How the logged scalar maps to the exact single, paired, barbell, or unloaded fixture.",
      "allowedValues": ["totalSingleImplement", "perImplement", "totalBarAndPlates", "notApplicable"]
    },
    {
      "id": "humerothoracicAngleControl",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none",
        "digitalInclinometer"
      ],
      "description": "Whether the exact setup uses an inclinometer to maintain 30 degrees of shoulder abduction."
    },
    {
      "id": "craniocervicothoracicStabilization",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none",
        "investigatorManual"
      ],
      "description": "Whether an investigator manually stabilizes the chin and the most prominent thoracic spinous process during the shrug."
    },
    {
      "id": "shrugHeightTarget",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none",
        "individualMaximumTargetBars"
      ],
      "description": "Whether bilateral target bars are set to the participant's individual maximum shrug height."
    },
    {
      "id": "topHoldSeconds",
      "valueType": "number",
      "required": true,
      "minimum": 0,
      "maximum": 5,
      "description": "The source-prescribed hold at maximum shrug height: five seconds in Lee et al.'s stabilization condition and no prescribed top hold in either loaded fixture."
    },
    {
      "id": "wristGuide",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none",
        "radialBordersAgainstPlasticGuides"
      ],
      "description": "Whether light radial-wrist contact with plastic guides maintains the frontal-plane arm path."
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "fixedValue": false,
      "description": "Whether rails or a lever machine constrain the external load path."
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none"
      ],
      "description": "Whether hip, knee, ankle, or foot motion contributes to the repetition."
    },
    {
      "id": "neckContribution",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none"
      ],
      "description": "Whether deliberate cervical motion contributes to the repetition. This review axis records a fixed technique boundary because the current anatomical foundation has no cervical joint-action region."
    }
  ],
  "exerciseRules": [
    {
      "id": "dumbbell-fixtures-are-arms-at-side-loaded-shrugs",
      "description": "Both reviewed dumbbell fixtures hold neutral-grip implements at the sides without laboratory guides or manual stabilization.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "dumbbell"
      },
      "then": [
        { "field": "loadMode", "value": "external" },
        { "field": "variant.upperArmPosition", "value": "atSide" },
        { "field": "variant.humerothoracicElevationDegrees", "value": 0 },
        { "field": "variant.elevationPlane", "value": "notApplicable" },
        { "field": "variant.humeralRotation", "value": "neutral" },
        { "field": "variant.forearmOrientation", "value": "neutral" },
        { "field": "variant.handTask", "value": "staticImplementHold" },
        { "field": "variant.implementConfiguration", "allowedValues": ["singleDumbbell", "pairedDumbbells"] },
        { "field": "variant.resistanceGeometry", "value": "gravityLoadedDumbbell" },
        { "field": "variant.humerothoracicAngleControl", "value": "none" },
        { "field": "variant.craniocervicothoracicStabilization", "value": "none" },
        { "field": "variant.shrugHeightTarget", "value": "none" },
        { "field": "variant.topHoldSeconds", "value": 0 },
        { "field": "variant.wristGuide", "value": "none" }
      ],
      "requirePresent": ["variant.loadAccounting"],
      "requireAbsent": ["variant.gripWidth"],
      "requireMuscleRequirements": [
        {
          "anyOf": [
            "extensorCarpiRadialis"
          ],
          "minimumRole": "stabilizer"
        },
        {
          "anyOf": [
            "fingerFlexors"
          ],
          "minimumRole": "stabilizer"
        }
      ],
      "requireAdditionalStabilityDemands": [
        "wrist",
        "hand"
      ]
    },
    {
      "id": "single-dumbbell-configuration-is-unilateral",
      "description": "The single-dumbbell fixture remains a unilateral shrug and logs the complete dumbbell once.",
      "when": {"field": "variant.implementConfiguration", "operator": "equals", "value": "singleDumbbell"},
      "then": [
        {"field": "equipment", "value": "dumbbell"},
        {"field": "laterality", "value": "unilateral"},
        {"field": "variant.stanceConfiguration", "value": "sourceUnreported"},
        {"field": "variant.scapularSequence", "value": "unilateralWorkingSide"},
        {"field": "variant.loadAccounting", "value": "totalSingleImplement"}
      ],
      "requirePresent": ["variant.loadAccounting"],
      "requireAbsent": ["variant.gripWidth"]
    },
    {
      "id": "paired-dumbbell-configuration-is-simultaneous-bilateral",
      "description": "ACE's paired-dumbbell fixture uses a split stance, simultaneous bilateral elevation, and per-implement accounting.",
      "when": {"field": "variant.implementConfiguration", "operator": "equals", "value": "pairedDumbbells"},
      "then": [
        {"field": "equipment", "value": "dumbbell"},
        {"field": "laterality", "value": "bilateral"},
        {"field": "variant.stanceConfiguration", "value": "splitStance"},
        {"field": "variant.scapularSequence", "value": "simultaneousBilateral"},
        {"field": "variant.loadAccounting", "value": "perImplement"}
      ],
      "requirePresent": ["variant.loadAccounting"],
      "requireAbsent": ["variant.gripWidth"]
    },
    {
      "id": "other-fixture-is-bilateral-stabilization-shrug",
      "description": "The only admitted other-equipment fixture is Lee et al.'s bilateral 30-degree laboratory stabilization shrug.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "other"
      },
      "then": [
        { "field": "laterality", "value": "bilateral" },
        { "field": "loadMode", "value": "nonComparable" },
        { "field": "variant.upperArmPosition", "value": "abducted30" },
        { "field": "variant.humerothoracicElevationDegrees", "value": 30 },
        { "field": "variant.elevationPlane", "value": "frontal" },
        { "field": "variant.humeralRotation", "value": "notReported" },
        { "field": "variant.forearmOrientation", "value": "notReported" },
        { "field": "variant.handTask", "value": "none" },
        { "field": "variant.implementConfiguration", "value": "none" },
        { "field": "variant.scapularSequence", "value": "simultaneousBilateral" },
        { "field": "variant.resistanceGeometry", "value": "armSegmentGravity" },
        { "field": "variant.stanceConfiguration", "value": "shoulderWidthBilateral" },
        { "field": "variant.loadAccounting", "value": "notApplicable" },
        { "field": "variant.humerothoracicAngleControl", "value": "digitalInclinometer" },
        { "field": "variant.craniocervicothoracicStabilization", "value": "investigatorManual" },
        { "field": "variant.shrugHeightTarget", "value": "individualMaximumTargetBars" },
        { "field": "variant.topHoldSeconds", "value": 5 },
        { "field": "variant.wristGuide", "value": "radialBordersAgainstPlasticGuides" }
      ],
      "requirePresent": ["variant.loadAccounting"],
      "requireAbsent": ["variant.gripWidth"],
      "requireMuscleRequirements": [
        {
          "anyOf": [
            "deltoidLateral"
          ],
          "minimumRole": "stabilizer"
        },
        {
          "anyOf": [
            "supraspinatus"
          ],
          "minimumRole": "stabilizer"
        }
      ],
      "requireAdditionalStabilityDemands": []
    },
    {
      "id": "barbell-fixture-is-front-held-bilateral-shrug",
      "description": "The barbell branch is the strict bilateral front-held pronated shrug with total-load accounting.",
      "when": {"field": "equipment", "operator": "equals", "value": "barbell"},
      "then": [
        {"field": "laterality", "value": "bilateral"}, {"field": "loadMode", "value": "external"},
        {"field": "variant.upperArmPosition", "value": "atSide"}, {"field": "variant.humerothoracicElevationDegrees", "value": 0},
        {"field": "variant.elevationPlane", "value": "notApplicable"}, {"field": "variant.humeralRotation", "value": "neutral"},
        {"field": "variant.forearmOrientation", "value": "pronated"}, {"field": "variant.handTask", "value": "staticImplementHold"},
        {"field": "variant.implementConfiguration", "value": "straightBarbell"}, {"field": "variant.scapularSequence", "value": "simultaneousBilateral"},
        {"field": "variant.resistanceGeometry", "value": "gravityLoadedBarbell"}, {"field": "variant.gripWidth", "value": "shoulderWidth"},
        {"field": "variant.stanceConfiguration", "value": "hipWidthBilateral"},
        {"field": "variant.loadAccounting", "value": "totalBarAndPlates"}, {"field": "variant.humerothoracicAngleControl", "value": "none"},
        {"field": "variant.craniocervicothoracicStabilization", "value": "none"}, {"field": "variant.shrugHeightTarget", "value": "none"},
        {"field": "variant.topHoldSeconds", "value": 0}, {"field": "variant.wristGuide", "value": "none"}
      ],
      "requirePresent": ["variant.gripWidth", "variant.loadAccounting"],
      "requireAbsent": [],
      "requireMuscleRequirements": [
        {"anyOf": ["extensorCarpiRadialis"], "minimumRole": "stabilizer"},
        {"anyOf": ["fingerFlexors"], "minimumRole": "stabilizer"}
      ],
      "requireAdditionalStabilityDemands": ["wrist", "hand"]
    }
  ],
