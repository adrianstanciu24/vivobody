      "execution": {
        "startingPosition": "Stand with both feet slightly wider than hip-width, hinge until the torso is approximately parallel to the floor, brace the opposite hand on a bench, and hold one kettlebell beneath the working shoulder with a straight arm.",
        "movement": "Row the kettlebell toward the working-side armpit while deliberately rotating the shoulders and upper back over that side.",
        "endpoint": "Finish with the kettlebell near the armpit and the upper body turned while the hips and knees remain still.",
        "returnPhase": "Untwist and lower the kettlebell slowly until the arm is straight beneath the shoulder.",
        "controlledJoints": "Keep both feet planted and prevent the hips and knees from driving or following the turn.",
        "supportAndPosture": "Maintain the hand-supported hinge and rotate through the upper body rather than shifting the pelvis.",
        "disqualifyingCompensations": [
          "Keeping the torso square changes the fixture into a strict supported row.",
          "Turning the hips or driving through the legs changes the reviewed upper-body rotation strategy.",
          "Placing the opposite knee on the bench changes the support topology."
        ],
        "sideOrDirection": "Complete all repetitions on one side, then switch the kettlebell and bench-support hand."
