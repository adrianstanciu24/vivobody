{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "incline-press",
  "name": "Incline Press",
  "definition": "A chest-oriented compound press whose resistance path is directed 15 to 45 degrees superior to a horizontal press relative to the torso. The concentric phase combines shoulder horizontal adduction and shoulder flexion with elbow extension. Flat, declined, greater-than-45-degree shoulder-dominant, fly, landmine, and unsupported overhead presses belong to other families. The current authored scope is bilateral and supported; cable, unilateral, and bodyweight variants are deferred. A feet-elevated push-up is owned by this family when closed-chain bodyweight variants are reviewed.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "borges-2019-bench-machine-scapula",
    "boroto-2018-scapular-stabilizers-press",
    "cabral-2022-pectoralis-regions",
    "coratella-2020-bench-press-variations",
    "lee-2019-pectoralis-force-direction",
    "lauver-2016-bench-angle",
    "rodriguez-ridao-2020-bench-inclinations"
  ],
  "fixed": {
    "mechanic": "compound",
    "trainingRole": "push",
    "pattern": "push",
    "direction": "diagonal",
    "planes": [
      "transverse",
      "sagittal"
    ]
  },
  "groupPolicy": {
    "default": "chest",
    "allowed": [
      "chest"
    ]
  },
  "allowed": {
    "equipment": [
      "barbell",
      "dumbbell",
      "machine"
    ],
    "modalities": [
      "dynamicStrength"
    ],
    "trackingModes": [
      "reps"
    ],
    "loadModes": [
      "external"
    ],
    "lateralities": [
      "bilateral"
    ]
  },
  "movementSignature": {
    "planeBasisActions": [
      "shoulder.horizontalAdduction",
      "shoulder.flexion"
    ],
    "primeActions": [
      "shoulder.horizontalAdduction",
      "shoulder.flexion",
      "elbow.extension"
    ],
    "forbiddenPrimeActions": [
      "shoulder.extension"
    ],
    "stabilityDemands": [
      "shoulder",
      "scapula"
    ]
  },
  "musclePolicy": {
    "requirements": [
      {
        "anyOf": [
          "pectoralisMajorClavicular"
        ],
        "minimumRole": "primary"
      },
      {
        "anyOf": [
          "pectoralisMajorSternocostal"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "deltoidAnterior"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "triceps"
        ],
        "minimumRole": "secondary"
      }
    ],
    "allowedByRole": {
      "primary": [
        "pectoralisMajorClavicular"
      ],
      "secondary": [
        "pectoralisMajorSternocostal",
        "deltoidAnterior",
        "triceps"
      ],
      "stabilizer": [
        "serratus",
        "trapeziusMiddle",
        "externalRotators"
      ]
    }
  },
  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether the distal segment moves freely or remains fixed.",
      "allowedValues": [
        "open"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "The support that fixes the torso at the authored incline.",
      "allowedValues": [
        "bench",
        "machinePad"
      ]
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "description": "Whether external posterior support limits scapular translation along the thorax; this does not classify scapular rotation or tilt.",
      "allowedValues": [
        "supportConstrained"
      ]
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "Canonical forearm and hand orientation through the working range.",
      "allowedValues": [
        "pronated",
        "neutral"
      ]
    },
    {
      "id": "pressInclinationDegrees",
      "valueType": "number",
      "required": true,
      "description": "Signed inclination of the canonical torso-relative press from horizontal: positive toward overhead and negative toward decline; a supported free-weight press uses backrest angle as the proxy.",
      "minimum": 15,
      "maximum": 45
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "description": "Whether rails or a lever constrain the external load path."
    },
    {
      "id": "machineType",
      "valueType": "enum",
      "required": false,
      "description": "The machine mechanism when equipment is machine.",
      "allowedValues": [
        "smith",
        "convergingChestPress"
      ]
    }
  ],
  "exerciseRules": [
    {
      "id": "machine-requires-fixed-path-and-type",
      "description": "Machine incline presses use a constrained load path and declare the machine mechanism.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "machine"
      },
      "then": [
        {
          "field": "variant.fixedPath",
          "value": true
        }
      ],
      "requirePresent": [
        "variant.machineType"
      ],
      "requireAbsent": []
    },
    {
      "id": "non-machine-requires-free-path",
      "description": "Barbell and dumbbell incline presses keep a free load path and do not declare a machine mechanism.",
      "when": {
        "field": "equipment",
        "operator": "notEquals",
        "value": "machine"
      },
      "then": [
        {
          "field": "variant.fixedPath",
          "value": false
        }
      ],
      "requirePresent": [],
      "requireAbsent": [
        "variant.machineType"
      ]
    },
    {
      "id": "barbell-requires-bench",
      "description": "A free barbell incline press uses an inclined bench for torso support.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "barbell"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "bench"
        },
        {
          "field": "variant.gripOrientation",
          "value": "pronated"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "dumbbell-requires-bench",
      "description": "A dumbbell incline press uses an inclined bench for torso support.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "dumbbell"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "bench"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "smith-uses-bench",
      "description": "A Smith incline press uses an inclined bench and a pronated grip beneath the rails.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "smith"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "bench"
        },
        {
          "field": "variant.gripOrientation",
          "value": "pronated"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "chest-press-machine-uses-pad",
      "description": "A converging incline chest-press machine supports the torso against its pad and uses the canonical neutral handles.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "convergingChestPress"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "machinePad"
        },
        {
          "field": "variant.gripOrientation",
          "value": "neutral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "support-constrained-translation-requires-stabilizer-pair",
      "description": "A torso-supported press with support-constrained scapular translation records both serratus and middle trapezius as stabilizers; support type does not select one of them.",
      "when": {
        "field": "variant.scapularTranslation",
        "operator": "equals",
        "value": "supportConstrained"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "serratus",
          "role": "stabilizer"
        },
        {
          "muscle": "trapeziusMiddle",
          "role": "stabilizer"
        }
      ]
    }
  ],
  "recommended": {
    "defaultReps": {
      "minimum": 5,
      "maximum": 15
    }
  },
