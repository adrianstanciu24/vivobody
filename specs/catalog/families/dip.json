{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "dip",
  "name": "Dip",
  "definition": "A strict bilateral closed-chain compound push performed while the body is supported above fixed parallel bars or independent rings. From a self-selected bottom position with the shoulders extended behind the torso and the elbows flexed, the concentric phase returns the shoulders toward neutral through shoulder flexion while extending the elbows. Scapular motion was not measured in the reviewed dip trials, so depression, protraction, and every other scapular action remain outside the prime-action signature. Bench-supported, assisted-machine, band-assisted, standing-assisted, weighted-belt-as-a-separate-exercise, Russian, Korean, straight-bar, kipping, and muscle-up transition variants remain outside this initial contract.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "mckenzie-2022-dip-variations",
    "mckenzie-2022-bar-dip-fatigue"
  ],
  "fixed": {
    "mechanic": "compound",
    "pattern": "push",
    "direction": "vertical",
    "planes": [
      "sagittal"
    ]
  },
  "groupPolicy": {
    "default": "chest",
    "allowed": [
      "chest"
    ]
  },
  "allowed": {
