  "exerciseRules": [
    {
      "id": "bodyweight-dips-pin-unassisted-topology",
      "description": "Bodyweight bar and ring dips remain fully suspended, free-path, bodyweight-added fixtures without assistance accounting.",
      "when": {"field": "equipment", "operator": "equals", "value": "bodyweight"},
      "then": [
        {"field": "loadMode", "value": "bodyweightAdded"}, {"field": "bodyweightFraction", "value": 1},
        {"field": "variant.bodyPosition", "value": "suspended"}, {"field": "variant.lowerBodySupport", "value": "none"},
        {"field": "variant.pathConstraint", "value": "free"},
        {"field": "variant.bodyweightApparatus", "allowedValues": ["fixedDipBars", "rings"]}
      ],
      "requirePresent": [],
      "requireAbsent": ["variant.loadAccounting"]
    },
    {
      "id": "dip-bars-use-fixed-support",
      "description": "The reviewed bar-dip apparatus is fixed to the frame rather than moving independently.",
      "when": {
        "field": "variant.bodyweightApparatus",
        "operator": "equals",
        "value": "fixedDipBars"
      },
      "then": [
        {
          "field": "variant.handSupportConstraint",
          "value": "fixed"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "rings-use-independent-unstable-support",
      "description": "Ring dips use independently moving supports and retain the directly observed extra biceps and latissimus stabilization assignments.",
      "when": {
        "field": "variant.bodyweightApparatus",
        "operator": "equals",
        "value": "rings"
      },
      "then": [
        {
          "field": "variant.handSupportConstraint",
          "value": "independentUnstable"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "lats",
          "role": "stabilizer"
        },
        {
          "muscle": "bicepsBrachii",
          "role": "stabilizer"
        }
      ]
    },
    {
      "id": "assisted-machine-pins-exact-counterweight-fixture",
      "description": "The machine branch is only the Life Fitness Pro 2 PSADC knee-platform fixture, with selected mass subtracted from full bodyweight.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "machine"
      },
      "then": [
        {"field": "loadMode", "value": "assistanceSubtracted"},
        {"field": "bodyweightFraction", "value": 1},
        {"field": "variant.bodyPosition", "value": "kneelingOnAssistancePad"},
        {"field": "variant.lowerBodySupport", "value": "assistancePlatform"},
        {"field": "variant.pathConstraint", "value": "assistancePadGuided"},
        {"field": "variant.bodyweightApparatus", "value": "lifeFitnessPro2PSADC"},
        {"field": "variant.handSupportConstraint", "value": "multiPositionFixedDuringRepetition"},
        {"field": "variant.loadAccounting", "value": "selectedAssistanceSameFixtureOnly"}
      ],
      "requirePresent": ["variant.loadAccounting"],
      "requireAbsent": []
    },
    {
      "id": "psadc-apparatus-reverses-to-machine-assistance",
      "description": "Selecting the PSADC apparatus always identifies the exact machine-assisted branch.",
      "when": {"field": "variant.bodyweightApparatus", "operator": "equals", "value": "lifeFitnessPro2PSADC"},
      "then": [
        {"field": "equipment", "value": "machine"}, {"field": "loadMode", "value": "assistanceSubtracted"},
        {"field": "variant.loadAccounting", "value": "selectedAssistanceSameFixtureOnly"}
      ],
      "requirePresent": ["variant.loadAccounting"],
      "requireAbsent": []
    }
