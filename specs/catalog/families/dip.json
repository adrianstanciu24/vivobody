      ]
    },
    {
      "id": "lowerBodySupport",
      "valueType": "enum",
      "required": true,
      "description": "The lower-body contact or support that materially changes effective bodyweight loading; none for a fully suspended dip.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "description": "Whether external posterior support limits scapular translation along the thorax; this does not declare a scapular prime action.",
      "allowedValues": [
        "free"
      ]
    },
    {
      "id": "pathConstraint",
      "valueType": "enum",
      "required": true,
      "description": "Whether an external mechanism guides the body path; both reviewed supports leave it free.",
      "allowedValues": [
        "free"
      ]
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "description": "Whether hip, knee, or ankle drive contributes to the concentric repetition.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "bodyweightApparatus",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed hand-support apparatus carrying bodyweight during the dip.",
      "allowedValues": [
        "fixedDipBars",
        "rings"
      ]
    },
    {
      "id": "handSupportConstraint",
      "valueType": "enum",
      "required": true,
      "description": "Whether the two hand supports are fixed to the frame or move independently.",
      "allowedValues": [
        "fixed",
        "independentUnstable"
      ]
    }
  ],
  "exerciseRules": [
    {
      "id": "dip-bars-use-fixed-support",
      "description": "The reviewed bar-dip apparatus is fixed to the frame rather than moving independently.",
      "when": {
        "field": "variant.bodyweightApparatus",
        "operator": "equals",
        "value": "fixedDipBars"
      },
      "then": [
        {
          "field": "variant.handSupportConstraint",
          "value": "fixed"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "rings-use-independent-unstable-support",
      "description": "Ring dips use independently moving supports and retain the directly observed extra biceps and latissimus stabilization assignments.",
      "when": {
        "field": "variant.bodyweightApparatus",
        "operator": "equals",
        "value": "rings"
      },
      "then": [
