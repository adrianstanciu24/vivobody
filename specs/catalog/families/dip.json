{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "dip",
  "name": "Dip",
  "definition": "A strict bilateral closed-chain compound push performed while the body is supported above fixed parallel bars or independent rings. From a self-selected bottom position with the shoulders extended behind anatomical neutral and the elbows flexed, the concentric phase returns the shoulders only toward neutral through conditioned shoulder flexion while extending the elbows. Parallel-bar sternocostal-site EMG and separately measured dip kinematics jointly support sternocostal pectoralis as a categorical prime mover; the ring assignment is a disclosed mechanics transfer across the same measured action and is corroborated only as tissue loading by a clinical case, not by direct regional ring EMG. Scapular motion was not measured in the reviewed dip trials, so depression, protraction, and every other scapular action remain outside the prime-action signature. Bench-supported, assisted-machine, band-assisted, standing-assisted, weighted-belt-as-a-separate-exercise, Russian, Korean, straight-bar, kipping, and muscle-up transition variants remain outside this initial contract.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "cinarli-2021-parallel-bar-dip",
    "da-silva-2022-ring-dip-pectoralis-rupture",
    "mckenzie-2022-dip-variations",
    "mckenzie-2022-bar-dip-fatigue"
  ],
