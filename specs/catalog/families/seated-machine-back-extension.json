      "execution": {
        "startingPosition": "Select the stack weight on the Life Fitness Insignia SS-BE. Sit with your hips against the lumbar pad, place your feet on the foot support, and adjust the back pad to a comfortable starting position. Grip the handles with your chest up. Record the selected stack weight and compare it only on the same machine and start setting.",
        "movement": "Extend your back and hips together as you press your upper torso backward against the roller.",
        "endpoint": "Stop when your lower back contacts the lumbar pad, then pause briefly.",
        "returnPhase": "Return slowly to the starting position without letting the stack drop.",
        "controlledJoints": "Keep the movement controlled and avoid twisting or driving the repetition with your legs.",
        "supportAndPosture": "Keep your hips seated against the lumbar support and both feet on the foot support.",
        "disqualifyingCompensations": [
          "Lifting the hips off the seat changes the supported seated extension.",
          "Pushing forcefully through the legs adds a leg-driven repetition.",
          "Twisting or throwing the torso backward replaces the controlled extension."
        ]
      }
    }
