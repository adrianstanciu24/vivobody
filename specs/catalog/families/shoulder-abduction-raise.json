{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "shoulder-abduction-raise",
  "name": "Lateral Raise",
  "definition": "A strict single-joint raise in which an open-chain upper arm abducts from the side to shoulder height in the frontal plane while the elbow angle, neutral humeral rotation, torso, and lower body remain controlled. Scapular upward rotation and posterior tilt are normal coupled elevation actions, not fixed-ratio claims. Upper trapezius is a secondary dynamic contributor to the declared upward rotation, not the exercise's primary shoulder target: loaded arm-elevation modeling supports positive scapular work, and a direct small unweighted held-position comparison observed its activity increasing gradually in both abduction and flexion. The categorical role does not assert equal magnitude to lateral deltoid or equal recruitment across elevation paths. The initial roster represents the strict frontal-path subset prescribed in the direct cable-versus-dumbbell trial; symptom-driven intermediate frontal-to-scapular accommodations reported for some participants do not admit scaption into this family.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "holzbaur-2005-upper-extremity",
    "seth-2019-shoulder-work",
    "ludewig-2009-multiplanar-humeral-elevation",
    "morihara-2011-scapular-muscles-flexion-abduction",
    "parry-2012-dumbbell-shoulder-elevation",
    "hecker-2021-deltoid-flexion-abduction",
    "larsen-2025-cable-dumbbell-lateral-raise"
  ],
