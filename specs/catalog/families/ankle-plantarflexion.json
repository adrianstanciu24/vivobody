      "required": true,
      "allowedValues": [
        "shoulderPad",
        "distalThighPad",
        "none"
      ],
      "description": "Where the reviewed machine applies its external load to the athlete."
    },
    {
      "id": "machineType",
      "valueType": "enum",
      "required": false,
      "allowedValues": [
        "standingCalfRaise",
        "seatedCalfRaise"
      ],
      "description": "The reviewed calf-raise machine mechanism."
    },
    {
      "id": "limbSequence",
      "valueType": "enum",
      "required": false,
      "description": "The bilateral fixtures move both ankles together; unilateral fixtures omit this field.",
      "allowedValues": [
        "simultaneousBilateral"
      ]
    },
    {
      "id": "loadAccounting",
      "valueType": "enum",
      "required": true,
      "description": "The entered stack or machine value is comparable only on the same machine fixture.",
      "allowedValues": [
        "enteredExternalLoadSameFixtureOnly",
        "notApplicable"
      ]
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
