{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "ankle-plantarflexion",
  "name": "Ankle Plantarflexion",
  "definition": "A strict closed-chain calf raise in which one heel or both heels rise through ankle plantarflexion while the forefoot remains supported and the knee, hip, pelvis, and spine remain held. The roster contains unilateral and simultaneous bilateral machine fixtures plus one exact single-leg bodyweight fixture with an extended knee, light wall contact for balance only, and at least five centimeters of heel rise. Soleus is primary in both postures; gastrocnemius is primary with the knee extended and secondary with the knee flexed. Loaded free-weight, Smith, leg-press, donkey, wall-unloaded, jumping, partial-range, and toe-flexion variants remain outside this family.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "cybex-2008-plate-loaded-manual",
    "hammer-strength-2025-select-manual",
    "kinoshita-2023-standing-seated-calf-raise",
    "flanagan-2005-heel-raise-biomechanics",
    "manago-2021-single-leg-heel-raise"
  ],
