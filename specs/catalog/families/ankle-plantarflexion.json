        "field": "variant.machineType",
        "operator": "equals",
        "value": "seatedCalfRaise"
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "value": "seated"
        },
        {
          "field": "variant.kneeFlexionDegrees",
          "value": 90
        },
        {
          "field": "variant.pelvisSupport",
          "value": "machineSeat"
        },
        {
          "field": "variant.loadInterface",
          "value": "distalThighPad"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "bilateral-calf-raise-moves-together",
      "description": "Bilateral calf raises use simultaneous ankle motion.",
      "when": {
        "field": "laterality",
        "operator": "equals",
        "value": "bilateral"
      },
      "then": [
        {
          "field": "variant.limbSequence",
          "value": "simultaneousBilateral"
        }
      ],
      "requirePresent": [
        "variant.limbSequence"
      ],
      "requireAbsent": []
    },
    {
      "id": "unilateral-calf-raise-omits-bilateral-sequence",
      "description": "Single-leg calf raises cannot claim simultaneous bilateral motion.",
      "when": {
        "field": "laterality",
        "operator": "equals",
        "value": "unilateral"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [
        "variant.limbSequence"
      ]
    },
    {
      "id": "machine-calf-raise-fixture",
      "description": "Machine calf raises keep machine-only load, platform, path, and fixture fields while omitting wall-balance axes.",
      "when": {"field": "equipment", "operator": "equals", "value": "machine"},
      "then": [
        {"field": "loadMode", "value": "external"},
        {"field": "variant.footOrientation", "value": "neutral"},
        {"field": "variant.forefootSupport", "value": "machinePlatform"},
        {"field": "variant.loadAccounting", "value": "enteredExternalLoadSameFixtureOnly"},
        {"field": "variant.fixedPath", "value": true}
      ],
      "requirePresent": ["variant.machineType"],
      "requireAbsent": ["variant.handSupport", "variant.balanceAssistance", "variant.minimumHeelRiseCm", "variant.repetitionStyle"]
    },
    {
      "id": "wall-balanced-bodyweight-fixture",
      "description": "The bodyweight branch is exactly the continuous, single-leg, extended-knee heel raise with light wall balance and a five-centimeter minimum rise.",
      "when": {"field": "equipment", "operator": "equals", "value": "bodyweight"},
      "then": [
        {"field": "laterality", "value": "unilateral"},
        {"field": "loadMode", "value": "nonComparable"},
        {"field": "bodyweightFraction", "value": 0},
        {"field": "variant.bodyPosition", "value": "standing"},
        {"field": "variant.pelvisSupport", "value": "none"},
        {"field": "variant.kneeFlexionDegrees", "value": 0},
        {"field": "variant.footOrientation", "value": "sourceUnreported"},
        {"field": "variant.forefootSupport", "value": "floor"},
        {"field": "variant.loadInterface", "value": "none"},
        {"field": "variant.loadAccounting", "value": "notApplicable"},
        {"field": "variant.fixedPath", "value": false},
        {"field": "variant.handSupport", "value": "lightWallBalanceAtShoulderHeight"},
        {"field": "variant.balanceAssistance", "value": "balanceOnlyNoUnloading"},
        {"field": "variant.minimumHeelRiseCm", "value": 5},
        {"field": "variant.repetitionStyle", "value": "continuousSameSide"}
      ],
      "requirePresent": ["variant.handSupport", "variant.balanceAssistance", "variant.minimumHeelRiseCm", "variant.repetitionStyle"],
      "requireAbsent": ["variant.machineType", "variant.limbSequence"],
      "requireInvolvement": [
        {"muscle": "gastrocnemius", "role": "primary"},
        {"muscle": "soleus", "role": "primary"}
      ]
    },
    {
      "id": "source-unreported-foot-orientation-is-bodyweight-only",
      "description": "The unreported foot-orientation value belongs only to the source-exact wall-balanced bodyweight fixture.",
      "when": {"field": "variant.footOrientation", "operator": "equals", "value": "sourceUnreported"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": [],
      "requireAbsent": ["variant.machineType"]
    },
    {
      "id": "light-wall-balance-is-bodyweight-only",
      "description": "The light wall-balance vocabulary cannot be reused by a loaded machine record.",
      "when": {"field": "variant.handSupport", "operator": "equals", "value": "lightWallBalanceAtShoulderHeight"},
      "then": [{"field": "equipment", "value": "bodyweight"}],
      "requirePresent": ["variant.balanceAssistance", "variant.minimumHeelRiseCm"],
      "requireAbsent": ["variant.machineType"]
    }
  ],
