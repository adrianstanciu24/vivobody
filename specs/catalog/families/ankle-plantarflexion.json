  "exerciseRules": [
    {
      "id": "standing-calf-raise-uses-extended-knee-setup",
      "description": "The standing machine condition uses an extended knee, no pelvis support, shoulder-pad load, and the standing calf machine while gastrocnemius is primary.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "standingCalfRaise"
      },
      "then": [
        {
          "field": "variant.kneeFlexionDegrees",
          "value": 0
        },
        {
          "field": "variant.pelvisSupport",
          "value": "none"
        },
        {
          "field": "variant.loadInterface",
          "value": "shoulderPad"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "gastrocnemius",
          "role": "primary"
        }
      ]
    },
    {
      "id": "standing-calf-machine-requires-standing-setup",
