{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "ankle-plantarflexion",
  "name": "Ankle Plantarflexion",
  "definition": "A strict closed-chain machine calf raise in which the heel rises through ankle plantarflexion while the forefoot remains supported and the knee, hip, pelvis, spine, and foot orientation remain held. The initial roster contains only the directly trained unilateral standing and seated machine conditions at 0 and 90 degrees of knee flexion. Soleus is primary in both; gastrocnemius is primary with the knee extended and secondary with the knee flexed, reflecting direct individual-muscle hypertrophy rather than assigning both postures identical anatomy. Flexor hallucis longus is anatomy-permitted but not authored because the source did not measure it and deliberate toe flexion is excluded. Bilateral, free-weight, Smith, leg-press, donkey, bodyweight, balance, jumping, partial-range, rotated-foot, and toe-flexion variants remain outside this family.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "kinoshita-2023-standing-seated-calf-raise"
  ],
  "fixed": {
    "mechanic": "isolation",
    "pattern": null,
