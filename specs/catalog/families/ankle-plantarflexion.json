    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "isolatedJointMotion"
      ],
      "description": "Whether ankle plantarflexion alone creates the repetition rather than propulsion from the hip or knee."
    },
    {
      "id": "handSupport",
      "valueType": "enum",
      "required": false,
