    },
    {
      "id": "hipMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "positionHeld"
      ],
      "description": "Whether hip position remains held rather than contributing a dynamic hip action."
    },
    {
      "id": "kneeMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "positionHeld"
      ],
      "description": "Whether knee angle remains held rather than contributing flexion or extension."
    },
    {
      "id": "kneeFlexionDegrees",
      "valueType": "number",
      "required": true,
      "minimum": 0,
      "maximum": 90,
      "description": "Held knee flexion; only the rule-pinned 0- and 90-degree research fixtures are admitted."
    },
    {
      "id": "ankleMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "plantarflexes"
      ],
      "description": "The dynamic ankle motion that raises the heel in the concentric repetition."
