      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "neutral",
        "sourceUnreported"
      ],
      "description": "The directly instructed neutral foot orientation; toe-in and toe-out are not admitted."
    },
    {
      "id": "movingSegment",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "foot"
      ],
      "description": "The segment whose ankle-relative motion defines the repetition."
