{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "ankle-plantarflexion",
  "name": "Ankle Plantarflexion",
  "definition": "A strict closed-chain calf raise in which one heel or both heels rise through ankle plantarflexion while the forefoot remains supported and the knee, hip, pelvis, and spine remain held. The roster contains unilateral and simultaneous bilateral machine fixtures plus one exact single-leg bodyweight fixture with an extended knee, light wall contact for balance only, and at least five centimeters of heel rise. Soleus is primary in both postures; gastrocnemius is primary with the knee extended and secondary with the knee flexed. The added bilateral fixtures are a standing two-dumbbell calf raise on a stable step and a back-supported leg-press calf raise with held extended knees. Smith, donkey, wall-unloaded bodyweight, jumping, partial-range, and toe-flexion variants remain outside this family. Tibialis anterior is authored as an ankle/foot stabilizer on the wall-balanced single-leg bodyweight heel raise. This is a categorical anatomy-and-mechanics inference supported by measured activity in related protocols, not exact-fixture EMG or primary/secondary training emphasis. For the unsupported standing dumbbell fixture, hand and wrist control plus held spine, pelvis, and hip positions support categorical stabilizer assignments by anatomical capability and external-load geometry; these are not exact-fixture EMG measurements.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "cybex-2008-plate-loaded-manual",
    "hammer-strength-2025-select-manual",
    "kinoshita-2023-standing-seated-calf-raise",
    "flanagan-2005-heel-raise-biomechanics",
    "manago-2021-single-leg-heel-raise",
    "sara-2021-single-leg-heel-raise",
    "nsca-2012-developing-endurance",
    "nasm-2026-leg-press-calf-raise",
    "holzbaur-2005-upper-extremity",
    "christophy-2012-lumbar-spine",
    "di-domizio-2008-handgrip-wrist-stabilization"
  ],
