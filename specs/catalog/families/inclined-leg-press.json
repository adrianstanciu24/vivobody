      "execution": {
        "startingPosition": "Sit reclined with your back and pelvis on the PL688 pads, hold the handles, and place both feet at medium plate height, hip-width apart and straight ahead.",
        "movement": "Lower the sled continuously for two seconds until the knees reach approximately ninety degrees of flexion.",
        "endpoint": "Reach the reviewed depth while keeping both whole feet and the supported pelvis in contact.",
        "returnPhase": "Press for two seconds to full knee extension without forcefully hyperextending the knees.",
        "controlledJoints": "Keep the knees tracking with the feet and do not rotate or lift either foot.",
        "supportAndPosture": "Keep your back and pelvis against the pads and both hands on the handles.",
        "disqualifyingCompensations": [
          "Lifting a foot or the pelvis removes the reviewed machine contact.",
          "Bouncing at the bottom or abbreviating the depth changes the reviewed range and cadence."
        ]
      }
