        "startingPosition": "Lie face down on a bench with one dumbbell in each hand, your palms facing inward, and your elbows held in a fixed slight bend.",
        "movement": "Sweep your upper arms out at shoulder height.",
        "endpoint": "Stop when your upper arms line up with your torso.",
        "returnPhase": "Lower under control without rowing, bending the elbows, or rotating the shoulders.",
        "controlledJoints": "Keep your elbows in a fixed slight bend and your shoulder blades controlled instead of deliberately pinching them together.",
        "supportAndPosture": "Support your torso on the bench throughout the movement.",
        "disqualifyingCompensations": [
          "Rowing the dumbbells toward the torso turns the reverse fly into a row.",
          "Pinching the shoulder blades together turns the reverse fly into a shoulder-blade squeeze."
        ]
      }
