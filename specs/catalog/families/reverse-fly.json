        "triceps",
        "fingerFlexors",
        "extensorCarpiRadialis",
        "abs",
        "obliques",
        "lumbarExtensors"
      ]
    }
  },
  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether the distal segment moves freely or remains fixed.",
      "allowedValues": [
        "open"
      ]
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "description": "Whether lower-body motion materially contributes to producing the repetition.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed body position used for the reverse fly.",
      "allowedValues": [
        "prone",
        "standing",
        "seated"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "The external surface directly supporting the anterior torso.",
      "allowedValues": [
        "bench",
        "none",
        "machinePad"
      ]
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "description": "Whether external support pins posterior scapular translation; anterior bench or machine-pad support does not do so.",
      "allowedValues": [
        "free"
      ]
    },
    {
      "id": "scapularStrategy",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed technique keeps the scapulae controlled without making retraction the prime action.",
      "allowedValues": [
        "neutralControlled"
      ]
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "The canonical forearm and hand orientation through the working range.",
      "allowedValues": [
        "neutral",
        "pronated"
      ]
    },
    {
      "id": "elbowMotion",
      "valueType": "enum",
      "required": true,
      "description": "Whether elbow angle intentionally changes during the repetition.",
      "allowedValues": [
        "angleHeld"
      ]
    },
    {
      "id": "elbowPosture",
      "valueType": "enum",
      "required": true,
      "description": "The maintained elbow posture through the working range.",
      "allowedValues": [
        "nearExtended"
      ]
    },
    {
      "id": "upperArmPath",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed upper-arm path relative to the torso.",
      "allowedValues": [
        "flared"
      ]
    },
    {
      "id": "upperArmElevationDegrees",
      "valueType": "number",
      "required": true,
      "description": "The reviewed upper-arm elevation relative to the torso; this is a setup descriptor, not an added abduction action.",
      "minimum": 90,
      "maximum": 90
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "description": "Whether rails or a lever constrain the external load path."
    },
    {
      "id": "machineType",
      "valueType": "enum",
      "required": false,
      "description": "The machine mechanism when equipment is machine.",
      "allowedValues": [
        "reverseFly"
      ]
    }
  ],
  "recommended": {
    "defaultReps": {
      "minimum": 10,
      "maximum": 20
    }
  },
  "exerciseRules": [
    {
      "id": "machine-requires-seated-pad-and-fixed-path",
      "description": "The reverse-fly machine is seated against its anterior pad, uses comparable external load, follows a constrained lever path, and declares its mechanism.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "machine"
      },
      "then": [
        {
          "field": "loadMode",
          "value": "external"
        },
        {
          "field": "variant.bodyPosition",
          "value": "seated"
        },
        {
          "field": "variant.torsoSupport",
          "value": "machinePad"
        },
        {
          "field": "variant.fixedPath",
          "value": true
        },
        {
          "field": "variant.machineType",
          "value": "reverseFly"
        }
      ],
      "requirePresent": [
        "variant.machineType"
      ],
      "requireAbsent": []
    },
    {
      "id": "non-machine-requires-free-path",
      "description": "Dumbbell and band reverse flies use unconstrained load paths and do not declare a machine mechanism.",
      "when": {
        "field": "equipment",
        "operator": "notEquals",
        "value": "machine"
      },
      "then": [
        {
          "field": "variant.fixedPath",
          "value": false
        }
      ],
      "requirePresent": [],
      "requireAbsent": [
        "variant.machineType"
      ]
    },
    {
      "id": "dumbbell-reverse-fly-uses-prone-supported-setup",
      "description": "The reviewed dumbbell reverse fly is prone on a bench with a neutral grip and comparable external load.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "dumbbell"
      },
      "then": [
        {
          "field": "loadMode",
          "value": "external"
        },
        {
          "field": "variant.bodyPosition",
          "value": "prone"
        },
        {
          "field": "variant.torsoSupport",
          "value": "bench"
        },
        {
          "field": "variant.gripOrientation",
          "value": "neutral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "band-reverse-fly-uses-standing-free-load-semantics",
      "description": "The reviewed band reverse fly is standing and unsupported with a neutral grip, uses non-comparable resistance, and explicitly declares spinal stabilization.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "band"
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "value": "standing"
        },
        {
          "field": "variant.torsoSupport",
          "value": "none"
        },
        {
          "field": "variant.gripOrientation",
          "value": "neutral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireMuscleRequirements": [
        {
          "anyOf": [
            "abs",
            "obliques",
            "lumbarExtensors"
          ],
          "minimumRole": "stabilizer"
        }
      ],
      "requireAdditionalStabilityDemands": [
        "spine"
      ]
    }
  ],
