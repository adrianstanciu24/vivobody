{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "reverse-fly",
  "name": "Reverse Fly",
  "definition": "An open-chain shoulder-isolation movement whose concentric phase horizontally abducts the upper arms at shoulder height with a fixed, nearly extended elbow posture and no deliberate scapular-retraction prime action. The admitted roster is limited to directly reviewed dumbbell, elastic-band, and reverse-fly-machine variants; cable, suspension, bodyweight, rowing, external-rotation, and bent-arm variants remain outside this contract.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "holzbaur-2005-upper-extremity",
    "bergquist-2018-band-free-weight-fly",
    "schoenfeld-2013-reverse-fly-hand-position"
  ],
  "fixed": {
    "mechanic": "isolation",
    "pattern": null,
    "direction": null,
    "planes": [
      "transverse"
    ]
  },
  "groupPolicy": {
    "default": "shoulders",
    "allowed": [
      "shoulders"
    ]
  },
  "allowed": {
    "equipment": [
      "dumbbell",
      "band",
      "machine"
    ],
    "modalities": [
      "dynamicStrength"
    ],
    "trackingModes": [
      "reps"
    ],
    "loadModes": [
      "external",
      "nonComparable"
    ],
    "lateralities": [
      "bilateral"
    ]
  },
  "movementSignature": {
    "planeBasisActions": [
      "shoulder.horizontalAbduction"
    ],
    "primeActions": [
      "shoulder.horizontalAbduction"
    ],
    "forbiddenPrimeActions": [
      "shoulder.flexion",
      "shoulder.extension",
      "shoulder.abduction",
      "shoulder.adduction",
      "shoulder.horizontalAdduction",
      "shoulder.internalRotation",
      "shoulder.externalRotation",
      "elbow.flexion",
      "elbow.extension",
      "scapula.elevation",
      "scapula.depression",
      "scapula.protraction",
      "scapula.retraction",
      "scapula.upwardRotation",
      "scapula.downwardRotation",
      "scapula.anteriorTilt",
      "scapula.posteriorTilt",
      "spine.flexion",
      "spine.extension",
      "spine.lateralFlexion",
      "spine.rotation",
      "hip.extension",
      "knee.extension",
      "ankle.plantarflexion"
    ],
    "stabilityDemands": [
      "shoulder",
      "scapula",
      "elbow",
      "wrist",
      "hand"
    ]
  },
  "musclePolicy": {
    "requirements": [
      {
        "anyOf": [
          "deltoidPosterior"
        ],
        "minimumRole": "primary"
      },
      {
        "anyOf": [
          "externalRotators"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "trapeziusMiddle",
          "rhomboids"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "brachialis"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "fingerFlexors"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "extensorCarpiRadialis"
        ],
        "minimumRole": "stabilizer"
      }
    ],
    "allowedByRole": {
      "primary": [
        "deltoidPosterior"
      ],
      "secondary": [
        "externalRotators"
      ],
      "stabilizer": [
        "deltoidLateral",
        "lats",
        "trapeziusUpper",
        "trapeziusMiddle",
        "trapeziusLower",
        "rhomboids",
        "serratus",
        "subscapularis",
