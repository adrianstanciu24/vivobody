{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "reverse-fly",
  "name": "Reverse Fly",
  "definition": "An open-chain shoulder-isolation movement whose concentric phase horizontally abducts the upper arms at shoulder height with a fixed, nearly extended elbow posture and no deliberate scapular-retraction prime action. The admitted roster is limited to directly reviewed prone and unsupported hip-hinged dumbbell, elastic-band, standing crossed-cable, and reverse-fly-machine variants; suspension, bodyweight, rowing, external-rotation, and bent-arm variants remain outside this contract. Cable and hip-hinged records use exact fixture rules; role assignments transfer categorical anatomy and mechanics rather than exercise-specific EMG rankings.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "holzbaur-2005-upper-extremity",
    "bergquist-2018-band-free-weight-fly",
    "schoenfeld-2013-reverse-fly-hand-position"
  ],
  "fixed": {
    "mechanic": "isolation",
    "trainingRole": "pull",
    "pattern": null,
    "direction": null,
    "planes": [
      "transverse"
    ]
  },
  "groupPolicy": {
    "default": "shoulders",
    "allowed": [
      "shoulders"
    ]
  },
  "allowed": {
    "equipment": ["dumbbell", "band", "machine", "cable"],
    "modalities": [
      "dynamicStrength"
    ],
    "trackingModes": [
      "reps"
    ],
    "loadModes": [
      "external",
      "nonComparable"
    ],
    "lateralities": [
      "bilateral"
    ]
  },
  "movementSignature": {
    "planeBasisActions": [
      "shoulder.horizontalAbduction"
    ],
    "primeActions": [
      "shoulder.horizontalAbduction"
    ],
    "forbiddenPrimeActions": [
      "shoulder.flexion",
      "shoulder.extension",
      "shoulder.abduction",
      "shoulder.adduction",
      "shoulder.horizontalAdduction",
      "shoulder.internalRotation",
      "shoulder.externalRotation",
      "elbow.flexion",
      "elbow.extension",
      "scapula.elevation",
      "scapula.depression",
      "scapula.protraction",
      "scapula.retraction",
      "scapula.upwardRotation",
      "scapula.downwardRotation",
      "scapula.anteriorTilt",
      "scapula.posteriorTilt",
      "spine.flexion",
      "spine.extension",
      "spine.lateralFlexion",
      "spine.rotation",
      "hip.extension",
      "knee.extension",
      "ankle.plantarflexion"
    ],
    "stabilityDemands": [
      "shoulder",
      "scapula",
      "elbow",
      "wrist",
      "hand"
    ]
  },
  "musclePolicy": {
    "requirements": [
      {
        "anyOf": [
          "deltoidPosterior"
        ],
        "minimumRole": "primary"
      },
      {
        "anyOf": [
          "externalRotators"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "trapeziusMiddle",
          "rhomboids"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "brachialis"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "fingerFlexors"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "extensorCarpiRadialis"
        ],
        "minimumRole": "stabilizer"
      }
    ],
    "allowedByRole": {
      "primary": [
        "deltoidPosterior"
      ],
      "secondary": [
        "externalRotators"
      ],
      "stabilizer": ["deltoidLateral", "lats", "trapeziusUpper", "trapeziusMiddle", "trapeziusLower", "rhomboids", "serratus", "subscapularis", "supraspinatus", "brachialis", "triceps", "fingerFlexors", "extensorCarpiRadialis", "abs", "obliques", "lumbarExtensors", "gluteMax"]
    }
  },
  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether the distal segment moves freely or remains fixed.",
      "allowedValues": [
        "open"
      ]
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "description": "Whether lower-body motion materially contributes to producing the repetition.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed body position used for the reverse fly.",
      "allowedValues": ["prone", "standing", "seated", "hipHinged"]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "The external surface directly supporting the anterior torso.",
      "allowedValues": [
        "bench",
        "none",
        "machinePad"
      ]
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "description": "Whether external support pins posterior scapular translation; anterior bench or machine-pad support does not do so.",
      "allowedValues": [
        "free"
      ]
    },
    {
      "id": "scapularStrategy",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed technique keeps the scapulae controlled without making retraction the prime action.",
      "allowedValues": [
        "neutralControlled"
      ]
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "The canonical forearm and hand orientation through the working range.",
      "allowedValues": [
        "neutral",
        "pronated"
      ]
    },
    {
      "id": "elbowMotion",
      "valueType": "enum",
      "required": true,
      "description": "Whether elbow angle intentionally changes during the repetition.",
      "allowedValues": [
        "angleHeld"
      ]
    },
    {
      "id": "elbowPosture",
      "valueType": "enum",
      "required": true,
      "description": "The maintained elbow posture through the working range.",
      "allowedValues": [
        "nearExtended"
      ]
    },
    {
      "id": "upperArmPath",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed upper-arm path relative to the torso.",
      "allowedValues": [
        "flared"
      ]
    },
    {
      "id": "upperArmElevationDegrees",
      "valueType": "number",
      "required": true,
      "description": "The reviewed upper-arm elevation relative to the torso; this is a setup descriptor, not an added abduction action.",
      "minimum": 90,
      "maximum": 90
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "description": "Whether rails or a lever constrain the external load path."
    },
    {
      "id": "machineType",
      "valueType": "enum",
      "required": false,
      "description": "The machine mechanism when equipment is machine.",
      "allowedValues": [
        "reverseFly"
      ]
    },
    {
      "id": "flyFixture",
      "valueType": "enum",
      "required": false,
      "description": "Exact newly reviewed cable or unsupported dumbbell topology.",
      "allowedValues": [
        "standingCrossedCable",
        "unsupportedHipHingedDumbbell"
      ]
    },
    {
      "id": "loadAccounting",
      "valueType": "enum",
      "required": false,
      "description": "Enter one matched stack on the same cable fixture, or one dumbbell from the matching pair.",
      "allowedValues": [
        "perStack",
        "perImplement"
      ]
    },
    {
      "id": "cableAnchorHeight",
      "valueType": "enum",
      "required": false,
      "description": "Pulley setting that keeps the crossed handles at shoulder height.",
      "allowedValues": [
        "midToHigh"
      ]
    },
    {
      "id": "handleConfiguration",
      "valueType": "enum",
      "required": false,
      "description": "Each hand holds the opposite tower handle.",
      "allowedValues": [
        "oppositeCrossedHandles"
      ]
    },
    {
      "id": "loadDistribution",
      "valueType": "enum",
      "required": false,
      "description": "Use the same displayed resistance on both towers.",
      "allowedValues": [
        "equalAcrossTwoTowers"
      ]
    }
  ],
  "recommended": {
    "defaultReps": {
      "minimum": 10,
      "maximum": 20
    }
  },
