      "execution": {
        "startingPosition": "Anchor one end of a barbell. Cup the loaded sleeve with both hands in front of the upper chest, elbows tucked, and stand hip-width apart. Log added plates only and compare on the same landmine setup.",
        "movement": "Keep the selected front foot planted, step the other foot back, and lower to a reverse lunge with the rear knee near the floor.",
        "endpoint": "Drive upward through the planted leg and raise the returning rear knee to about hip height while balancing on that front foot.",
        "returnPhase": "Lower the raised leg under control, then repeat the lunge.",
        "controlledJoints": "Keep the sleeve near the chest, trunk upright, and pelvis controlled as the bar follows its anchored arc.",
        "supportAndPosture": "Keep the selected front foot planted throughout the lunge and knee drive; no hand or torso support.",
        "disqualifyingCompensations": [
          "Stopping at two-foot standing without the knee drive omits the defining phase.",
          "Holding the bar in an elbow crease or overhead changes the reviewed setup."
        ],
        "sideOrDirection": "Complete the set with one planted working leg, then mirror the setup for the other side."
      }
