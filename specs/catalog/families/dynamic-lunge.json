      ],
      "description": "Log one dumbbell's weight rather than the combined pair."
    },
    {
      "id": "externalLoadPrescription",
      "valueType": "enum",
      "required": false,
      "allowedValues": [
        "twelvePointFiveToFiftyPercentBodyMassTotal",
        "tenKilogramsPerDumbbellStudyLoad"
      ],
      "description": "Riemann tested total external loads from 12.5% through 50% of body mass; Gao used one fixed 10-kilogram dumbbell per hand. Both values are evidence context, not user prescriptions."
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": false,
      "description": "Whether the external load path is constrained; all reviewed lunge implements here move freely."
    },
    {
      "id": "cadenceProtocol",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "loweringAttemptedWithinTwoSecondsConcentricUnreported",
        "participantAverageRecordedNoUniversalSeconds"
      ],
      "description": "The exact study timing: Comfort standardized both phases; Riemann limited the lowering attempt to two seconds; Gao recorded each participant's average trial duration without publishing a universal phase duration."
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "compoundHipKneeAnkleExtension"
      ],
      "description": "The selected lead limb uses the three authored extension actions during the concentric phase."
    }
  ],
  "recommended": {
