{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "dynamic-lunge",
  "name": "Dynamic Lunge",
  "definition": "A bodyweight unilateral-emphasis compound repetition that begins in upright bilateral standing, transitions into an asymmetric sagittal lunge, and returns to the same bilateral start. The active roster owns Comfort et al.'s exact forward and reverse step-and-return fixtures. In the forward record, the selected lead foot steps onto a second force plate, lands, remains fully planted through self-selected depth, and steps back to the start. In the reverse record, the selected front foot remains planted while the contralateral foot steps backward, lands, and returns forward. Both use a three-second eccentric phase, a two-second concentric phase, crossed upper limbs, and lead-side hip extension, knee extension, and ankle plantarflexion during the ascent. The records credit the same conservative regional role envelope because the study measured lead-limb joint kinematics, kinetics, and ground-reaction forces rather than individual-muscle activity. Stationary split squats, walking or alternating lunges, external loads, fixed stride lengths, lateral or crossover paths, jumps, and continuous locomotion remain outside this contract.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "comfort-2015-forward-reverse-lunge-kinetics"
  ],
  "fixed": {
    "mechanic": "compound",
    "pattern": "lunge",
    "direction": null,
    "planes": [
      "sagittal"
    ]
  },
