{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "dynamic-lunge",
  "name": "Dynamic Lunge",
  "definition": "A unilateral-emphasis compound repetition that begins in upright bilateral standing, steps into an asymmetric sagittal lunge, and returns to the same bilateral start. The roster owns Comfort et al.'s exact bodyweight forward and reverse fixtures, Riemann et al.'s externally loaded forward fixture, and Gao et al.'s paired-dumbbell reverse fixture. The loaded records use a 70%-leg-length step and side-held equal implements but preserve their different source depth, cadence, foot-contact, and implement contracts. The product records one dumbbell rather than the pair total; no study load becomes a universal prescription. The studies measure lower-limb mechanics and selected muscle activity without establishing a universal cross-muscle ranking, so every record retains a conservative regional role envelope. Stationary split squats, walking or alternating lunges, lateral or crossover paths, jumps, and continuous locomotion remain outside this contract.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "comfort-2015-forward-reverse-lunge-kinetics",
    "riemann-2012-anterior-lunge-external-load",
    "gao-2025-dumbbell-reverse-lunge"
  ],
  "fixed": {
    "mechanic": "compound",
    "trainingRole": "legs",
    "pattern": "lunge",
    "direction": null,
    "planes": [
      "sagittal"
    ]
  },
  "groupPolicy": {
    "default": "legs",
    "allowed": [
      "legs"
    ]
  },
  "allowed": {
    "equipment": [
      "bodyweight",
      "dumbbell"
    ],
    "modalities": [
      "dynamicStrength"
    ],
    "trackingModes": [
      "reps"
    ],
    "loadModes": [
      "nonComparable",
      "external"
    ],
    "lateralities": [
      "unilateral"
    ]
  },
  "movementSignature": {
    "planeBasisActions": [
      "hip.extension"
    ],
    "primeActions": [
      "hip.extension",
      "knee.extension",
      "ankle.plantarflexion"
    ],
    "forbiddenPrimeActions": [
      "scapula.elevation",
      "scapula.depression",
      "scapula.protraction",
      "scapula.retraction",
      "scapula.upwardRotation",
      "scapula.downwardRotation",
      "scapula.anteriorTilt",
      "scapula.posteriorTilt",
      "shoulder.flexion",
      "shoulder.extension",
      "shoulder.abduction",
      "shoulder.adduction",
      "shoulder.horizontalAdduction",
      "shoulder.horizontalAbduction",
      "shoulder.internalRotation",
      "shoulder.externalRotation",
      "elbow.flexion",
      "elbow.extension",
      "forearm.pronation",
      "forearm.supination",
      "wrist.flexion",
      "wrist.extension",
      "wrist.radialDeviation",
      "wrist.ulnarDeviation",
      "hand.fingerFlexion",
      "hand.fingerExtension",
      "spine.flexion",
      "spine.extension",
      "spine.lateralFlexion",
      "spine.rotation",
      "hip.flexion",
      "hip.abduction",
      "hip.adduction",
      "hip.internalRotation",
      "hip.externalRotation",
      "knee.flexion",
      "ankle.dorsiflexion",
      "ankle.inversion",
      "ankle.eversion",
      "foot.toeFlexion",
      "foot.toeExtension"
    ],
    "stabilityDemands": [
      "spine",
      "pelvis",
      "hip",
      "knee",
      "ankle",
      "foot"
    ]
  },
  "musclePolicy": {
    "requirements": [
      {
        "anyOf": [
          "vasti"
        ],
        "minimumRole": "primary"
      },
      {
        "anyOf": [
          "gluteMax"
        ],
        "minimumRole": "primary"
      },
      {
        "anyOf": [
          "rectusFemoris"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "gastrocnemius"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "soleus"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "medialHamstrings"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "bicepsFemoris"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "gluteMed"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "abs"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "obliques"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "lumbarExtensors"
        ],
        "minimumRole": "stabilizer"
      }
    ],
    "allowedByRole": {
      "primary": [
        "vasti",
        "gluteMax"
      ],
      "secondary": [
        "rectusFemoris",
        "gastrocnemius",
        "soleus"
      ],
      "stabilizer": [
        "medialHamstrings",
        "bicepsFemoris",
        "gluteMed",
        "abs",
        "obliques",
        "lumbarExtensors",
        "externalRotators",
        "trapeziusUpper",
        "triceps",
        "fingerFlexors",
        "extensorCarpiRadialis"
      ]
    }
  },
  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "closedDuringLoadedPhase"
      ],
      "description": "The selected lead foot is fixed to the floor through the measured eccentric and concentric phases; its entry into that closed-chain phase is recorded separately by the foot-transition axes."
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "standing"
      ],
      "description": "The gross posture at the bilateral start and return."
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none"
      ],
      "description": "Whether an external surface supports the torso."
    },
    {
      "id": "trunkOrientation",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "upright"
      ],
      "description": "The source-prescribed gross upright posture; it is not a claim of measured zero lumbar excursion."
    },
    {
      "id": "upperLimbPosition",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "crossed",
        "armsAtSidesHoldingPairedImplements"
      ],
      "description": "The source-prescribed crossed-arm bodyweight setup or paired side-held implement setup."
    },
    {
      "id": "startSupport",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "bilateralStanding"
      ],
      "description": "Both active records start upright with both feet supporting the athlete before the step."
    },
    {
      "id": "stepDirection",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "selectedLeadForward",
        "contralateralRearward"
      ],
      "description": "Whether the selected lead foot steps forward or remains planted while the contralateral foot steps rearward."
    },
    {
      "id": "selectedLeadFootTransition",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "stepsForwardThenReturns",
        "remainsPlantedThroughout"
      ],
      "description": "The selected front limb's complete support transition in the reviewed forward and reverse fixtures."
    },
    {
      "id": "contralateralFootTransition",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "remainsAtStartThenReceivesReturn",
        "stepsRearwardThenReturns"
      ],
      "description": "The contralateral foot remains at the bilateral start during the forward step or supplies the rearward step in the reverse fixture."
    },
    {
      "id": "landingFoot",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "selectedLead",
        "contralateral"
      ],
      "description": "The foot whose contact with the second force plate starts the source-defined eccentric lunge phase."
    },
    {
      "id": "selectedLeadFootContact",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "stepsThenWholeFootMaintained",
        "maintainedOnStartPlate",
        "maintainedWithHeelGrounded",
        "sourceUnreportedAfterForwardStep"
      ],
      "description": "The selected lead foot either lands fully and remains in contact, stays planted on Comfort's first plate, stays planted with the heel grounded in Gao's reverse fixture, or preserves Riemann's unreported post-step contact detail."
    },
    {
      "id": "landingDemand",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "dynamicFootContact"
      ],
      "description": "Both fixtures include a source-defined foot-contact event and controlled eccentric phase before reversal."
    },
    {
      "id": "depthCriterion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "fullSelfSelectedDepth",
        "maximumComfortableDepth",
        "rearKneeApproachesFloorWithoutContact"
      ],
      "description": "The source endpoint is full self-selected depth, maximum comfortable depth, or Gao's rear knee approaching the floor without contact."
    },
    {
      "id": "returnTopology",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "returnToBilateralStart"
      ],
      "description": "The stepping foot returns so every repetition finishes in the same upright bilateral stance."
    },
    {
      "id": "spineMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "nonstandardized"
      ],
      "description": "The gross trunk was upright, but segmental spinal motion was not reported as fixed or measured as zero."
    },
    {
      "id": "pelvisMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "nonstandardized"
      ],
      "description": "Pelvic control is material to the unilateral task, but the source does not authorize a zero-motion claim."
    },
    {
      "id": "hipMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "extends"
      ],
      "description": "The selected lead hip returns from the measured flexed bottom through dynamic extension."
    },
    {
      "id": "kneeMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "extends"
      ],
      "description": "The selected lead knee returns from the measured flexed bottom through dynamic extension."
    },
    {
      "id": "ankleMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "plantarflexes"
      ],
      "description": "The selected lead ankle reverses its bottom-position dorsiflexion toward the standing angle during ascent."
    },
    {
      "id": "footMotion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "positionHeldDuringLoadedPhase"
      ],
      "description": "No deliberate toe motion, inversion, or eversion creates the loaded phase; whole-foot transitions are recorded separately."
    },
    {
      "id": "loadPlacement",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none",
        "pairedAtSides"
      ],
      "description": "The bodyweight fixtures use no implement; the loaded fixture holds one implement at each side."
    },
    {
      "id": "eccentricSeconds",
      "valueType": "number",
      "required": false,
      "minimum": 3,
      "maximum": 3,
      "description": "The standardized source cadence from foot contact to maximum lead-knee flexion."
    },
    {
      "id": "concentricSeconds",
      "valueType": "number",
      "required": false,
      "minimum": 2,
      "maximum": 2,
      "description": "The standardized source cadence from maximum lead-knee flexion to stepping-foot lift-off."
    },
    {
      "id": "stepLengthCriterion",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "sourceUnreported",
        "seventyPercentSelectedLeadLegLength",
        "seventyPercentAsisToMedialTibialCondyleLength"
      ],
      "description": "Step length is unreported, Riemann's 70% selected-lead-leg measure, or Gao's distinct 70% anterior-superior-iliac-spine to medial-tibial-condyle measure."
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "notApplicable",
        "neutral"
      ],
      "description": "The hand orientation for the paired load, or not applicable for bodyweight records."
    },
    {
      "id": "implementConfiguration",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "none",
        "pairedDumbbellLikeImplements",
        "pairedDumbbells"
      ],
      "description": "Riemann used purpose-built dumbbell-like tracking implements while Gao used a matched commercial dumbbell in each hand; the values remain distinct."
    },
    {
      "id": "loadAccounting",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "notApplicable",
        "perImplement"
      ],
      "description": "The entered external load is the weight of one dumbbell, not the combined pair."
    },
    {
      "id": "externalLoadPrescription",
      "valueType": "enum",
      "required": false,
      "allowedValues": [
        "twelvePointFiveToFiftyPercentBodyMassTotal",
        "tenKilogramsPerDumbbellStudyLoad"
      ],
      "description": "Riemann tested total external loads from 12.5% through 50% of body mass; Gao used one fixed 10-kilogram dumbbell per hand. Both values are evidence context, not user prescriptions."
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": false,
      "description": "The paired implements do not constrain the athlete to a guided path."
    },
    {
      "id": "cadenceProtocol",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "threeSecondEccentricTwoSecondConcentric",
        "loweringAttemptedWithinTwoSecondsConcentricUnreported",
        "participantAverageRecordedNoUniversalSeconds"
      ],
      "description": "The exact study timing: Comfort standardized both phases; Riemann limited the lowering attempt to two seconds; Gao recorded each participant's average trial duration without publishing a universal phase duration."
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "allowedValues": [
        "compoundHipKneeAnkleExtension"
      ],
      "description": "The selected lead limb uses the three authored extension actions during the concentric phase."
    }
  ],
  "recommended": {
    "defaultReps": {
      "minimum": 5,
      "maximum": 15
    }
  },
  "exerciseRules": [
    {
      "id": "forward-step-binds-selected-lead-landing-topology",
      "description": "A selected-lead forward step requires the exact lead-foot landing and return topology from Comfort et al.",
      "when": {
        "field": "variant.stepDirection",
        "operator": "equals",
        "value": "selectedLeadForward"
      },
      "then": [
        {
          "field": "variant.selectedLeadFootTransition",
          "value": "stepsForwardThenReturns"
        },
        {
          "field": "variant.contralateralFootTransition",
          "value": "remainsAtStartThenReceivesReturn"
        },
        {
          "field": "variant.landingFoot",
          "value": "selectedLead"
        },
        {
          "field": "variant.selectedLeadFootContact",
          "allowedValues": [
            "stepsThenWholeFootMaintained",
            "sourceUnreportedAfterForwardStep"
          ]
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "reverse-step-binds-planted-front-foot-topology",
      "description": "A contralateral rearward step requires the selected front foot to remain planted while the rear foot lands and returns.",
      "when": {
        "field": "variant.stepDirection",
        "operator": "equals",
        "value": "contralateralRearward"
      },
      "then": [
        {
          "field": "variant.selectedLeadFootTransition",
          "value": "remainsPlantedThroughout"
        },
        {
          "field": "variant.contralateralFootTransition",
          "value": "stepsRearwardThenReturns"
        },
        {
          "field": "variant.landingFoot",
          "value": "contralateral"
        },
        {
          "field": "variant.selectedLeadFootContact",
          "allowedValues": ["maintainedOnStartPlate", "maintainedWithHeelGrounded"]
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "paired-dumbbell-forward-lunge-fixture",
      "description": "The paired dumbbell-like implement branch preserves Riemann et al.'s forward step, 70% leg-length target, maximum comfortable depth, side-held neutral grip, total body-mass loading range, and per-implement product accounting.",
      "when": {
        "field": "variant.implementConfiguration",
        "operator": "equals",
        "value": "pairedDumbbellLikeImplements"
      },
      "then": [
        { "field": "equipment", "value": "dumbbell" },
        { "field": "laterality", "value": "unilateral" },
        { "field": "loadMode", "value": "external" },
        { "field": "variant.upperLimbPosition", "value": "armsAtSidesHoldingPairedImplements" },
        { "field": "variant.stepDirection", "value": "selectedLeadForward" },
        { "field": "variant.stepLengthCriterion", "value": "seventyPercentSelectedLeadLegLength" },
        { "field": "variant.selectedLeadFootContact", "value": "sourceUnreportedAfterForwardStep" },
        { "field": "variant.depthCriterion", "value": "maximumComfortableDepth" },
        { "field": "variant.loadPlacement", "value": "pairedAtSides" },
        { "field": "variant.gripOrientation", "value": "neutral" },
        { "field": "variant.loadAccounting", "value": "perImplement" },
        { "field": "variant.externalLoadPrescription", "value": "twelvePointFiveToFiftyPercentBodyMassTotal" },
        { "field": "variant.fixedPath", "value": false },
        { "field": "variant.cadenceProtocol", "value": "loweringAttemptedWithinTwoSecondsConcentricUnreported" }
      ],
      "requirePresent": [
        "variant.externalLoadPrescription",
        "variant.fixedPath"
      ],
      "requireAbsent": [
        "variant.eccentricSeconds",
        "variant.concentricSeconds"
      ],
      "requireInvolvement": [
        { "muscle": "fingerFlexors", "role": "stabilizer" },
        { "muscle": "extensorCarpiRadialis", "role": "stabilizer" }
      ],
      "requireAdditionalStabilityDemands": [
        "shoulder",
        "scapula",
        "elbow",
        "wrist",
        "hand"
      ]
    },
    {
      "id": "paired-dumbbell-reverse-lunge-fixture",
      "description": "The exact paired-dumbbell branch preserves Gao et al.'s reverse step, 70% leg-length target, grounded front heel, rear-knee near-floor endpoint, side-held neutral grip, study load, and per-implement product accounting.",
      "when": {
        "field": "variant.implementConfiguration",
        "operator": "equals",
        "value": "pairedDumbbells"
      },
      "then": [
        {"field": "equipment", "value": "dumbbell"},
        {"field": "laterality", "value": "unilateral"},
        {"field": "loadMode", "value": "external"},
        {"field": "variant.upperLimbPosition", "value": "armsAtSidesHoldingPairedImplements"},
        {"field": "variant.stepDirection", "value": "contralateralRearward"},
        {"field": "variant.stepLengthCriterion", "value": "seventyPercentAsisToMedialTibialCondyleLength"},
        {"field": "variant.selectedLeadFootContact", "value": "maintainedWithHeelGrounded"},
        {"field": "variant.depthCriterion", "value": "rearKneeApproachesFloorWithoutContact"},
        {"field": "variant.loadPlacement", "value": "pairedAtSides"},
        {"field": "variant.gripOrientation", "value": "neutral"},
        {"field": "variant.loadAccounting", "value": "perImplement"},
        {"field": "variant.externalLoadPrescription", "value": "tenKilogramsPerDumbbellStudyLoad"},
        {"field": "variant.fixedPath", "value": false},
        {"field": "variant.cadenceProtocol", "value": "participantAverageRecordedNoUniversalSeconds"}
      ],
      "requirePresent": ["variant.externalLoadPrescription", "variant.fixedPath"],
      "requireAbsent": ["variant.eccentricSeconds", "variant.concentricSeconds"],
      "requireInvolvement": [
        {"muscle": "fingerFlexors", "role": "stabilizer"},
        {"muscle": "extensorCarpiRadialis", "role": "stabilizer"}
      ],
      "requireAdditionalStabilityDemands": ["shoulder", "scapula", "elbow", "wrist", "hand"]
    },
    {
      "id": "no-implement-pins-bodyweight-fixture",
      "description": "The no-implement branch remains the bodyweight Comfort fixture with its exact cadence and no external-load fields.",
      "when": {"field": "variant.implementConfiguration", "operator": "equals", "value": "none"},
      "then": [
        {"field": "equipment", "value": "bodyweight"},
        {"field": "loadMode", "value": "nonComparable"},
        {"field": "variant.upperLimbPosition", "value": "crossed"},
        {"field": "variant.loadPlacement", "value": "none"},
        {"field": "variant.stepLengthCriterion", "value": "sourceUnreported"},
        {"field": "variant.gripOrientation", "value": "notApplicable"},
        {"field": "variant.loadAccounting", "value": "notApplicable"},
        {"field": "variant.cadenceProtocol", "value": "threeSecondEccentricTwoSecondConcentric"}
      ],
      "requirePresent": ["variant.eccentricSeconds", "variant.concentricSeconds"],
      "requireAbsent": ["variant.externalLoadPrescription", "variant.fixedPath"]
    },
    {
      "id": "whole-foot-contact-pins-bodyweight-forward-fixture",
      "description": "Comfort's whole-foot forward contact belongs only to the bodyweight forward fixture.",
      "when": {"field": "variant.selectedLeadFootContact", "operator": "equals", "value": "stepsThenWholeFootMaintained"},
      "then": [
        {"field": "equipment", "value": "bodyweight"},
        {"field": "variant.stepDirection", "value": "selectedLeadForward"},
        {"field": "variant.implementConfiguration", "value": "none"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "maintained-contact-pins-bodyweight-reverse-fixture",
      "description": "Comfort's continuously planted selected lead foot belongs only to the bodyweight reverse fixture.",
      "when": {"field": "variant.selectedLeadFootContact", "operator": "equals", "value": "maintainedOnStartPlate"},
      "then": [
        {"field": "equipment", "value": "bodyweight"},
        {"field": "variant.stepDirection", "value": "contralateralRearward"},
        {"field": "variant.implementConfiguration", "value": "none"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "grounded-heel-contact-pins-loaded-reverse-fixture",
      "description": "Gao's maintained front-heel contact belongs only to the paired-dumbbell reverse fixture.",
      "when": {"field": "variant.selectedLeadFootContact", "operator": "equals", "value": "maintainedWithHeelGrounded"},
      "then": [
        {"field": "equipment", "value": "dumbbell"},
        {"field": "variant.stepDirection", "value": "contralateralRearward"},
        {"field": "variant.implementConfiguration", "value": "pairedDumbbells"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "rear-knee-near-floor-depth-pins-loaded-reverse-fixture",
      "description": "The rear-knee near-floor endpoint without contact belongs only to Gao's paired-dumbbell reverse fixture.",
      "when": {"field": "variant.depthCriterion", "operator": "equals", "value": "rearKneeApproachesFloorWithoutContact"},
      "then": [
        {"field": "variant.stepDirection", "value": "contralateralRearward"},
        {"field": "variant.implementConfiguration", "value": "pairedDumbbells"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "unreported-contact-pins-loaded-forward-fixture",
      "description": "The source-unreported post-step contact belongs only to the loaded paired-implement forward fixture.",
      "when": {"field": "variant.selectedLeadFootContact", "operator": "equals", "value": "sourceUnreportedAfterForwardStep"},
      "then": [
        {"field": "equipment", "value": "dumbbell"},
        {"field": "variant.stepDirection", "value": "selectedLeadForward"},
        {"field": "variant.implementConfiguration", "value": "pairedDumbbellLikeImplements"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    }
  ],
  "exercises": [
    {
      "catalogID": "bodyweight-forward-lunge",
      "name": "Bodyweight Forward Lunge",
      "aliases": [
        "Forward Lunge"
      ],
      "equipment": "bodyweight",
      "laterality": "unilateral",
      "modality": "dynamicStrength",
      "trackingMode": "reps",
      "loadMode": "nonComparable",
      "bodyweightFraction": 0,
      "defaultWeight": 0,
      "reps": 5,
      "searchPriority": 88,
      "involvement": [
        { "muscle": "vasti", "role": "primary" },
        { "muscle": "gluteMax", "role": "primary" },
        { "muscle": "rectusFemoris", "role": "secondary" },
        { "muscle": "gastrocnemius", "role": "secondary" },
        { "muscle": "soleus", "role": "secondary" },
        { "muscle": "medialHamstrings", "role": "stabilizer" },
        { "muscle": "bicepsFemoris", "role": "stabilizer" },
        { "muscle": "gluteMed", "role": "stabilizer" },
