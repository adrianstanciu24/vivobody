{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "dynamic-lunge",
  "name": "Dynamic Lunge",
  "definition": "A unilateral-emphasis compound repetition that begins in upright bilateral standing, steps into an asymmetric sagittal lunge, and returns to the same bilateral start. The active roster owns Riemann et al.'s externally loaded forward fixture and Gao et al.'s paired-dumbbell reverse fixture. Both hold one equal dumbbell at each side and log one dumbbell rather than the pair total; their step, depth, cadence, and foot-contact instructions remain source-specific. No study load becomes a universal prescription. Lower-limb mechanics and selected muscle-activity evidence support conservative regional roles without a universal cross-muscle ranking. Tibialis anterior receives ankle and foot stabilizer credit in both discrete step-and-return fixtures; Gao measured its activity in the reverse fixture, while transfer to the forward fixture is a categorical anatomy-and-mechanics inference. TFL receives stabilizer credit for hip and pelvic alignment during stepping and stance. Bouillon and Selkowitz measured TFL in related bodyweight forward-lunge protocols; transfer to the active loaded fixtures is an explicit anatomy-and-mechanics inference, not a measured ranking or adaptation. Stationary split squats, walking lunges, lateral or crossover paths, jumps, and continuous locomotion remain outside this contract.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "comfort-2015-forward-reverse-lunge-kinetics",
    "riemann-2012-anterior-lunge-external-load",
    "gao-2025-dumbbell-reverse-lunge",
    "wu-2020-loading-devices-squat-lunge",
    "bouillon-2012-unilateral-weight-bearing-emg",
    "selkowitz-2013-gluteal-tfl-fine-wire-emg"
  ],
  "fixed": {
    "mechanic": "compound",
    "trainingRole": "legs",
    "pattern": "lunge",
    "direction": null,
    "planes": [
      "sagittal"
