        "trapeziusMiddle",
        "deltoidPosterior",
        "abs",
        "obliques",
        "lumbarExtensors"
      ]
    }
  },
  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether the distal segment moves freely or remains fixed.",
      "allowedValues": [
        "open"
      ]
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "description": "Whether the press is performed standing or seated.",
      "allowedValues": [
        "standing",
        "seated"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "The external surface directly supporting the torso during the press.",
      "allowedValues": [
        "none",
        "bench",
        "machinePad"
      ]
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "description": "Whether external posterior support limits scapular translation along the thorax; this does not classify scapular rotation or tilt.",
      "allowedValues": [
        "free",
        "supportConstrained"
      ]
    },
    {
      "id": "pressInclinationDegrees",
      "valueType": "number",
      "required": true,
      "description": "Signed inclination of the canonical torso-relative press from horizontal: positive toward overhead and negative toward decline; a supported free-weight press uses backrest angle as the proxy.",
      "minimum": 75,
      "maximum": 90
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "Canonical forearm and hand orientation through the working range.",
      "allowedValues": [
        "pronated",
        "neutral"
      ]
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "description": "Whether rails or a lever constrain the external load path."
    },
    {
      "id": "machineType",
      "valueType": "enum",
      "required": false,
      "description": "The machine mechanism when equipment is machine.",
      "allowedValues": [
        "smith",
        "convergingShoulderPress"
      ]
    },
    {
      "id": "kettlebellOrientation",
      "valueType": "enum",
      "required": false,
      "description": "The bell orientation used throughout a kettlebell press.",
      "allowedValues": [
        "standard"
      ]
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "description": "Whether hip, knee, or ankle drive contributes to the concentric press.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "pressPath",
      "valueType": "enum",
      "required": true,
      "description": "The canonical humeral and implement path relative to the head.",
      "allowedValues": [
        "frontScapular"
      ]
    }
  ],
  "recommended": {
    "defaultReps": {
      "minimum": 5,
      "maximum": 15
    }
  },
  "exerciseRules": [
    {
      "id": "machine-requires-fixed-path-and-type",
      "description": "Machine vertical presses use a constrained load path and declare the machine mechanism.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "machine"
      },
      "then": [
        {
          "field": "variant.fixedPath",
          "value": true
        }
      ],
      "requirePresent": [
        "variant.machineType"
      ],
      "requireAbsent": []
    },
    {
      "id": "non-machine-requires-free-path",
      "description": "Non-machine vertical presses are not constrained by machine rails or levers and do not declare a machine mechanism.",
      "when": {
        "field": "equipment",
        "operator": "notEquals",
        "value": "machine"
      },
      "then": [
        {
          "field": "variant.fixedPath",
          "value": false
        }
      ],
      "requirePresent": [],
      "requireAbsent": [
        "variant.machineType"
      ]
    },
    {
      "id": "kettlebell-requires-standard-orientation",
      "description": "A kettlebell vertical press uses a neutral grip and declares the standard bell-down orientation; bottom-up pressing remains outside this contract.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "kettlebell"
      },
      "then": [
        {
          "field": "variant.kettlebellOrientation",
          "value": "standard"
        },
        {
          "field": "variant.gripOrientation",
          "value": "neutral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "non-kettlebell-omits-bell-orientation",
      "description": "Only kettlebell presses declare a bell orientation.",
      "when": {
        "field": "equipment",
        "operator": "notEquals",
        "value": "kettlebell"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [
        "variant.kettlebellOrientation"
      ]
    },
    {
      "id": "unsupported-torso-is-upright-free-and-spine-stabilized",
      "description": "A press without posterior torso support is upright, permits free scapular translation, and explicitly declares spinal stabilization whether standing or seated.",
      "when": {
        "field": "variant.torsoSupport",
        "operator": "equals",
        "value": "none"
      },
      "then": [
        {
          "field": "variant.pressInclinationDegrees",
          "value": 90
        },
        {
          "field": "variant.scapularTranslation",
          "value": "free"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireAdditionalStabilityDemands": [
        "spine"
      ]
    },
    {
      "id": "supported-torso-is-seated-and-translation-constrained",
      "description": "A bench or machine pad requires a seated press and limits scapular translation without removing upward rotation or posterior tilt.",
      "when": {
        "field": "variant.torsoSupport",
        "operator": "notEquals",
        "value": "none"
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "value": "seated"
        },
        {
          "field": "variant.scapularTranslation",
          "value": "supportConstrained"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "standing-requires-unsupported-upright-pelvic-control",
      "description": "A strict standing press has no posterior torso support, stays at 90 degrees, and explicitly declares spinal and pelvic stabilization.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "equals",
        "value": "standing"
      },
      "then": [
        {
          "field": "variant.torsoSupport",
          "value": "none"
        },
        {
          "field": "variant.pressInclinationDegrees",
          "value": 90
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireAdditionalStabilityDemands": [
        "spine",
        "pelvis"
      ]
    },
    {
      "id": "unilateral-requires-trunk-and-pelvic-control",
      "description": "A unilateral press explicitly declares spinal and pelvic stability demands created by the asymmetric load.",
      "when": {
        "field": "laterality",
        "operator": "equals",
        "value": "unilateral"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [],
      "requireAdditionalStabilityDemands": [
        "spine",
        "pelvis"
      ]
    },
    {
      "id": "barbell-requires-pronated-grip",
      "description": "The currently admitted straight-bar vertical press uses a pronated grip; neutral specialty bars require a future contract review.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "barbell"
      },
      "then": [
        {
          "field": "variant.gripOrientation",
          "value": "pronated"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "barbell-requires-bilateral-setup",
      "description": "A standard straight-bar vertical press is bilateral; unilateral bar-like implements require a different equipment type and review.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "barbell"
      },
      "then": [
        {
          "field": "laterality",
          "value": "bilateral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "smith-requires-pronated-grip",
      "description": "A Smith vertical press uses a pronated grip beneath the rails but may be standing or seated.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "smith"
      },
      "then": [
        {
          "field": "variant.gripOrientation",
          "value": "pronated"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "smith-requires-bilateral-setup",
      "description": "The admitted Smith press uses both hands on the standard bar; an asymmetrically loaded one-arm rail press is outside this contract.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "smith"
      },
      "then": [
        {
          "field": "laterality",
          "value": "bilateral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "machine-pad-requires-purpose-built-machine",
      "description": "The machinePad support value belongs only to the purpose-built converging shoulder-press machine, not a free-weight or Smith bench setup.",
      "when": {
        "field": "variant.torsoSupport",
        "operator": "equals",
        "value": "machinePad"
      },
      "then": [
        {
          "field": "equipment",
          "value": "machine"
        },
        {
          "field": "variant.machineType",
          "value": "convergingShoulderPress"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "shoulder-press-machine-uses-pad",
      "description": "A converging shoulder-press machine is seated against its pad and uses its canonical neutral handles.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "convergingShoulderPress"
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "value": "seated"
        },
        {
          "field": "variant.torsoSupport",
          "value": "machinePad"
        },
        {
          "field": "variant.gripOrientation",
          "value": "neutral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    }
  ],
