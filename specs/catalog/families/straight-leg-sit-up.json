      "execution": {
        "startingPosition": "Lie on your back with both legs straight and together, feet unanchored, and arms crossed over the chest.",
        "movement": "Curl the trunk from the floor and continue smoothly at the hips until reaching upright sitting without swinging the arms.",
        "endpoint": "Finish upright with the legs still straight and the feet still unanchored.",
        "returnPhase": "Lower the torso to the floor under control, reversing the same path.",
        "controlledJoints": "Keep both knees straight and avoid twisting or using a sudden hip snap.",
        "supportAndPosture": "Keep the legs together and do not wedge the feet under an anchor.",
