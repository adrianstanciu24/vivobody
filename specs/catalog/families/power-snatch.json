      "additionalPrimeActions": [], "additionalStabilityDemands": [],
      "evidenceRefs": ["ackland-2008-shoulder-moment-arms", "arnold-2010-lower-limb", "holzbaur-2005-upper-extremity", "lee-2018-power-snatch-kinetics", "ronai-2017-power-snatch-technique", "seth-2019-shoulder-work"],
      "execution": {
        "startingPosition": "Log the total bar plus plates. Set the bar on the floor close to the shins and take a wide overhand snatch grip.",
        "movement": "Lift the bar from the floor, accelerate through the second pull, extend the hips, knees, and ankles, then pull under as the bar travels overhead.",
        "endpoint": "Receive the bar overhead with fully straight elbows and the hip crease above the knees.",
        "returnPhase": "Stand fully from the catch, then lower the bar under control to the floor.",
        "controlledJoints": "Keep the bar close and control hip, knee, and ankle flexion in the receive.",
        "supportAndPosture": "Brace the trunk and keep the wide two-hand grip secure throughout.",
        "disqualifyingCompensations": ["Starting from the hang changes the exercise into a hang power snatch.", "Receiving below power depth changes the exercise into a full snatch.", "Stopping without an overhead catch changes the repetition into a snatch pull."]
