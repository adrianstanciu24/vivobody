      "execution": {
        "startingPosition": "Sit at the edge of a flat bench with your lower body on the bench and a partner holding your legs securely. Cross your arms over your chest and keep your head and trunk neutral.",
        "movement": "Lean the straight trunk back until it is about 45 degrees to the bench, then stop moving.",
        "endpoint": "Hold the 45-degree position for the set time without changing the trunk angle.",
        "controlledJoints": "Keep the spine, pelvis, and hips still throughout the hold.",
        "supportAndPosture": "Keep the lower body anchored on the bench and the unsupported torso in one neutral line.",
        "disqualifyingCompensations": [
          "Rounding or extending the lower back leaves the strict neutral-trunk hold.",
          "Rising toward upright or dropping below the 45-degree position changes the prescribed fixture.",
          "Using the arms or hands to support the torso changes the exercise."
        ]
      }
