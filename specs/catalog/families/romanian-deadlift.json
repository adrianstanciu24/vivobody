      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "continuous-support-requires-top-start-range",
      "description": "No inter-repetition support is admitted only for the reviewed top-start continuous branch.",
      "when": {
        "field": "variant.interRepSupport",
        "operator": "equals",
        "value": "noneContinuous"
      },
      "then": [
        {
          "field": "variant.rangeOfMotion",
          "allowedValues": [
            "topStartToMidShinWithoutFloorContact"
          ]
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "floor-contact-support-preserves-reviewed-protocol",
