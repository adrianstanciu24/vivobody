        {
          "field": "equipment",
          "value": "barbell"
        },
        {
          "field": "variant.externalLoadPrescription",
          "value": "eightyPercentVariantSpecificOneRepMaximum"
        },
        {
          "field": "variant.tempo",
          "value": "twoSecondsEachPhaseWithHalfSecondIsometric"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    }
  ],
