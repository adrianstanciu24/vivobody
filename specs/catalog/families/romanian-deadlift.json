      "execution": {
        "startingPosition": "Stand with your feet hip-distance apart on the floor in front of a free barbell. Keep your knees extended, hinge forward with a straight back, grip the bar with both hands shoulder-width apart, and draw your shoulders back and down.",
        "movement": "Lift the bar from the floor over two seconds by extending your hips while keeping your knees extended.",
        "endpoint": "Stand upright with your hips fully extended, your knees still extended, and the bar held in front of your body.",
        "returnPhase": "Hinge forward and lower the bar for two seconds until the plates touch the floor beside your feet, keeping your knees extended and your back straight. The source did not prescribe a floor pause, reset, or complete unloading.",
        "controlledJoints": "Keep both knees extended throughout the repetition without adding a squat-like bend.",
        "supportAndPosture": "Keep both feet planted, brace your trunk, maintain the instructed straight-back posture, and use no external torso support.",
        "disqualifyingCompensations": [
          "Adding a slight knee bend turns the movement into a Romanian deadlift.",
          "Bending the knees deeply turns the hinge into a squat-like conventional floor pull.",
          "Stopping the plates above the floor turns the reviewed floor-touch fixture into a partial stiff-leg deadlift."
        ]
      }
    },
