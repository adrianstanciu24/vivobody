  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Both feet remain fixed while the pelvis and torso move relative to the planted lower limbs.",
      "allowedValues": [
        "closed"
      ]
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "description": "The gross posture at the upright endpoint of every reviewed fixture.",
      "allowedValues": [
        "standing"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "No bench, pad, or other external surface supports the torso during the hinge.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "stanceConfiguration",
      "valueType": "enum",
      "required": true,
      "description": "Both reviewed feet share a symmetric bilateral stance.",
      "allowedValues": [
        "symmetricBilateral"
      ]
    },
    {
      "id": "stanceWidth",
      "valueType": "enum",
      "required": true,
      "description": "The source-authored stance width; research fixtures use hip distance while technique records preserve their separately reported stance.",
      "allowedValues": [
        "hipDistance"
      ]
    },
    {
      "id": "footOrientation",
      "valueType": "enum",
      "required": true,
      "description": "The study did not report or compare a toe-angle prescription.",
      "allowedValues": [
        "unreported"
      ]
    },
    {
      "id": "footContact",
      "valueType": "enum",
      "required": true,
      "description": "Both feet remain continuously planted on their reviewed support surface.",
      "allowedValues": [
        "continuous"
      ]
    },
    {
      "id": "supportSurface",
      "valueType": "enum",
      "required": true,
      "description": "The surface under both feet: the floor or the directly studied 15-centimeter step above it.",
      "allowedValues": [
        "floor",
        "fifteenCentimeterStep"
      ]
    },
    {
      "id": "platformHeightCm",
      "valueType": "number",
      "required": false,
      "description": "The vertical distance between the foot-support platform and the barbell floor; it exists only for the directly studied 15-centimeter step fixture.",
      "minimum": 15,
      "maximum": 15
    },
    {
      "id": "loadPlacement",
      "valueType": "enum",
      "required": true,
      "description": "The source-authored free-weight placement: a barbell in front of the body or one dumbbell beside each leg.",
      "allowedValues": [
        "handsInFrontOfBody",
        "pairedBesideLegs"
      ]
    },
    {
      "id": "gripWidth",
      "valueType": "enum",
      "required": true,
      "description": "The reported hand spacing when a shared bar is used; independent handles use an explicit not-applicable value.",
      "allowedValues": [
        "shoulderDistance",
        "notApplicableIndependentHandles"
      ]
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "The source-authored forearm orientation, including an explicit unreported value where the study did not specify it.",
      "allowedValues": [
        "unreported",
        "pronated",
        "neutral"
      ]
    },
    {
      "id": "shoulderPosition",
      "valueType": "enum",
      "required": true,
      "description": "The source instruction draws the shoulders back and down while the bar is held.",
      "allowedValues": [
        "drawnBackAndDown"
      ]
    },
    {
      "id": "externalLoadPrescription",
      "valueType": "enum",
      "required": true,
      "description": "The source-authored external-load prescription: variant-specific 80-percent one-repetition maximum in the research protocol or source-unspecified in technique records.",
      "allowedValues": [
        "eightyPercentVariantSpecificOneRepMaximum",
        "sourceUnspecified"
      ]
    },
    {
      "id": "hipMotion",
      "valueType": "enum",
      "required": true,
      "description": "Hip extension creates the concentric return to standing from the authored bottom position, whether floor-touching or continuous.",
      "allowedValues": [
        "extends"
      ]
    },
    {
      "id": "spineMotion",
      "valueType": "enum",
      "required": true,
      "description": "A straight spine was instructed, but the source collected no kinematics and cannot establish a literal held position or dynamic spinal action.",
      "allowedValues": [
        "straightPostureInstructedKinematicsUnmeasured"
      ]
    },
    {
      "id": "kneeTechnique",
      "valueType": "enum",
      "required": true,
      "description": "The source-authored knee technique: the research Romanian fixture moves from slight flexion toward extension, the stiff-leg fixture stays extended, and continuous technique records hold slight flexion.",
      "allowedValues": [
        "slightlyFlexedStartToExtendedEndpointKinematicsUnmeasured",
        "extendedThroughoutKinematicsUnmeasured",
        "slightlyFlexedHeld"
      ]
    },
    {
      "id": "rangeOfMotion",
      "valueType": "enum",
      "required": true,
      "description": "The source-exact implement range: floor-touching research paths or a continuous top-start path ending near mid-shin without floor contact.",
      "allowedValues": [
        "floorAtFootLevelToStanding",
        "floorFifteenCentimetersBelowFeetToStanding",
        "topStartToMidShinWithoutFloorContact"
      ]
    },
    {
      "id": "tempo",
      "valueType": "enum",
      "required": true,
      "description": "The source-authored tempo: measured two-second phases in the research protocol or controlled but otherwise unreported technique timing.",
      "allowedValues": [
        "twoSecondsEachPhaseWithHalfSecondIsometric",
        "controlledSourceUnreported"
      ]
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "fixedValue": false,
      "description": "No rail, lever, or other mechanism constrains the free-weight path."
    },
    {
      "id": "interRepSupport",
      "valueType": "enum",
      "required": true,
      "description": "Whether the implement contacts the floor without a prescribed reset or remains continuously unsupported by the floor between repetitions.",
      "allowedValues": [
        "floorContactNoSpecifiedReset",
        "noneContinuous"
      ]
    },
    {
      "id": "implementConfiguration",
      "valueType": "enum",
      "required": true,
      "description": "The source-exact free-weight configuration.",
      "allowedValues": ["straightBarbell", "pairedDumbbells"]
    },
    {
      "id": "loadAccounting",
      "valueType": "enum",
      "required": true,
      "description": "Barbell fixtures log total bar-and-plate load; paired dumbbells log one implement.",
      "allowedValues": ["totalBarAndPlates", "perImplement"]
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "description": "Hip extension defines the lift while the source-prescribed but unmeasured knee behavior remains nondefining.",
      "allowedValues": [
        "hipDominantHingeWithNondefiningKneeTechnique"
      ]
    }
  ],
  "recommended": {
    "defaultReps": {
      "minimum": 6,
      "maximum": 15
    }
  },
  "exerciseRules": [
    {
      "id": "step-surface-pins-reviewed-deficit",
      "description": "The only admitted raised-foot fixture uses the directly studied 15-centimeter step, below-foot floor range, and Romanian knee prescription.",
      "when": {
        "field": "variant.supportSurface",
        "operator": "equals",
        "value": "fifteenCentimeterStep"
      },
      "then": [
        {
          "field": "variant.platformHeightCm",
          "value": 15
        },
        {
          "field": "variant.rangeOfMotion",
          "value": "floorFifteenCentimetersBelowFeetToStanding"
        },
        {
          "field": "variant.kneeTechnique",
          "value": "slightlyFlexedStartToExtendedEndpointKinematicsUnmeasured"
        }
      ],
      "requirePresent": [
        "variant.platformHeightCm"
      ],
      "requireAbsent": []
    },
    {
      "id": "below-foot-range-requires-reviewed-step",
      "description": "A below-foot floor range is admitted only with the directly reviewed 15-centimeter step and Romanian knee prescription.",
      "when": {
        "field": "variant.rangeOfMotion",
        "operator": "equals",
        "value": "floorFifteenCentimetersBelowFeetToStanding"
      },
      "then": [
        {
          "field": "variant.supportSurface",
          "value": "fifteenCentimeterStep"
        },
        {
          "field": "variant.platformHeightCm",
          "value": 15
        },
        {
          "field": "variant.kneeTechnique",
          "value": "slightlyFlexedStartToExtendedEndpointKinematicsUnmeasured"
        }
      ],
      "requirePresent": [
        "variant.platformHeightCm"
      ],
      "requireAbsent": []
    },
    {
      "id": "floor-surface-pins-ground-level-range",
      "description": "Ground-level Romanian and stiff-leg fixtures use the same floor for the feet and plates and carry no platform-height field.",
      "when": {
        "field": "variant.supportSurface",
        "operator": "equals",
        "value": "floor"
      },
      "then": [
        {
          "field": "variant.rangeOfMotion",
          "allowedValues": [
            "floorAtFootLevelToStanding",
            "topStartToMidShinWithoutFloorContact"
          ]
        }
      ],
      "requirePresent": [],
      "requireAbsent": [
        "variant.platformHeightCm"
      ]
    },
    {
      "id": "ground-level-range-requires-floor-surface",
      "description": "A floor-at-foot-level range requires both feet on that floor and no platform-height field.",
      "when": {
        "field": "variant.rangeOfMotion",
        "operator": "equals",
        "value": "floorAtFootLevelToStanding"
      },
      "then": [
        {
          "field": "variant.supportSurface",
          "value": "floor"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [
        "variant.platformHeightCm"
      ]
    },
    {
      "id": "stiff-leg-technique-requires-ground-level-fixture",
      "description": "The only directly reviewed extended-knee-throughout fixture places both feet and the plates on the same floor.",
      "when": {
        "field": "variant.kneeTechnique",
        "operator": "equals",
        "value": "extendedThroughoutKinematicsUnmeasured"
      },
      "then": [
        {
          "field": "variant.supportSurface",
          "value": "floor"
        },
        {
          "field": "variant.rangeOfMotion",
          "value": "floorAtFootLevelToStanding"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [
        "variant.platformHeightCm"
      ]
    },
    {
      "id": "dumbbells-pin-continuous-paired-fixture",
      "description": "Dumbbells admit only the source-exact continuous paired implementation and per-implement load convention.",
      "when": {"field": "equipment", "operator": "equals", "value": "dumbbell"},
      "then": [
        {"field": "variant.supportSurface", "value": "floor"},
        {"field": "variant.loadPlacement", "value": "pairedBesideLegs"},
        {"field": "variant.gripWidth", "value": "notApplicableIndependentHandles"},
        {"field": "variant.gripOrientation", "value": "neutral"},
        {"field": "variant.externalLoadPrescription", "value": "sourceUnspecified"},
        {"field": "variant.kneeTechnique", "value": "slightlyFlexedHeld"},
        {"field": "variant.rangeOfMotion", "value": "topStartToMidShinWithoutFloorContact"},
        {"field": "variant.tempo", "value": "controlledSourceUnreported"},
        {"field": "variant.interRepSupport", "value": "noneContinuous"},
        {"field": "variant.implementConfiguration", "value": "pairedDumbbells"},
        {"field": "variant.loadAccounting", "value": "perImplement"}
      ],
      "requirePresent": [],
      "requireAbsent": ["variant.platformHeightCm"]
    },
    {
      "id": "barbell-pins-single-implement-accounting",
      "description": "Every barbell fixture records a single straight bar and total bar-and-plate load.",
      "when": {"field": "equipment", "operator": "equals", "value": "barbell"},
      "then": [
        {"field": "variant.implementConfiguration", "value": "straightBarbell"},
        {"field": "variant.loadAccounting", "value": "totalBarAndPlates"},
        {"field": "variant.loadPlacement", "value": "handsInFrontOfBody"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "continuous-range-pins-top-start-contract",
      "description": "The source-exact top-start range has no floor contact and uses the controlled unreported cadence.",
      "when": {"field": "variant.rangeOfMotion", "operator": "equals", "value": "topStartToMidShinWithoutFloorContact"},
      "then": [
        {"field": "variant.supportSurface", "value": "floor"},
        {"field": "variant.kneeTechnique", "value": "slightlyFlexedHeld"},
        {"field": "variant.externalLoadPrescription", "value": "sourceUnspecified"},
        {"field": "variant.tempo", "value": "controlledSourceUnreported"},
        {"field": "variant.interRepSupport", "value": "noneContinuous"}
      ],
      "requirePresent": [],
      "requireAbsent": ["variant.platformHeightCm"]
    },
    {
      "id": "continuous-support-requires-top-start-range",
      "description": "No inter-repetition support is admitted only for the reviewed top-start continuous branch.",
      "when": {"field": "variant.interRepSupport", "operator": "equals", "value": "noneContinuous"},
      "then": [{"field": "variant.rangeOfMotion", "value": "topStartToMidShinWithoutFloorContact"}],
      "requirePresent": [],
      "requireAbsent": ["variant.platformHeightCm"]
    },
    {
      "id": "floor-contact-support-preserves-reviewed-protocol",
      "description": "Floor-contact fixtures retain the original study prescription and cadence.",
      "when": {"field": "variant.interRepSupport", "operator": "equals", "value": "floorContactNoSpecifiedReset"},
      "then": [
        {"field": "equipment", "value": "barbell"},
        {"field": "variant.externalLoadPrescription", "value": "eightyPercentVariantSpecificOneRepMaximum"},
        {"field": "variant.tempo", "value": "twoSecondsEachPhaseWithHalfSecondIsometric"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    }
  ],
