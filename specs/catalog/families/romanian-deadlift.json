{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "romanian-deadlift",
  "name": "Romanian and Stiff-Leg Deadlift",
  "definition": "A bilateral unsupported hip-dominant hinge with planted feet, a braced spine, and either a free barbell or paired dumbbells. The roster preserves three reviewed floor-contact barbell fixtures and adds source-exact continuous top-start barbell and paired-dumbbell fixtures that reverse near mid-shin without touching down. Floor-touch and continuous identities remain separate so their histories do not merge. Hip extension is the sole dynamic prime; prescribed knee technique remains nondefining, and the straight-spine instruction supports resisting spinal flexion rather than inventing dynamic spinal extension. Arbitrary deficits, staggered or single-leg support, rotating grips, and floor-start dumbbell variants remain outside this family.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "christophy-2012-lumbar-spine",
    "coratella-2022-romanian-step-stiff-leg-deadlift",
    "lee-2018-conventional-romanian-deadlift",
    "lyons-2026-conventional-romanian-deadlift",
    "ace-2025-romanian-deadlift",
    "nsca-2012-basics-strength-conditioning"
  ],
