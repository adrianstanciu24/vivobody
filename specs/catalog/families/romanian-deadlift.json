  "exerciseRules": [
    {
      "id": "ground-level-range-requires-floor-surface",
      "description": "A floor-at-foot-level range requires both feet on that floor and no platform-height field.",
      "when": {
        "field": "variant.rangeOfMotion",
        "operator": "equals",
        "value": "floorAtFootLevelToStanding"
      },
      "then": [
        {
          "field": "variant.supportSurface",
          "value": "floor"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "stiff-leg-technique-requires-ground-level-fixture",
      "description": "The only directly reviewed extended-knee-throughout fixture places both feet and the plates on the same floor.",
      "when": {
        "field": "variant.kneeTechnique",
        "operator": "equals",
        "value": "extendedThroughoutKinematicsUnmeasured"
      },
      "then": [
        {
          "field": "variant.supportSurface",
          "value": "floor"
        },
        {
          "field": "variant.rangeOfMotion",
          "value": "floorAtFootLevelToStanding"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "continuous-range-pins-top-start-contract",
      "description": "The source-exact top-start range has no floor contact and uses the controlled unreported cadence.",
      "when": {
        "field": "variant.rangeOfMotion",
        "operator": "equals",
        "value": "topStartToMidShinWithoutFloorContact"
      },
      "then": [
        {
          "field": "variant.supportSurface",
          "value": "floor"
        },
        {
          "field": "variant.kneeTechnique",
          "value": "slightlyFlexedHeld"
        },
        {
          "field": "variant.externalLoadPrescription",
          "value": "sourceUnspecified"
        },
        {
          "field": "variant.tempo",
          "value": "controlledSourceUnreported"
        },
        {
          "field": "variant.interRepSupport",
          "value": "noneContinuous"
