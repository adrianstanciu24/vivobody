{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "landmine-press",
  "name": "Landmine Press",
  "definition": "A strict press using one end of an Olympic bar fixed to a landmine pivot. The moving sleeve travels through the bar's constrained diagonal arc while the shoulder flexes and the elbow extends without deliberate leg drive or trunk rotation. The reviewed branches are a unilateral standing split-stance press, a unilateral half-kneeling press with the working-side knee down, and a bilateral standing two-hand press from a square stance. Zhao et al. directly establish the apparatus and standing unilateral power-test topology; Szelog establishes the half-kneeling same-side-knee setup; ACE establishes a two-arm landmine press. Added-plate training loads are comparable only on the same bar, pivot, and setup. The two-hand branch owns the unqualified Landmine Press identity; the original unilateral record remains explicitly Single-Arm. No scapular prime action is inferred. Tall-kneeling, rotational punch, squat-to-press, explosive throw, Viking-press, free-bar, cable, machine, torso-lean, and leg-driven variants remain outside this contract.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "holzbaur-2005-upper-extremity",
    "murray-1995-elbow-forearm-moment-arms",
    "zhao-2026-landmine-press-kinematics",
    "nsca-2016-landmine-press",
    "boxing-science-exercise-library",
    "ace-2025-two-arm-landmine-press",
    "boxing-science-vertical-press-course"
  ],
