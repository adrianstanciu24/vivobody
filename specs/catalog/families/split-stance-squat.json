  "exerciseRules": [
    {
      "id": "floor-trail-support-has-no-elevation",
      "description": "The original split squat keeps the trail forefoot on the floor.",
      "when": {"field": "variant.trailFootSupport", "operator": "equals", "value": "forefootFloor"},
      "then": [
        {"field": "variant.stanceLength", "value": "approximatelyLegLength"},
        {"field": "variant.rearSupportHeight", "value": "floor"},
        {"field": "variant.loadPlacement", "value": "upperBackBarbell"},
        {"field": "variant.rangeOfMotion", "value": "leadThighParallel"},
        {"field": "variant.trunkOrientation", "value": "erect"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "elevated-trail-support-uses-patella-height",
      "description": "The reviewed rear box is set from base of patella to ground.",
      "when": {"field": "variant.trailFootSupport", "operator": "equals", "value": "elevatedBoxFootFixedAgainstPosteriorStop"},
      "then": [
        {"field": "variant.rearSupportHeight", "value": "baseOfPatellaToGround"},
        {"field": "variant.stanceLength", "value": "individualizedPatellaOverLeadToeAtParallel"},
        {"field": "variant.rangeOfMotion", "value": "leadKneeApproximatelyNinetyDegrees"},
        {"field": "variant.loadPlacement", "value": "highBarUpperBackBarbell"},
        {"field": "variant.trunkOrientation", "value": "nonstandardized"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    }
