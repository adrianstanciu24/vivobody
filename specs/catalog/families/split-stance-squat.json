  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether the distal foot contacts remain fixed while the body moves; both feet retain their reviewed contacts in this stationary branch.",
      "allowedValues": [
        "closed"
      ]
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "description": "The gross whole-body posture at the start and end of every repetition.",
      "allowedValues": [
        "standing"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "Whether an external surface supports the torso during the repetition.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "stanceConfiguration",
      "valueType": "enum",
      "required": true,
      "description": "The asymmetric front-to-back relationship of the feet; this reviewed branch remains in one sagittal split stance.",
      "allowedValues": [
        "splitSagittal"
      ]
    },
    {
      "id": "stanceLength",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed long split stance, approximately equal to greater-trochanter-to-lateral-malleolus leg length. Song et al. taped a 100-percent condition but did not report the exact foot landmark, so the contract does not encode a false numeric ratio.",
      "allowedValues": [
        "approximatelyLegLength",
        "individualizedPatellaOverLeadToeAtParallel"
      ]
    },
    {
      "id": "leadFootSupport",
      "valueType": "enum",
      "required": true,
      "description": "The lead-foot contact retained throughout the repetition.",
      "allowedValues": [
        "fullFootFloor"
      ]
    },
    {
      "id": "trailFootSupport",
      "valueType": "enum",
      "required": true,
      "description": "The trail-foot contact retained throughout the repetition; the reviewed split stance uses the forefoot rather than an elevated rear support.",
      "allowedValues": [
        "forefootFloor",
        "elevatedBoxFootFixedAgainstPosteriorStop"
      ]
    },
    {
      "id": "rearSupportHeight",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed rear-contact height; floor means no elevation, while the Bulgarian fixture uses the athlete's base-of-patella height.",
      "allowedValues": [
        "floor",
        "baseOfPatellaToGround"
      ]
    },
    {
      "id": "interRepFootTransition",
      "valueType": "enum",
      "required": true,
      "description": "Whether either foot steps between repetitions; the stationary split-squat branch keeps both contacts fixed.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "loadPlacement",
      "valueType": "enum",
      "required": true,
      "description": "Where the barbell is supported; the source figure supports posterior upper-back placement but does not establish a precise high- versus low-bar site.",
      "allowedValues": [
        "upperBackBarbell",
        "highBarUpperBackBarbell"
      ]
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "The bilateral hand orientation used to control the upper-back barbell; pronation is figure- and mechanics-derived rather than stated in the textual methods.",
      "allowedValues": [
        "pronated"
      ]
    },
    {
      "id": "rangeOfMotion",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed bottom-position criterion for the lead limb; the lead thigh reaches approximately parallel to the floor.",
      "allowedValues": [
        "leadThighParallel",
        "leadKneeApproximatelyNinetyDegrees"
      ]
    },
    {
      "id": "trunkOrientation",
      "valueType": "enum",
      "required": true,
      "description": "The instructed and video-checked sagittal trunk orientation.",
      "allowedValues": [
        "erect",
        "nonstandardized"
      ]
    },
    {
      "id": "spineMotion",
      "valueType": "enum",
      "required": true,
      "description": "The source instructed and video-checked an erect gross torso but did not measure segmental spinal motion; deliberate spinal motion is not a prime action, while the exact lumbar path remains unstandardized.",
      "allowedValues": [
        "nonstandardized"
      ]
    },
    {
      "id": "hipMotion",
      "valueType": "enum",
      "required": true,
      "description": "The dynamic concentric lead-hip action that returns the athlete to split standing.",
      "allowedValues": [
        "extends"
      ]
    },
    {
      "id": "kneeMotion",
      "valueType": "enum",
      "required": true,
      "description": "The dynamic concentric lead-knee action that returns the athlete to split standing.",
      "allowedValues": [
        "extends"
      ]
    },
    {
      "id": "ankleMotion",
      "valueType": "enum",
      "required": true,
      "description": "The dynamic concentric lead-ankle motion from bottom-position dorsiflexion toward the split-standing angle.",
      "allowedValues": [
        "plantarflexes"
      ]
    },
    {
      "id": "footMotion",
      "valueType": "enum",
      "required": true,
      "description": "Whether deliberate toe motion, inversion, or eversion creates the repetition.",
      "allowedValues": [
        "positionHeld"
      ]
    },
    {
      "id": "footContact",
      "valueType": "enum",
      "required": true,
      "description": "Whether the lead full-foot and trail forefoot contacts remain on the floor through descent, ascent, and lockout.",
      "allowedValues": [
        "continuous"
      ]
    },
    {
      "id": "interRepSupport",
      "valueType": "enum",
      "required": true,
      "description": "Whether an external support receives the body or load between repetitions.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "fixedValue": false,
      "description": "Whether rails or a lever constrain the barbell path; the reviewed straight-bar fixture is free weight."
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "description": "Which lower-body joint motions deliberately create the concentric repetition.",
      "allowedValues": [
        "compoundHipKneeAnkleExtension"
      ]
    }
  ],
