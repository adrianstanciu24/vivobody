  "exerciseRules": [
    {
      "id": "floor-trail-support-has-no-elevation",
      "description": "Both reviewed floor split squats keep the trail forefoot on the floor and share the exact Song geometry.",
      "when": {"field": "variant.trailFootSupport", "operator": "equals", "value": "forefootFloor"},
      "then": [
        {"field": "variant.stanceLength", "value": "approximatelyLegLength"},
        {"field": "variant.rearSupportHeight", "value": "floor"},
        {"field": "variant.rangeOfMotion", "value": "leadThighParallel"},
        {"field": "variant.trunkOrientation", "value": "erect"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "elevated-trail-support-uses-patella-height",
      "description": "The reviewed rear box is set from base of patella to ground.",
      "when": {"field": "variant.trailFootSupport", "operator": "equals", "value": "elevatedBoxFootFixedAgainstPosteriorStop"},
      "then": [
        {"field": "variant.rearSupportHeight", "value": "baseOfPatellaToGround"},
        {"field": "variant.stanceLength", "value": "individualizedPatellaOverLeadToeAtParallel"},
        {"field": "variant.rangeOfMotion", "value": "leadKneeApproximatelyNinetyDegrees"},
        {"field": "variant.loadPlacement", "value": "highBarUpperBackBarbell"},
        {"field": "variant.trunkOrientation", "value": "nonstandardized"},
        {"field": "variant.implementConfiguration", "value": "straightBarbell"},
        {"field": "variant.loadAccounting", "value": "totalBarAndPlates"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "bench-top-of-foot-support-uses-paired-dumbbells",
      "description": "The reviewed dumbbell fixture places the top of the rear foot on a bench whose height and stance length were not reported.",
      "when": {"field": "variant.trailFootSupport", "operator": "equals", "value": "elevatedBenchTopOfFoot"},
      "then": [
        {"field": "equipment", "value": "dumbbell"},
        {"field": "variant.rearSupportHeight", "value": "sourceUnreported"},
        {"field": "variant.stanceLength", "value": "sourceUnreported"},
        {"field": "variant.rangeOfMotion", "value": "leadThighParallel"},
        {"field": "variant.loadPlacement", "value": "pairedBesideBody"},
        {"field": "variant.gripOrientation", "value": "neutral"},
        {"field": "variant.trunkOrientation", "value": "nonstandardized"},
        {"field": "variant.implementConfiguration", "value": "pairedDumbbells"},
        {"field": "variant.loadAccounting", "value": "perImplement"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "dumbbell-load-is-paired-per-implement",
      "description": "A dumbbell record uses two matched implements while the user logs one dumbbell's weight.",
      "when": {"field": "equipment", "operator": "equals", "value": "dumbbell"},
      "then": [
        {"field": "variant.loadPlacement", "value": "pairedBesideBody"},
        {"field": "variant.gripOrientation", "value": "neutral"},
        {"field": "variant.implementConfiguration", "value": "pairedDumbbells"},
        {"field": "variant.loadAccounting", "value": "perImplement"}
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [{"muscle": "triceps", "role": "stabilizer"}]
    },
    {
      "id": "paired-beside-body-placement-identifies-dumbbells",
      "description": "Paired side-held loading belongs only to the two reviewed dumbbell fixtures.",
      "when": {"field": "variant.loadPlacement", "operator": "equals", "value": "pairedBesideBody"},
      "then": [
        {"field": "equipment", "value": "dumbbell"},
        {"field": "variant.gripOrientation", "value": "neutral"},
        {"field": "variant.implementConfiguration", "value": "pairedDumbbells"},
        {"field": "variant.loadAccounting", "value": "perImplement"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "straight-barbell-configuration-identifies-barbell-loading",
      "description": "A straight barbell configuration cannot inherit paired-dumbbell placement or accounting.",
      "when": {"field": "variant.implementConfiguration", "operator": "equals", "value": "straightBarbell"},
      "then": [
        {"field": "equipment", "value": "barbell"},
        {"field": "variant.loadPlacement", "allowedValues": ["upperBackBarbell", "highBarUpperBackBarbell"]},
        {"field": "variant.gripOrientation", "value": "pronated"},
        {"field": "variant.loadAccounting", "value": "totalBarAndPlates"}
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [{"muscle": "brachialis", "role": "stabilizer"}]
    },
    {
      "id": "upper-back-placement-identifies-floor-barbell-split-squat",
      "description": "The ordinary upper-back barbell placement belongs only to the floor-supported barbell split squat.",
      "when": {"field": "variant.loadPlacement", "operator": "equals", "value": "upperBackBarbell"},
      "then": [
        {"field": "equipment", "value": "barbell"},
        {"field": "variant.trailFootSupport", "value": "forefootFloor"},
        {"field": "variant.gripOrientation", "value": "pronated"},
        {"field": "variant.implementConfiguration", "value": "straightBarbell"},
        {"field": "variant.loadAccounting", "value": "totalBarAndPlates"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "high-bar-placement-identifies-elevated-barbell-split-squat",
      "description": "The high-bar placement belongs only to the patella-height rear-foot-elevated barbell fixture.",
      "when": {"field": "variant.loadPlacement", "operator": "equals", "value": "highBarUpperBackBarbell"},
      "then": [
        {"field": "equipment", "value": "barbell"},
        {"field": "variant.trailFootSupport", "value": "elevatedBoxFootFixedAgainstPosteriorStop"},
        {"field": "variant.gripOrientation", "value": "pronated"},
        {"field": "variant.implementConfiguration", "value": "straightBarbell"},
        {"field": "variant.loadAccounting", "value": "totalBarAndPlates"}
      ],
      "requirePresent": [],
      "requireAbsent": []
    }
  ],
