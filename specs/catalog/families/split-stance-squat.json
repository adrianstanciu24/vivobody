      "execution": {
        "startingPosition": "Log one dumbbell's weight, not the pair total. Hold one matching dumbbell at each side and take a fixed split stance about as long as the distance from the outside of your hip to the outside of your ankle. Keep the lead foot flat and the rear forefoot on the floor.",
        "movement": "Keep both foot contacts fixed and lower with an erect torso until the lead thigh is approximately parallel to the floor.",
        "endpoint": "Stop at lead-thigh-parallel depth without shortening the stance or moving either foot.",
        "returnPhase": "Push through the lead foot and extend the lead hip, knee, and ankle to return to the same split stance.",
        "controlledJoints": "Keep the lead knee tracking with the foot and both dumbbells hanging neutrally at your sides.",
        "supportAndPosture": "Keep the torso erect and use no rear-foot elevation or external support.",
        "disqualifyingCompensations": [
          "Stepping between repetitions turns the movement into a lunge.",
          "Elevating the rear foot turns it into a rear-foot-elevated split squat.",
          "Holding one dumbbell or moving the pair away from the sides changes the reviewed load geometry."
        ],
        "sideOrDirection": "Complete all repetitions with one lead leg, then repeat with the other leg."
      }
    },
