      "execution": {
        "startingPosition": "Kneel on all fours with a light-to-medium mini band immediately above both knees. Place the hands beneath the shoulders and the knees beneath the hips.",
        "movement": "Keep one knee bent and lift that thigh out to the side against the band.",
        "endpoint": "Stop the lateral lift when further travel would roll the pelvis or arch the low back.",
        "returnPhase": "Lower the bent leg slowly beneath the hip while controlling band tension.",
        "controlledJoints": "Keep the support knee and both hands planted, and hold the working knee bent throughout.",
        "supportAndPosture": "Maintain a controlled trunk and pelvis while the working hip moves.",
        "disqualifyingCompensations": [
          "Straightening the working knee changes the band path and movement.",
          "Rolling the pelvis to lift higher replaces the controlled hip action.",
          "Moving the band to the feet changes the resistance fixture."
        ],
        "sideOrDirection": "Complete the set with one working leg, then repeat on the other side."
      }
