      "involvement": [{"muscle": "gluteMed", "role": "primary"}, {"muscle": "tensorFasciaeLatae", "role": "secondary"}],
      "variant": {
        "kineticChain": "open", "bodyPosition": "seated", "torsoSupport": "machineBackPad", "pelvisSupport": "machineSeatAndBackPad",
        "supportLegPosture": "notApplicableBilateralMachine", "pelvisMotion": "positionHeld", "spineMotion": "positionHeld", "hipMotion": "abducts",
        "hipSagittalPosture": "flexed80Degrees", "hipStartAbductionDegrees": 0, "hipEndAbductionDegrees": 45, "hipRotation": "unreported",
        "trunkPositionFeedback": "noneReported", "abductionEndpointReference": "machineApproximate45DegreeLimit", "kneeMotion": "positionHeld",
        "kneePosture": "flexedApproximately90Degrees", "movingSegment": "thigh", "loadInterface": "lateralThighPads",
        "resistanceGeometry": "selectorizedIsotonicLever", "handSupport": "machineHandles", "machineFixture": "technogymSeatedAbductorModelUnreported",
        "cadence": "oneSecondConcentricOneSecondEccentric", "fixedPath": true, "lowerBodyContribution": "isolatedJointMotion"
      },
      "additionalPrimeActions": [], "additionalStabilityDemands": [],
      "evidenceRefs": ["arnold-2010-lower-limb", "brandt-2013-machine-hip-abduction-adduction"],
      "execution": {
        "startingPosition": "Sit upright against the Technogym support at about eighty degrees of hip flexion with the knees near ninety degrees, hips together, outer thighs against the pads, and hands on the handles.",
        "movement": "Move both thighs apart over approximately one second toward the machine's forty-five-degree limit.",
        "endpoint": "Reach approximately forty-five degrees with both thighs moving evenly and without bouncing.",
        "returnPhase": "Return both thighs together over approximately one second while controlling the machine lever.",
        "controlledJoints": "Keep the pelvis, spine, and knees still and move both thighs symmetrically.",
        "supportAndPosture": "Remain upright against the back support with both hands on the handles.",
        "disqualifyingCompensations": ["Rocking the trunk or pelvis changes the isolated machine movement.", "Bouncing, moving the knees, or allowing asymmetric travel changes the reviewed two-leg fixture."]
      }
