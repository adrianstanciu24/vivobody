      "shoulder.flexion", "shoulder.extension", "shoulder.abduction", "shoulder.adduction", "shoulder.horizontalAdduction", "shoulder.horizontalAbduction", "shoulder.internalRotation", "shoulder.externalRotation",
      "elbow.flexion", "elbow.extension", "forearm.pronation", "forearm.supination", "wrist.flexion", "wrist.extension", "wrist.radialDeviation", "wrist.ulnarDeviation", "hand.fingerFlexion", "hand.fingerExtension",
      "spine.flexion", "spine.extension", "spine.lateralFlexion", "spine.rotation", "hip.extension", "hip.abduction", "hip.adduction", "hip.internalRotation", "hip.externalRotation",
      "knee.extension", "ankle.plantarflexion", "ankle.dorsiflexion", "ankle.inversion", "ankle.eversion", "foot.toeFlexion", "foot.toeExtension"
    ],
    "stabilityDemands": ["shoulder", "scapula", "elbow", "wrist", "hand", "spine", "pelvis", "hip", "knee"]
  },
  "musclePolicy": {
    "requirements": [
      {"anyOf": ["abs"], "minimumRole": "primary"},
      {"anyOf": ["iliopsoas"], "minimumRole": "primary"},
      {"anyOf": ["rectusFemoris"], "minimumRole": "secondary"},
      {"anyOf": ["serratus"], "minimumRole": "stabilizer"},
      {"anyOf": ["fingerFlexors"], "minimumRole": "stabilizer"}
