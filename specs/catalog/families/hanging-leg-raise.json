{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "hanging-leg-raise",
  "name": "Hanging Leg Raise",
  "definition": "A suspended bilateral core movement in which the hips flex to ninety degrees from an overhead-bar hang while the anterior trunk resists spinal extension and a neutral spine is attempted. The bent-knee record also flexes the knees dynamically; the straight-leg record holds them extended. Kipping, deliberate spinal curling, unsupported grip variants, and endpoints above ninety degrees remain outside this family.",
  "evidenceRefs": ["arnold-2010-lower-limb", "christophy-2012-lumbar-spine", "holzbaur-2005-upper-extremity", "mcgill-2014-hanging-leg-raise"],
  "fixed": {"mechanic": "compound", "trainingRole": "core", "pattern": "core", "direction": null, "planes": ["sagittal"]},
  "groupPolicy": {"default": "core", "allowed": ["core"]},
  "allowed": {"equipment": ["bodyweight"], "modalities": ["dynamicStrength"], "trackingModes": ["reps"], "loadModes": ["nonComparable"], "lateralities": ["bilateral"]},
  "movementSignature": {
    "planeBasisActions": ["hip.flexion"],
    "primeActions": ["hip.flexion"],
    "resistedActions": ["spine.extension"],
    "forbiddenPrimeActions": [
