      "secondary": ["rectusFemoris", "medialHamstrings", "bicepsFemoris", "obliques"],
      "stabilizer": ["pectoralisMajorSternocostal", "serratus", "triceps", "fingerFlexors", "extensorCarpiRadialis"]
    }
  },
  "variantAxes": [
    {"id": "supportTopology", "valueType": "enum", "required": true, "description": "How the body is suspended.", "allowedValues": ["overheadBarHandHang"]},
    {"id": "hipEndpointDegrees", "valueType": "number", "required": true, "description": "The reviewed hip-flexion endpoint.", "minimum": 90, "maximum": 90},
    {"id": "kneeMotion", "valueType": "enum", "required": true, "description": "Whether the knees flex or remain extended.", "allowedValues": ["flexesToNinety", "angleHeldExtended"]},
    {"id": "spineMotion", "valueType": "enum", "required": true, "description": "The instructed spinal behavior.", "allowedValues": ["neutralAttempted"]},
    {"id": "tempo", "valueType": "enum", "required": true, "description": "The reviewed phase timing.", "allowedValues": ["twoUpOneHoldTwoDownOneHold"]},
    {"id": "momentum", "valueType": "enum", "required": true, "description": "The reviewed no-kip boundary.", "allowedValues": ["controlledNoDeliberateSwing"]},
    {"id": "fixedPath", "valueType": "boolean", "required": true, "description": "Whether an external guide constrains the lower limbs.", "fixedValue": false}
