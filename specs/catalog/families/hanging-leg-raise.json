      "variant": {"supportTopology": "overheadBarHandHang", "hipEndpointDegrees": 90, "kneeMotion": "flexesToNinety", "spineMotion": "neutralAttempted", "tempo": "twoUpOneHoldTwoDownOneHold", "momentum": "controlledNoDeliberateSwing", "fixedPath": false},
      "additionalPrimeActions": ["knee.flexion"],
      "additionalStabilityDemands": [],
      "evidenceRefs": ["arnold-2010-lower-limb", "christophy-2012-lumbar-spine", "holzbaur-2005-upper-extremity", "mcgill-2014-hanging-leg-raise"],
      "execution": {
