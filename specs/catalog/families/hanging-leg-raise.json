        {"muscle": "pectoralisMajorSternocostal", "role": "stabilizer"}, {"muscle": "serratus", "role": "stabilizer"},
        {"muscle": "triceps", "role": "stabilizer"}, {"muscle": "fingerFlexors", "role": "stabilizer"},
        {"muscle": "extensorCarpiRadialis", "role": "stabilizer"}
      ],
      "variant": {"supportTopology": "overheadBarHandHang", "hipEndpointDegrees": 90, "kneeMotion": "angleHeldExtended", "spineMotion": "neutralAttempted", "tempo": "twoUpOneHoldTwoDownOneHold", "momentum": "controlledNoDeliberateSwing", "fixedPath": false},
      "additionalPrimeActions": [],
      "additionalStabilityDemands": [],
      "evidenceRefs": ["arnold-2010-lower-limb", "christophy-2012-lumbar-spine", "holzbaur-2005-upper-extremity", "mcgill-2014-hanging-leg-raise"],
      "execution": {
