        {"field": "variant.pelvisSupport", "value": "machinePadAndStrap"},
        {"field": "variant.hipFlexionDegrees", "value": 30},
        {"field": "variant.anklePosture", "value": "unreported"},
        {"field": "variant.handSupport", "value": "unreported"},
        {"field": "variant.cadence", "value": "twoSecondConcentricTwoSecondEccentricNoPause"}
      ],
      "requirePresent": ["variant.hipFlexionDegrees"],
      "requireAbsent": []
