        {"field": "variant.pelvisSupport", "value": "machineSeatAndBackPad"},
        {"field": "variant.anklePosture", "value": "unreported"},
        {"field": "variant.handSupport", "value": "fixedMachineHandles"},
        {"field": "variant.cadence", "value": "notControlled"}
