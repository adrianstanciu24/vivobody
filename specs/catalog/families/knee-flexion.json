  "exerciseRules": [
    {
      "id": "seated-leg-curl-uses-reviewed-hip-angle",
      "description": "The seated source fixture holds the hip near 90 degrees of flexion.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "equals",
        "value": "seated"
      },
      "then": [
        {
          "field": "variant.hipFlexionDegrees",
          "value": 90
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "ninety-degree-leg-curl-is-seated",
      "description": "The reviewed 90-degree hip-flexion fixture is the seated condition.",
      "when": {
        "field": "variant.hipFlexionDegrees",
        "operator": "equals",
        "value": 90
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "value": "seated"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "prone-leg-curl-uses-reviewed-hip-angle",
      "description": "The prone source fixture holds the hip near 30 degrees of flexion.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "equals",
        "value": "prone"
      },
      "then": [
        {
          "field": "variant.hipFlexionDegrees",
          "value": 30
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "thirty-degree-leg-curl-is-prone",
      "description": "The reviewed 30-degree hip-flexion fixture is the prone condition.",
