{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "knee-flexion",
  "name": "Knee Flexion",
  "definition": "A strict open-chain lever-machine isolation in which the lower leg flexes at the knee while the hip, pelvis, spine, ankle, and foot remain held. The initial roster contains only the directly trained unilateral seated and prone conditions at approximately 90 and 30 degrees of hip flexion with the pelvis restrained. Both migrated hamstring regions remain primary in both postures; sartorius and gracilis are directly measured secondaries. Gastrocnemius is deliberately absent because the training source did not report ankle posture or measure calf involvement, while separate maximal isokinetic evidence shows that its knee-flexion contribution changes with ankle position. Bilateral or standing curls, cable or band curls, Nordics, razor curls, glute-ham raises, sliding or ball curls, hip-extension tasks, and ankle-posture variants remain outside this family.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "maeo-2021-seated-prone-leg-curl",
    "gallucci-2002-gastrocnemius-leg-curl"
  ],
