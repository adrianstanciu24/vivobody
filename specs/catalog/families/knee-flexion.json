  "exerciseRules": [
    {
      "id": "life-fitness-pins-unilateral-seated-fixture",
      "description": "The modified Life Fitness fixture preserves its exact unilateral seated support, hip angle, ankle disclosure, hand disclosure, and cadence.",
      "when": {
        "field": "variant.machineFixture",
        "operator": "equals",
        "value": "lifeFitnessPro2SeriesModified"
      },
      "then": [
        {"field": "laterality", "value": "unilateral"},
        {"field": "variant.bodyPosition", "value": "seated"},
        {"field": "variant.pelvisSupport", "value": "machinePadAndStrap"},
        {"field": "variant.hipFlexionDegrees", "value": 90},
        {"field": "variant.anklePosture", "value": "unreported"},
        {"field": "variant.handSupport", "value": "unreported"},
        {"field": "variant.cadence", "value": "twoSecondConcentricTwoSecondEccentricNoPause"}
      ],
      "requirePresent": ["variant.hipFlexionDegrees"],
      "requireAbsent": []
    },
    {
