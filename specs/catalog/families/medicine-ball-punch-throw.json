      "execution": {
        "startingPosition": "Stand in a balanced split boxing stance with your knees and hips slightly flexed, your weight biased toward the rear leg, and a medicine ball held in the rear hand near the shoulder.",
        "movement": "Pivot the rear foot, rotate the rear hip and trunk toward the target, and forcefully extend the rear arm to release the ball like a straight punch.",
        "endpoint": "The repetition ends when the ball leaves the rear hand toward the clear target.",
        "returnPhase": "Retrieve the ball or receive it from a prepared partner, then rebuild the same stance before the next repetition.",
        "controlledJoints": "Let the rear foot turn with the hips instead of twisting through a fixed knee.",
        "supportAndPosture": "Stay balanced through the release and keep the throwing area clear.",
        "disqualifyingCompensations": [
          "Stepping during the throw changes it into an approach throw.",
          "Using both hands changes it into a chest or rotational throw.",
          "Retaining the implement changes it into a landmine punch."
        ],
        "sideOrDirection": "Complete equal repetitions from each mirrored stance; one set includes both sides."
