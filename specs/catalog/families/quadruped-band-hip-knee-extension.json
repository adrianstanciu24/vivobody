      "execution": {
        "startingPosition": "Start on all fours with both knees bent beneath the hips and both hands on the floor. Loop a light-to-medium mini band around both feet.",
        "movement": "Move one leg backward, extending its hip and knee against the band while pointing the toes toward the floor.",
        "endpoint": "Reach a controlled backward leg extension while the pelvis remains square and the low back does not arch.",
        "returnPhase": "Bend the working knee and hip to bring it back beneath the body under control.",
        "controlledJoints": "Keep the support knee and both hands planted, and avoid twisting the pelvis or extending through the low back.",
        "supportAndPosture": "Maintain trunk tension and distribute support across both hands and the grounded knee.",
        "disqualifyingCompensations": [
          "Reaching an opposite arm forward changes the task to a bird dog.",
          "Arching the low back to lift the leg higher replaces hip extension with spinal motion.",
          "Moving the band to the knees changes the resistance direction."
        ],
        "sideOrDirection": "Finish the set on one working leg, then repeat with the other leg."
