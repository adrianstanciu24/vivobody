      "execution": {
        "startingPosition": "Lie face up on the floor while a prepared trainer or partner stands securely above you holding a medicine ball.",
        "movement": "Have the partner drop the ball toward your chest. Catch it with both hands around chest level and immediately return it explosively with a two-hand chest pass.",
        "endpoint": "The repetition ends when the ball leaves both hands.",
        "returnPhase": "Let the partner catch the return pass and prepare the next controlled drop.",
        "controlledJoints": "Absorb the drop through the arms and reverse it without sitting up to add trunk momentum.",
        "supportAndPosture": "Keep your torso and head supported on the floor throughout the pass.",
        "disqualifyingCompensations": [
          "Starting from a paused ball on the chest removes the specified reactive drop-and-return phase.",
          "Throwing toward a wall changes the receiving environment.",
          "Curling the torso off the floor adds a sit-up action."
