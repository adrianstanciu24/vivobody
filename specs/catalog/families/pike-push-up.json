      "execution": {
        "startingPosition": "Place your hands slightly wider than shoulder width on the floor and keep your feet on the floor. Raise your hips to form an inverted V and brace your trunk.",
        "movement": "Bend both elbows and lower your head toward the floor, keeping the elbows about 45 degrees from your body.",
        "endpoint": "Stop with your head just above the floor.",
        "returnPhase": "Press back up to the same pike position, stopping just short of elbow lockout.",
        "controlledJoints": "Keep your hips raised and avoid using leg drive or changing the pike angle to finish a repetition.",
        "supportAndPosture": "Keep the head aligned with the spine and maintain continuous hand and foot contact.",
        "disqualifyingCompensations": [
          "Dropping the hips changes the pike press into a regular push-up.",
          "Elevating the feet or using a wall changes this floor-supported fixture.",
          "Bouncing the head or using leg drive leaves the strict repetition."
        ]
      }
