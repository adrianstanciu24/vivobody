      "additionalPrimeActions": [], "additionalStabilityDemands": [],
      "evidenceRefs": ["arnold-2010-lower-limb", "murphy-riemann-2025-kettlebell-swing-hip-kinetics", "van-gelder-2015-two-hand-kettlebell-swing", "zebis-2013-kettlebell-swing-hamstrings"],
      "execution": {
        "startingPosition": "Stand symmetrically with both feet planted, hold one kettlebell with both hands, and hike it between the legs into hip flexion.",
        "movement": "Drive the hips forward rapidly with long arms and let that hip drive send the bell on a free arc.",
        "endpoint": "Finish the upward swing at shoulder height with the hips near neutral and do not continue overhead.",
        "returnPhase": "Actively guide the bell down, hinge as it passes between the legs, and continue into the next repetition.",
        "controlledJoints": "Keep both feet planted and do not deliberately lift the bell with the shoulders or elbows.",
        "supportAndPosture": "Use no torso support, brace the trunk, and keep a secure two-hand grip.",
