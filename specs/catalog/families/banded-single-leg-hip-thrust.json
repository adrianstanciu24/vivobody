      "execution": {
        "startingPosition": "Set the upper back on a bench edge. Secure both ends of a long band near the floor with heavy dumbbells and lay the band across the pelvis. Plant one heel under its knee with the toes lifted; lift the other leg with its knee near a right angle.",
        "movement": "Brace the trunk and drive the hips up as quickly as you can through the planted heel against the band, keeping the pelvis level.",
        "endpoint": "Reach full hip extension with the pelvis level; do not arch beyond neutral.",
        "returnPhase": "Lower the pelvis toward the floor under control while keeping the free leg lifted, then repeat.",
        "controlledJoints": "Keep the free knee bent and its toes drawn toward the shin; avoid rotating or shifting the pelvis.",
        "supportAndPosture": "Keep the upper back supported on the bench and both band anchors secure; band tension is not a comparable weight.",
        "disqualifyingCompensations": [
          "Putting the band around the knees changes the resistance direction.",
          "Using both feet for the thrust changes the one-leg fixture.",
          "Dropping the upper back to the floor changes the bench hip thrust to a floor bridge."
        ],
        "sideOrDirection": "Complete the set with one planted heel, then mirror the setup for the other side."
      }
    }
