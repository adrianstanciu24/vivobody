      "execution": {
        "startingPosition": "Stand upright with feet close together, a regular unweighted rope behind your feet, and one handle in each hand. Leave rope weight unset.",
        "movement": "Turn the rope forward and make small jumps with both feet together, clearing one rope pass beneath your feet per jump.",
        "endpoint": "Count one rep when the rope passes beneath both feet once and you land on both feet. Do not count a caught rope or failed attempt.",
        "returnPhase": "Land on the balls of both feet with soft knees and hips, then rebound into the next jump. If the rope catches, stop and reset before continuing.",
        "controlledJoints": "Keep your trunk steady and knees tracking over your feet. Keep elbows close to your sides while turning the rope.",
        "supportAndPosture": "Stay in place on a clear, level floor with room for the rope to turn freely. Use no external body support.",
        "disqualifyingCompensations": [
          "Alternating feet or using a boxer step changes the two-foot bounce.",
          "Double unders or backward rope turns change the single forward pass.",
          "Weighted ropes, weighted handles, or added body loads are outside this fixture.",
          "Travelling, deep squat jumps, or tuck jumps change the low-clearance stationary bounce."
        ]
      }
