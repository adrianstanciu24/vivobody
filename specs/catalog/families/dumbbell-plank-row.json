      "execution": {
        "startingPosition": "Log the weight of one dumbbell, not the combined pair. Place two equally loaded, stable dumbbells directly beneath your shoulders, hold their handles with palms facing inward, and set a high plank with both feet about shoulder-width apart.",
        "movement": "Shift your support onto one grounded dumbbell and both forefeet, then row the other dumbbell toward the side of your torso while keeping the working elbow close to your body.",
        "endpoint": "Finish when the working upper arm reaches your torso and the shoulder blade draws back, without turning your hips or shoulders.",
        "returnPhase": "Lower the working dumbbell under control to the floor and restore the two-hand plank before rowing with the opposite arm.",
        "controlledJoints": "Keep the supporting elbow extended, your wrists steady, and your hips and shoulders square while resisting low-back sag and trunk rotation.",
        "supportAndPosture": "Keep both forefeet planted and your trunk and legs in a straight high-plank line throughout each row.",
        "sideOrDirection": "Alternate arms; count each individual row and return as one repetition and use an even total. A row on each arm counts as two repetitions.",
        "disqualifyingCompensations": [
          "Keep this exercise to alternating rows; do not add a push-up.",
          "Touching the opposite shoulder or knee replaces the loaded row with a different exercise.",
          "Dragging the dumbbell along the floor changes the lifted row path.",
          "Keep your trunk square and your knees off the floor; do not use leg drive.",
          "Enter the weight of one dumbbell; do not add both dumbbells together."
        ]
      }
    }
