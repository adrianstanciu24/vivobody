  "exerciseRules": [
    {
      "id": "dumbbell-carry-pins-independent-pair-accounting",
      "description": "The dumbbell fixture uses two equal independent implements and logs one dumbbell.",
      "when": {"field": "equipment", "operator": "equals", "value": "dumbbell"},
      "then": [
        {"field": "variant.implementConfiguration", "value": "pairedDumbbells"},
        {"field": "variant.loadPlacement", "value": "pairedIndependentAtSides"},
        {"field": "variant.gripClosure", "value": "sourceUnreported"},
        {"field": "variant.handleGeometry", "value": "independentDumbbellHandles"},
        {"field": "variant.frameGeometry", "value": "notApplicable"},
        {"field": "variant.handleHeight", "value": "notApplicable"},
        {"field": "variant.pickupTopology", "value": "standingWithPairedDumbbells"},
        {"field": "variant.loadAccounting", "value": "perImplement"}
      ],
      "requirePresent": [],
      "requireAbsent": ["variant.approximateHandleSpacingCm"]
    },
    {
      "id": "trap-bar-carry-pins-high-handle-closed-frame",
      "description": "The trap-bar fixture uses the high handles of a conventional closed dual-height frame and logs the complete frame and plates once.",
      "when": {"field": "equipment", "operator": "equals", "value": "trapBar"},
      "then": [
        {"field": "variant.implementConfiguration", "value": "closedDualHeightHexFrame"},
        {"field": "variant.loadPlacement", "value": "athleteInsideClosedFrameHandlesAtSides"},
        {"field": "variant.gripClosure", "value": "closed"},
        {"field": "variant.handleGeometry", "value": "parallelFrameSideHandles"},
        {"field": "variant.frameGeometry", "value": "conventionalClosedDualHeightHexFrame"},
        {"field": "variant.handleHeight", "value": "highHandlesApproximatelyTenCentimetersAboveLowCenters"},
        {"field": "variant.approximateHandleSpacingCm", "value": 64},
        {"field": "variant.pickupTopology", "value": "highHandleFloorLiftSetupNotCreditedRep"},
        {"field": "variant.loadAccounting", "value": "totalBarAndPlates"}
      ],
      "requirePresent": ["variant.approximateHandleSpacingCm"],
      "requireAbsent": []
    },
    {
      "id": "per-implement-accounting-identifies-dumbbells",
      "description": "Per-implement accounting cannot be combined with the single trap-bar frame.",
      "when": {"field": "variant.loadAccounting", "operator": "equals", "value": "perImplement"},
      "then": [{"field": "equipment", "value": "dumbbell"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "total-bar-accounting-identifies-trap-bar",
      "description": "Total bar-and-plate accounting belongs only to the reviewed trap-bar carry.",
      "when": {"field": "variant.loadAccounting", "operator": "equals", "value": "totalBarAndPlates"},
      "then": [{"field": "equipment", "value": "trapBar"}],
      "requirePresent": ["variant.approximateHandleSpacingCm"],
      "requireAbsent": []
    }
  ],
