  "exerciseRules": [
    {
      "id": "dumbbell-carry-pins-independent-pair-accounting",
      "description": "The dumbbell fixture uses two equal independent implements and logs one dumbbell.",
      "when": {"field": "equipment", "operator": "equals", "value": "dumbbell"},
      "then": [
        {"field": "variant.implementConfiguration", "value": "pairedDumbbells"},
        {"field": "variant.loadPlacement", "value": "pairedIndependentAtSides"},
        {"field": "variant.gripClosure", "value": "sourceUnreported"},
        {"field": "variant.handleGeometry", "value": "independentDumbbellHandles"},
        {"field": "variant.frameGeometry", "value": "notApplicable"},
        {"field": "variant.handleHeight", "value": "notApplicable"},
        {"field": "variant.pickupTopology", "value": "standingWithPairedDumbbells"},
        {"field": "variant.loadAccounting", "value": "perImplement"}
      ],
      "requirePresent": [],
      "requireAbsent": ["variant.approximateHandleSpacingCm"]
    },
    {
      "id": "per-implement-accounting-identifies-dumbbells",
      "description": "Per-implement accounting cannot be combined with the single trap-bar frame.",
      "when": {"field": "variant.loadAccounting", "operator": "equals", "value": "perImplement"},
      "then": [{"field": "equipment", "value": "dumbbell"}],
