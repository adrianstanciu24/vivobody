{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "shoulder-extension-isolation",
  "name": "Shoulder Extension Isolation",
  "definition": "An open-chain isolation movement whose concentric phase extends the shoulder from a flexed overhead start while the elbow angle remains fixed. The roster owns directly reviewed barbell and single-dumbbell flat-bench pullovers plus bilateral straight-arm cable pulldowns. The dumbbell fixture uses one short plate-loaded implement held securely in both hands and logs that implement's full marked mass once; the source does not disclose an inner-plate or handle contact, numeric elbow angle, or numeric overhead endpoint. Band, machine, unilateral, bodyweight, bent-arm, rowing, and elbow-extension variants remain outside this contract.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "holzbaur-2005-upper-extremity",
    "marchetti-2011-barbell-pullover",
    "muyor-2022-pullover-straight-arm-pulldown",
    "campos-2017-barbell-dumbbell-pullover"
  ],
  "fixed": {
    "mechanic": "isolation",
    "trainingRole": "pull",
    "pattern": null,
    "direction": null,
    "planes": [
      "sagittal"
    ]
  },
  "groupPolicy": {
    "default": "back",
    "allowed": [
      "back",
      "chest"
    ]
  },
  "allowed": {
