        "bench",
        "none"
      ]
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "description": "Whether posterior support limits scapular translation along the thorax.",
      "allowedValues": [
        "supportConstrained",
        "free"
      ]
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
