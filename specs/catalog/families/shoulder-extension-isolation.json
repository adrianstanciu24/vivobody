  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether the distal segment moves freely or remains fixed.",
      "allowedValues": [
        "open"
      ]
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed body position used for the movement.",
      "allowedValues": [
        "supine",
        "standing"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
