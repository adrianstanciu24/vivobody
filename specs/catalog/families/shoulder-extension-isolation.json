  "id": "shoulder-extension-isolation",
  "name": "Shoulder Extension Isolation",
  "definition": "An open-chain isolation movement whose concentric phase extends the shoulder from a flexed overhead start while the elbow angle remains fixed. The admitted roster is limited to the directly reviewed barbell pullover and bilateral straight-arm cable pulldown; dumbbell, band, machine, unilateral, bodyweight, bent-arm, and rowing variants remain outside this contract.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "holzbaur-2005-upper-extremity",
    "marchetti-2011-barbell-pullover",
    "muyor-2022-pullover-straight-arm-pulldown"
  ],
