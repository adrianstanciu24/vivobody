      "allowedValues": [
        "pronated",
        "neutral"
      ]
    },
    {
      "id": "relativeGripWidth",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed relationship between the two hands.",
      "allowedValues": [
        "shoulderWidth",
        "wide",
        "narrow"
      ]
    },
    {
      "id": "elbowMotion",
      "valueType": "enum",
      "required": true,
      "description": "Whether elbow angle intentionally changes during the repetition.",
      "allowedValues": [
        "angleHeld"
      ]
    },
    {
      "id": "elbowPosture",
      "valueType": "enum",
      "required": true,
      "description": "The maintained elbow posture through the working range.",
      "allowedValues": [
        "nearExtended",
        "fixedAngleSourceUnreported"
      ]
    },
    {
      "id": "startArmZone",
      "valueType": "enum",
      "required": true,
      "description": "The categorical shoulder position at the start of the concentric phase.",
      "allowedValues": [
        "overheadEarlobe",
        "sourceSelectedFullShoulderFlexion"
      ]
    },
    {
      "id": "concentricEndZone",
      "valueType": "enum",
      "required": true,
      "description": "The categorical hand and load endpoint of the concentric phase.",
      "allowedValues": [
        "overChest",
        "thighs",
        "verticalOverShoulders"
      ]
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "description": "Whether hip, knee, or ankle drive contributes to the concentric shoulder extension.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "gripConfiguration",
      "valueType": "enum",
      "required": false,
      "description": "The source-reported security of the two-hand dumbbell grip.",
      "allowedValues": ["closed"]
    },
    {
      "id": "loadInterface",
      "valueType": "enum",
      "required": false,
      "description": "Where the hands contact the single dumbbell; the source leaves this detail unreported.",
      "allowedValues": ["sourceUnreported"]
    },
    {
      "id": "implementConfiguration",
      "valueType": "enum",
      "required": false,
      "description": "The exact dumbbell construction and implement count.",
      "allowedValues": ["singleShortPlateLoadedDumbbell"]
    },
    {
      "id": "loadAccounting",
      "valueType": "enum",
      "required": false,
      "description": "How the single logged resistance value maps to the implement.",
      "allowedValues": ["totalSingleImplement"]
    },
    {
      "id": "benchContact",
      "valueType": "enum",
      "required": false,
      "description": "The body regions supported by the flat bench.",
      "allowedValues": ["headThoraxGlutesSupported"]
    },
    {
      "id": "footSupport",
      "valueType": "enum",
      "required": false,
      "description": "The directly reviewed foot contact.",
      "allowedValues": ["bothFeetOnFloor"]
    }
  ],
  "recommended": {
    "defaultReps": {
      "minimum": 8,
      "maximum": 15
    }
  },
  "exerciseRules": [
    {
      "id": "barbell-pullover-uses-supported-over-chest-path",
      "description": "The reviewed barbell pullover is supine on a bench, starts overhead, and ends over the chest with sternocostal pectoralis major primary.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "barbell"
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "value": "supine"
        },
        {
          "field": "variant.torsoSupport",
          "value": "bench"
        },
        {
          "field": "variant.scapularTranslation",
          "value": "supportConstrained"
        },
        {
          "field": "variant.gripOrientation",
          "value": "pronated"
        },
        {
          "field": "variant.relativeGripWidth",
          "value": "shoulderWidth"
        },
        {
          "field": "variant.elbowPosture",
          "value": "nearExtended"
        },
        {
          "field": "variant.startArmZone",
          "value": "overheadEarlobe"
        },
        {
          "field": "variant.concentricEndZone",
          "value": "overChest"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "pectoralisMajorSternocostal",
          "role": "primary"
        },
        {
          "muscle": "lats",
          "role": "secondary"
        }
      ]
    },
    {
      "id": "cable-pulldown-uses-standing-to-thighs-path",
      "description": "The reviewed straight-arm cable pulldown is standing and unsupported, permits free scapular translation, and ends at the thighs with latissimus dorsi primary.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "cable"
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "value": "standing"
        },
        {
          "field": "variant.torsoSupport",
          "value": "none"
        },
        {
          "field": "variant.scapularTranslation",
          "value": "free"
        },
        {
          "field": "variant.gripOrientation",
          "value": "pronated"
        },
        {
          "field": "variant.elbowPosture",
          "value": "nearExtended"
        },
        {
          "field": "variant.startArmZone",
          "value": "overheadEarlobe"
        },
        {
          "field": "variant.concentricEndZone",
          "value": "thighs"
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "lats",
          "role": "primary"
        },
        {
          "muscle": "pectoralisMajorSternocostal",
          "role": "secondary"
        }
      ]
    },
    {
      "id": "non-dumbbell-omits-single-dumbbell-axes",
      "description": "Barbell and cable fixtures cannot inherit the single-dumbbell grip, implement, accounting, or support fields.",
      "when": {"field": "equipment", "operator": "notEquals", "value": "dumbbell"},
      "then": [],
      "requirePresent": [],
      "requireAbsent": [
        "variant.gripConfiguration",
        "variant.loadInterface",
        "variant.implementConfiguration",
        "variant.loadAccounting",
        "variant.benchContact",
        "variant.footSupport"
      ]
    },
    {
      "id": "neutral-grip-is-single-dumbbell-only",
      "description": "The neutral grip belongs only to the single-dumbbell pullover.",
      "when": {"field": "variant.gripOrientation", "operator": "equals", "value": "neutral"},
      "then": [{"field": "equipment", "value": "dumbbell"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "narrow-grip-is-single-dumbbell-only",
      "description": "The narrow two-hand spacing belongs only to the single-dumbbell pullover.",
      "when": {"field": "variant.relativeGripWidth", "operator": "equals", "value": "narrow"},
      "then": [{"field": "equipment", "value": "dumbbell"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "source-unreported-elbow-posture-is-single-dumbbell-only",
      "description": "The source-unreported held elbow angle belongs only to the single-dumbbell fixture.",
      "when": {"field": "variant.elbowPosture", "operator": "equals", "value": "fixedAngleSourceUnreported"},
      "then": [{"field": "equipment", "value": "dumbbell"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "source-selected-start-is-single-dumbbell-only",
      "description": "The source-selected full-flexion start belongs only to the single-dumbbell fixture.",
      "when": {"field": "variant.startArmZone", "operator": "equals", "value": "sourceSelectedFullShoulderFlexion"},
      "then": [{"field": "equipment", "value": "dumbbell"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "vertical-over-shoulders-end-is-single-dumbbell-only",
      "description": "The vertical-over-shoulders endpoint belongs only to the single-dumbbell fixture.",
      "when": {"field": "variant.concentricEndZone", "operator": "equals", "value": "verticalOverShoulders"},
      "then": [{"field": "equipment", "value": "dumbbell"}],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "single-dumbbell-pullover-fixture",
      "description": "The dumbbell branch is the exact flat-bench, two-hand, single-implement pullover and preserves source-unreported grip contact and elbow angle.",
      "when": {"field": "equipment", "operator": "equals", "value": "dumbbell"},
      "then": [
        {"field": "variant.bodyPosition", "value": "supine"},
        {"field": "variant.torsoSupport", "value": "bench"},
        {"field": "variant.scapularTranslation", "value": "supportConstrained"},
        {"field": "variant.gripOrientation", "value": "neutral"},
        {"field": "variant.relativeGripWidth", "value": "narrow"},
        {"field": "variant.elbowMotion", "value": "angleHeld"},
        {"field": "variant.elbowPosture", "value": "fixedAngleSourceUnreported"},
        {"field": "variant.startArmZone", "value": "sourceSelectedFullShoulderFlexion"},
        {"field": "variant.concentricEndZone", "value": "verticalOverShoulders"},
        {"field": "variant.lowerBodyContribution", "value": "none"},
        {"field": "variant.gripConfiguration", "value": "closed"},
        {"field": "variant.loadInterface", "value": "sourceUnreported"},
        {"field": "variant.implementConfiguration", "value": "singleShortPlateLoadedDumbbell"},
        {"field": "variant.loadAccounting", "value": "totalSingleImplement"},
        {"field": "variant.benchContact", "value": "headThoraxGlutesSupported"},
        {"field": "variant.footSupport", "value": "bothFeetOnFloor"}
      ],
      "requirePresent": ["variant.gripConfiguration", "variant.loadInterface", "variant.implementConfiguration", "variant.loadAccounting", "variant.benchContact", "variant.footSupport"],
      "requireAbsent": [],
      "requireInvolvement": [
        {"muscle": "pectoralisMajorSternocostal", "role": "primary"},
        {"muscle": "lats", "role": "secondary"}
      ]
    }
  ],
