        {"field": "variant.hipStartFlexionDegrees", "value": 30}, {"field": "variant.hipEndExtensionDegrees", "value": 5},
        {"field": "variant.rangeOfMotion", "value": "thirtyFlexionToFiveExtension"}, {"field": "variant.kneePosture", "value": "ninetyDegreesFlexed"},
