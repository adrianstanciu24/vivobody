        {"field": "variant.kneePosture", "value": "slightlyFlexedNearExtension"}, {"field": "variant.loadInterface", "value": "ankleCuffAboveAnkle"},
        {"field": "variant.resistanceGeometry", "value": "lowPulleyCable"}, {"field": "variant.handSupport", "value": "bothHandsOnPressingArmAtWaistHeight"},
        {"field": "variant.loadAccounting", "value": "enteredExternalLoadSameFixtureOnly"}
      ],
      "requirePresent": ["variant.loadAccounting"],
      "requireAbsent": ["variant.hipEndExtensionDegrees", "variant.kneeFlexionDegrees"]
