      "execution": {
        "startingPosition": "Face away from a low pulley with a rope attachment passing between your legs. Hold one rope end in each hand and stand with feet just wider than your shoulders and knees slightly bent. Enter the selected cable load and compare it only on this same station and attachment.",
        "movement": "Push your hips back while keeping your elbows straight and your trunk braced.",
        "endpoint": "End the hinge before your back rounds or the cable pulls you off balance.",
        "returnPhase": "Extend your hips to stand upright without leaning backward or pulling the rope with your arms.",
        "controlledJoints": "Keep a small knee bend while moving chiefly at the hips; brace your spine and keep your arms straight.",
        "supportAndPosture": "Keep both feet planted and distribute the task evenly between both legs.",
        "disqualifyingCompensations": [
          "Deep knee bending turns the hinge into a squat.",
          "Pulling with the shoulders or elbows changes the hip-driven pull-through.",
          "Leaning backward at the top changes the upright endpoint."
        ]
      }
