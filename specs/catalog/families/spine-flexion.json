{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "spine-flexion",
  "name": "Spine Flexion",
  "definition": "A strict bilateral trunk isolation in which the spine dynamically flexes and then returns under control while deliberate hip and pelvic motion do not create the repetition. The roster contains two exact fixtures: a bodyweight supine curl-up ending at the directly reviewed 30-degree trunk elevation, and a tall-kneeling high-rope cable crunch with the rope held beside the head and an unquantified strict trunk-flexion range. Rectus abdominis is primary and the combined internal-and-external-oblique region is secondary. Ha and Shin directly measured abdominal activity during controlled curl-ups; ACE directly defines the conventional cable fixture. Cable support-chain roles are bounded anatomy-and-mechanics inferences, not measured rankings. Full sit-ups, machine crunches, reverse crunches, leg raises, diagonal curl-ups, spinal rotation, lateral flexion, isometric holds, unstable surfaces, arm-driven cable pulls, and unreviewed curl-up angles remain outside this contract.",
  "evidenceRefs": [
    "arnold-2010-lower-limb",
    "christophy-2012-lumbar-spine",
    "holzbaur-2005-upper-extremity",
    "mirakhorlo-2018-hand-wrist-model",
    "seth-2019-shoulder-work",
    "ha-2020-curl-up-angle",
    "ace-2009-kneeling-cable-crunch"
  ],
