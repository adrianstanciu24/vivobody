{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "shoulder-horizontal-abduction-row",
  "name": "Shoulder-Height Row",
  "definition": "A strict compound horizontal pull at a canonical 90-degree upper-arm elevation whose concentric phase combines shoulder horizontal abduction, scapular retraction, and elbow flexion while the torso and lower body resist rather than propel the load. The admitted path is deliberately flared and transverse. Tucked or modest-scapular shoulder-extension rows, 60-degree mixed-path rows, straight-arm reverse flies, externally rotating face pulls, depressed-scapula low rows, diagonal overhead-start high rows, momentum rows, and unreviewed bodyweight setups remain outside this contract.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "fennell-2016-shoulder-retractor-row",
    "kara-2021-scapular-retraction-abduction-angle",
    "padovan-2025-seated-row-grip-width",
    "sakaki-2013-shoulder-movement-direction-emg",
    "vasconcelos-2023-seated-row-abduction-angle",
    "wattanaprakornkul-2011-rotator-cuff-bench-press-and-row",
    "youdas-2021-suspension-row"
  ],
  "fixed": {
    "mechanic": "compound",
    "pattern": "pull",
    "direction": "horizontal",
    "planes": [
      "transverse"
    ]
  },
  "groupPolicy": {
    "default": "shoulders",
    "allowed": [
      "shoulders"
    ]
  },
  "allowed": {
    "equipment": [
      "barbell",
      "dumbbell",
      "cable",
      "machine"
    ],
    "modalities": [
      "dynamicStrength"
    ],
    "trackingModes": [
