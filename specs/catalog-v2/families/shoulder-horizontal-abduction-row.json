  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether the distal segment moves freely or remains fixed.",
      "allowedValues": [
        "open"
      ]
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "description": "The torso and setup relationship during the shoulder-height row.",
      "allowedValues": [
        "hipHinged",
        "seated",
        "prone"
      ]
    },
    {
      "id": "lowerBodySupport",
      "valueType": "enum",
      "required": true,
      "description": "The lower-body contact that materially changes effective bodyweight loading; none because this family currently admits only external loads.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "The external surface directly supporting the anterior torso during the row.",
      "allowedValues": [
        "none",
        "bench",
        "machinePad"
      ]
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "description": "Whether external support limits scapular translation along the thorax; a chest support does not by itself constrain the posterior scapulae.",
      "allowedValues": [
        "free"
      ]
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "Canonical forearm and hand orientation through the working range.",
      "allowedValues": [
        "pronated",
        "neutral"
      ]
    },
    {
      "id": "relativeGripWidth",
      "valueType": "enum",
      "required": false,
      "description": "Bilateral working-hand spacing at the canonical concentric endpoint. Wide places the hands farther apart than the shoulder points; the field is absent for unilateral rows.",
      "allowedValues": [
        "wide"
      ]
    },
    {
      "id": "upperArmPath",
      "valueType": "enum",
      "required": true,
      "description": "The upper arm deliberately travels in a flared shoulder-height corridor rather than a tucked or modest scapular corridor.",
      "allowedValues": [
        "flared"
      ]
    },
    {
      "id": "upperArmElevationDegrees",
      "valueType": "number",
      "required": true,
      "description": "Upper-arm elevation away from the torso near the concentric endpoint; a position descriptor rather than a shoulder-abduction prime action.",
      "minimum": 90,
      "maximum": 90
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "description": "Whether rails or a lever constrain the external load path; distal fixation remains kineticChain."
    },
    {
      "id": "machineType",
      "valueType": "enum",
      "required": false,
      "description": "The machine mechanism when equipment is machine.",
      "allowedValues": [
        "leverRow"
      ]
    },
    {
      "id": "leverArmConfiguration",
      "valueType": "enum",
      "required": false,
      "description": "Whether the machine's left and right lever arms are mechanically linked or can move independently.",
      "allowedValues": [
        "linked",
        "independent"
      ]
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "description": "Whether hip, knee, or ankle drive contributes to the concentric pull.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "interRepSupport",
      "valueType": "enum",
      "required": true,
      "description": "Whether the load resets on an external support between repetitions.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "contralateralSupport",
      "valueType": "enum",
      "required": true,
      "description": "Whether the opposite side supports the body during the repetition.",
      "allowedValues": [
        "none"
      ]
    }
  ],
  "exerciseRules": [
    {
      "id": "machine-requires-fixed-path-and-type",
      "description": "Machine rows declare a constrained external-load path, the reviewed mechanism, and whether the lever arms are linked.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "machine"
      },
      "then": [
        { "field": "variant.fixedPath", "value": true }
      ],
      "requirePresent": [
        "variant.machineType",
        "variant.leverArmConfiguration"
      ],
      "requireAbsent": []
    },
    {
      "id": "non-machine-requires-free-path",
      "description": "Non-machine rows use a free external-load path and omit machine mechanism metadata.",
      "when": {
        "field": "equipment",
        "operator": "notEquals",
        "value": "machine"
      },
      "then": [
        { "field": "variant.fixedPath", "value": false }
      ],
      "requirePresent": [],
      "requireAbsent": [
        "variant.machineType",
        "variant.leverArmConfiguration"
      ]
    },
    {
      "id": "lever-row-is-supported-seated",
      "description": "A lever row is a seated machine-pad-supported machine without contralateral support.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "leverRow"
      },
      "then": [
        { "field": "equipment", "value": "machine" },
        { "field": "variant.bodyPosition", "value": "seated" },
        { "field": "variant.torsoSupport", "value": "machinePad" },
        { "field": "variant.contralateralSupport", "value": "none" }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "barbell-is-bilateral-unsupported-hip-hinged",
      "description": "A barbell shoulder-height row is bilateral, pronated, wide-grip, hip-hinged, unsupported, and free-path.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "barbell"
      },
      "then": [
        { "field": "laterality", "value": "bilateral" },
        { "field": "variant.bodyPosition", "value": "hipHinged" },
        { "field": "variant.torsoSupport", "value": "none" },
        { "field": "variant.gripOrientation", "value": "pronated" },
        { "field": "variant.relativeGripWidth", "value": "wide" },
        { "field": "variant.fixedPath", "value": false }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "dumbbell-is-bilateral-prone-bench-supported",
      "description": "A dumbbell shoulder-height row is bilateral, neutral-grip, wide at the concentric endpoint, prone, bench-supported, and free-path.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "dumbbell"
      },
      "then": [
        { "field": "laterality", "value": "bilateral" },
        { "field": "variant.bodyPosition", "value": "prone" },
        { "field": "variant.torsoSupport", "value": "bench" },
        { "field": "variant.gripOrientation", "value": "neutral" },
        { "field": "variant.relativeGripWidth", "value": "wide" },
        { "field": "variant.fixedPath", "value": false }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "cable-is-unsupported-seated-free-path",
      "description": "A cable shoulder-height row is seated without torso support and uses a pronated or neutral grip with a free path.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "cable"
      },
      "then": [
        { "field": "variant.bodyPosition", "value": "seated" },
        { "field": "variant.torsoSupport", "value": "none" },
        { "field": "variant.gripOrientation", "allowedValues": ["pronated", "neutral"] },
        { "field": "variant.fixedPath", "value": false }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "prone-is-supported-bilateral-dumbbell",
      "description": "A prone shoulder-height row is the bilateral bench-supported dumbbell branch.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "equals",
        "value": "prone"
      },
      "then": [
        { "field": "equipment", "value": "dumbbell" },
        { "field": "laterality", "value": "bilateral" },
        { "field": "variant.torsoSupport", "value": "bench" }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "bench-support-requires-prone-dumbbell",
      "description": "Bench torso support belongs only to a bilateral prone dumbbell shoulder-height row.",
      "when": {
        "field": "variant.torsoSupport",
        "operator": "equals",
        "value": "bench"
      },
      "then": [
        { "field": "equipment", "value": "dumbbell" },
        { "field": "laterality", "value": "bilateral" },
        { "field": "variant.bodyPosition", "value": "prone" }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "machine-pad-requires-lever-row",
      "description": "Machine-pad torso support belongs to a seated lever-row machine.",
      "when": {
        "field": "variant.torsoSupport",
        "operator": "equals",
        "value": "machinePad"
      },
      "then": [
        { "field": "equipment", "value": "machine" },
        { "field": "variant.machineType", "value": "leverRow" },
        { "field": "variant.bodyPosition", "value": "seated" }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "bilateral-requires-grip-width",
      "description": "A bilateral shoulder-height row declares its wide working-hand spacing at the concentric endpoint.",
      "when": {
        "field": "laterality",
        "operator": "equals",
        "value": "bilateral"
      },
      "then": [],
      "requirePresent": [
        "variant.relativeGripWidth"
      ],
      "requireAbsent": []
    },
    {
      "id": "unilateral-requires-asymmetric-control",
      "description": "A unilateral shoulder-height row uses cable or machine equipment, omits bilateral grip width, and declares oblique and pelvic control.",
      "when": {
        "field": "laterality",
        "operator": "equals",
        "value": "unilateral"
      },
      "then": [
        { "field": "equipment", "allowedValues": ["cable", "machine"] }
      ],
      "requirePresent": [],
      "requireAbsent": [
        "variant.relativeGripWidth"
      ],
      "requireInvolvement": [
        { "muscle": "obliques", "role": "stabilizer" }
      ],
      "requireAdditionalStabilityDemands": [
        "pelvis"
      ]
    },
    {
      "id": "hip-hinged-requires-posterior-chain-stability",
      "description": "A hip-hinged shoulder-height row declares spinal, pelvic, and hip stability with lower-back and gluteal stabilizers.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "equals",
        "value": "hipHinged"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        { "muscle": "lowerBack", "role": "stabilizer" },
        { "muscle": "gluteMax", "role": "stabilizer" }
      ],
      "requireAdditionalStabilityDemands": [
        "spine",
        "pelvis",
        "hip"
      ]
    },
    {
      "id": "unsupported-requires-trunk-stability",
      "description": "A shoulder-height row without direct torso support declares spinal stability and at least one reviewed trunk stabilizer.",
      "when": {
        "field": "variant.torsoSupport",
        "operator": "equals",
        "value": "none"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [],
      "requireMuscleRequirements": [
        {
          "anyOf": [
            "abs",
            "obliques",
            "lowerBack"
          ],
          "minimumRole": "stabilizer"
        }
      ],
      "requireAdditionalStabilityDemands": [
        "spine"
      ]
    },
    {
      "id": "linked-lever-arms-are-bilateral",
      "description": "A machine with mechanically linked left and right lever arms is authored only as a bilateral exercise.",
      "when": {
        "field": "variant.leverArmConfiguration",
        "operator": "equals",
        "value": "linked"
      },
      "then": [
        { "field": "equipment", "value": "machine" },
        { "field": "laterality", "value": "bilateral" }
      ],
      "requirePresent": [],
      "requireAbsent": []
    }
  ],
