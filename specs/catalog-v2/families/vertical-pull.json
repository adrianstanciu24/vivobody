{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "vertical-pull",
  "name": "Vertical Pull",
  "definition": "A strict compound pull in which the humerus travels down from an overhead position through shoulder adduction with a sagittal extension component, the scapula retracts, and the elbow flexes. The family covers front/scapular-path pull-ups, assisted pull-ups, cable pulldowns, and lever pulldowns without deliberate trunk or lower-body propulsion. Straight-arm pulldowns, scapular pull-ups, high rows, behind-neck pulldowns, kipping or butterfly pull-ups, muscle-ups, band-assisted pull-ups, and one-arm bodyweight pull-ups remain outside this contract.",
  "evidenceRefs": [
    "ackland-2008-shoulder-moment-arms",
    "andersen-2014-lat-pulldown-width",
    "buonsenso-2025-lat-pulldown-grips",
    "dinunzio-2019-strict-kipping-pullup",
    "doma-2013-chinup-lat-pulldown",
    "hewit-2018-pullup-alternatives",
    "lee-2025-scapular-load-direction",
    "lusk-2010-lat-pulldown-grip",
    "padovan-2024-lat-pulldown-front-back",
    "prinold-2016-pullup-scapular-kinematics",
    "youdas-2010-pullup-chinup"
  ],
  "fixed": {
    "mechanic": "compound",
    "pattern": "pull",
    "direction": "vertical",
    "planes": [
      "sagittal",
      "frontal"
    ]
  },
  "groupPolicy": {
    "default": "back",
    "allowed": [
      "back"
    ]
  },
  "allowed": {
    "equipment": [
      "bodyweight",
      "cable",
      "machine"
    ],
    "modalities": [
      "dynamicStrength"
    ],
    "trackingModes": [
      "reps"
    ],
    "loadModes": [
      "external",
      "bodyweightAdded",
      "assistanceSubtracted"
    ],
    "lateralities": [
      "bilateral",
      "unilateral"
    ]
  },
  "movementSignature": {
    "planeBasisActions": [
      "shoulder.extension",
      "shoulder.adduction"
    ],
    "primeActions": [
      {
        "action": "shoulder.extension",
        "condition": "fromFlexedPosition"
      },
      "shoulder.adduction",
      "scapula.retraction",
      "elbow.flexion"
    ],
    "forbiddenPrimeActions": [
      "shoulder.flexion",
      "shoulder.abduction",
      "shoulder.horizontalAdduction",
      "shoulder.horizontalAbduction",
      "elbow.extension",
      "spine.flexion",
      "spine.extension",
      "spine.lateralFlexion",
      "spine.rotation",
      "hip.flexion",
      "hip.extension",
      "knee.flexion",
      "knee.extension",
      "ankle.plantarflexion"
    ],
    "stabilityDemands": [
      "shoulder",
      "scapula",
      "spine",
      "wrist",
      "hand"
    ]
  },
  "musclePolicy": {
    "requirements": [
      {
        "anyOf": [
          "lats"
        ],
        "minimumRole": "primary"
      },
      {
        "anyOf": [
          "teresMajor"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "biceps"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "trapeziusMiddle",
          "trapeziusLower",
          "rhomboids"
        ],
        "minimumRole": "secondary"
      },
      {
        "anyOf": [
          "externalRotators"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "forearms"
        ],
        "minimumRole": "stabilizer"
      },
      {
        "anyOf": [
          "abs",
          "obliques",
          "lowerBack"
        ],
        "minimumRole": "stabilizer"
      }
    ],
    "allowedByRole": {
      "primary": [
        "lats"
      ],
      "secondary": [
        "teresMajor",
        "biceps",
        "trapeziusMiddle",
        "trapeziusLower",
        "rhomboids",
        "pectoralisMajorSternocostal",
        "deltoidPosterior"
      ],
      "stabilizer": [
        "externalRotators",
        "forearms",
        "abs",
        "obliques",
        "lowerBack",
        "subscapularis",
        "serratus",
        "trapeziusUpper",
        "pectoralisMinor"
      ]
    }
  },
  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether the distal segment moves freely or remains fixed.",
      "allowedValues": [
        "open",
        "closed"
      ]
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "description": "Whether the torso is seated below a moving implement or suspended below fixed hands.",
      "allowedValues": [
        "seated",
        "suspended"
      ]
    },
    {
      "id": "lowerBodySupport",
      "valueType": "enum",
      "required": true,
      "description": "The lower-body contact or support that materially changes effective bodyweight loading; none when no such contact participates.",
      "allowedValues": [
        "none",
        "thighPad",
        "assistancePlatform"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "The external surface directly supporting the torso during the pull.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "description": "Whether external posterior support limits scapular translation along the thorax; this does not classify scapular rotation or tilt.",
      "allowedValues": [
        "free"
      ]
    },
    {
      "id": "gripOrientation",
      "valueType": "enum",
      "required": true,
      "description": "Canonical forearm and hand orientation through the working range.",
      "allowedValues": [
        "pronated",
        "neutral",
        "supinated"
      ]
    },
    {
      "id": "relativeGripWidth",
      "valueType": "enum",
      "required": false,
      "description": "Categorical bilateral hand spacing relative to shoulder breadth; it is absent for unilateral exercises.",
      "allowedValues": [
        "shoulderWidth",
        "medium",
        "wide"
      ]
    },
    {
      "id": "pathConstraint",
      "valueType": "enum",
      "required": true,
      "description": "Whether the implement or body path is unconstrained, lever-guided, or guided by an assistance platform.",
      "allowedValues": [
        "free",
        "leverGuided",
        "assistancePlatformGuided"
      ]
    },
    {
      "id": "machineType",
      "valueType": "enum",
      "required": false,
      "description": "The machine mechanism when equipment is machine.",
      "allowedValues": [
        "leverPulldown",
        "assistedPullUp"
      ]
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "description": "Whether hip, knee, or ankle drive contributes to the concentric pull.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "pullPath",
      "valueType": "enum",
      "required": true,
      "description": "The canonical humeral and implement path relative to the head and torso.",
      "allowedValues": [
        "frontScapular"
      ]
    }
  ],
  "exerciseRules": [
    {
      "id": "bodyweight-is-strict-closed-chain",
      "description": "A bodyweight vertical pull suspends the full body below fixed hands without lower-body support or assistance.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "bodyweight"
      },
      "then": [
        {
          "field": "loadMode",
          "value": "bodyweightAdded"
        },
        {
          "field": "bodyweightFraction",
          "value": 1
        },
        {
          "field": "laterality",
          "value": "bilateral"
        },
        {
          "field": "variant.kineticChain",
          "value": "closed"
        },
        {
          "field": "variant.bodyPosition",
          "value": "suspended"
        },
        {
          "field": "variant.lowerBodySupport",
          "value": "none"
        },
        {
          "field": "variant.pathConstraint",
          "value": "free"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "cable-is-seated-free-path",
      "description": "A cable pulldown is an externally loaded open-chain pull performed seated beneath a thigh pad with a free handle or bar path.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "cable"
      },
      "then": [
        {
          "field": "loadMode",
          "value": "external"
        },
        {
          "field": "bodyweightFraction",
          "value": 0
        },
        {
          "field": "variant.kineticChain",
          "value": "open"
        },
        {
          "field": "variant.bodyPosition",
          "value": "seated"
        },
        {
          "field": "variant.lowerBodySupport",
          "value": "thighPad"
        },
        {
          "field": "variant.pathConstraint",
          "value": "free"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "machine-requires-type",
      "description": "Machine vertical pulls declare whether resistance comes from a lever pulldown or an assisted pull-up platform.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "machine"
      },
      "then": [],
      "requirePresent": [
        "variant.machineType"
      ],
      "requireAbsent": []
    },
    {
      "id": "non-machine-omits-machine-type",
      "description": "Bodyweight and cable exercises do not declare machine mechanism metadata.",
      "when": {
        "field": "equipment",
        "operator": "notEquals",
        "value": "machine"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [
        "variant.machineType"
      ]
    },
    {
      "id": "lever-pulldown-is-seated-guided-external",
      "description": "A lever pulldown is an externally loaded open-chain machine pull performed seated beneath a thigh pad on a lever-guided path.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "leverPulldown"
      },
      "then": [
        {
          "field": "equipment",
          "value": "machine"
        },
        {
          "field": "loadMode",
          "value": "external"
        },
        {
          "field": "bodyweightFraction",
          "value": 0
        },
        {
          "field": "variant.kineticChain",
          "value": "open"
        },
        {
          "field": "variant.bodyPosition",
          "value": "seated"
        },
        {
          "field": "variant.lowerBodySupport",
          "value": "thighPad"
        },
        {
          "field": "variant.pathConstraint",
          "value": "leverGuided"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "assisted-pullup-is-guided-subtractive",
      "description": "An assisted pull-up machine suspends the full body below fixed hands while a guided platform subtracts a declared external assistance load.",
      "when": {
        "field": "variant.machineType",
        "operator": "equals",
        "value": "assistedPullUp"
      },
      "then": [
        {
          "field": "equipment",
          "value": "machine"
        },
        {
          "field": "loadMode",
          "value": "assistanceSubtracted"
        },
        {
          "field": "bodyweightFraction",
          "value": 1
        },
        {
          "field": "laterality",
          "value": "bilateral"
        },
        {
          "field": "variant.kineticChain",
          "value": "closed"
        },
        {
          "field": "variant.bodyPosition",
          "value": "suspended"
        },
        {
          "field": "variant.lowerBodySupport",
          "value": "assistancePlatform"
        },
        {
          "field": "variant.pathConstraint",
          "value": "assistancePlatformGuided"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "bilateral-requires-grip-width",
      "description": "A bilateral vertical pull declares categorical hand spacing.",
      "when": {
        "field": "laterality",
        "operator": "equals",
        "value": "bilateral"
      },
      "then": [],
      "requirePresent": [
        "variant.relativeGripWidth"
      ],
      "requireAbsent": []
    },
    {
      "id": "unilateral-is-supported-cable-or-lever",
      "description": "A unilateral vertical pull is limited to a seated cable or lever machine, omits bilateral grip width, and declares asymmetric pelvic control.",
      "when": {
        "field": "laterality",
        "operator": "equals",
        "value": "unilateral"
      },
      "then": [
        {
          "field": "equipment",
          "allowedValues": [
            "cable",
            "machine"
          ]
        }
      ],
      "requirePresent": [],
      "requireAbsent": [
        "variant.relativeGripWidth"
      ],
      "requireAdditionalStabilityDemands": [
        "pelvis"
      ]
    },
    {
      "id": "suspended-requires-pelvic-control",
      "description": "A suspended strict pull explicitly declares pelvic stability even when an assistance platform guides the body path.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "equals",
        "value": "suspended"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [],
      "requireAdditionalStabilityDemands": [
        "pelvis"
      ]
    }
  ],
