{
  "$schema": "../family.schema.json",
  "schemaVersion": 1,
  "id": "elbow-extension",
  "name": "Elbow Extension",
  "definition": "A strict open-chain isolation movement in which the elbow extends while a reviewed upper-arm and forearm posture is held and shoulder, wrist, torso, and lower-body motion do not create the repetition. Triceps is the sole primary on every initial record: the reviewed shoulder positions inform length, excitation, and adaptation differences but do not justify head-specific categorical roles or a split of the aggregate triceps mesh. The roster admits only the directly reviewed unilateral supinated and pronated cable pushdowns, standing supinated overhead cable extension, seated overhead dumbbell extension, and supine dumbbell extension. Finger flexors author the static implement hold and extensor carpi radialis supplies mechanics-derived neutral-wrist counter-control. Scapular support, held-forearm control, and stabilizer assignments are bounded mechanics applications rather than variables directly compared in the triceps trials; brachioradialis is assigned only as a forearm stabilizer, never as an elbow-extension mover. The overhead cable source does not report its attachment, pulley height, or cable angle, so that record explicitly preserves an unreported cable interface.",
  "evidenceRefs": [
    "holzbaur-2005-upper-extremity",
    "alves-2018-triceps-shoulder-position",
    "maeo-2023-overhead-neutral-elbow-extension",
    "villalba-2024-pushdown-forearm-position"
  ],
  "fixed": {
    "mechanic": "isolation",
    "pattern": null,
    "direction": null,
    "planes": [
      "sagittal"
    ]
  },
