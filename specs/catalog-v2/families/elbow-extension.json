  "variantAxes": [
    {
      "id": "kineticChain",
      "valueType": "enum",
      "required": true,
      "description": "Whether the loaded hand moves freely or remains fixed to the environment.",
      "allowedValues": [
        "open"
      ]
    },
    {
      "id": "bodyPosition",
      "valueType": "enum",
      "required": true,
      "description": "The whole-body posture used by the reviewed elbow-extension fixture.",
      "allowedValues": [
        "standing",
        "seated",
        "supine"
      ]
    },
    {
      "id": "torsoSupport",
      "valueType": "enum",
      "required": true,
      "description": "The external surface directly supporting the torso; a seat without back contact is not torso support.",
      "allowedValues": [
        "none",
        "bench"
      ]
    },
    {
      "id": "scapularTranslation",
      "valueType": "enum",
      "required": true,
      "description": "Whether external posterior support limits scapular translation along the thorax; this does not name a dynamic scapular action.",
      "allowedValues": [
        "free",
        "supportConstrained"
      ]
    },
    {
      "id": "forearmSupport",
      "valueType": "enum",
      "required": true,
      "description": "The external surface supporting the forearm independently of torso support.",
      "allowedValues": [
        "none"
      ]
    },
    {
      "id": "upperArmPosition",
      "valueType": "enum",
      "required": true,
      "description": "The torso-relative upper-arm posture held while the elbow moves: anatomical side, 90 degrees of sagittal flexion, or 180-degree overhead flexion. A held posture does not add a shoulder prime action.",
      "allowedValues": [
        "atSide",
        "flexed90",
        "overhead"
      ]
    },
    {
      "id": "elbowMotion",
      "valueType": "enum",
      "required": true,
      "description": "The dynamic elbow action that creates the concentric repetition.",
      "allowedValues": [
        "extends"
      ]
    },
    {
      "id": "forearmMotion",
      "valueType": "enum",
      "required": true,
      "description": "Whether the radioulnar angle is held or changes deliberately during the repetition.",
      "allowedValues": [
        "angleHeld"
      ]
    },
    {
      "id": "forearmOrientation",
      "valueType": "enum",
      "required": true,
      "description": "The radioulnar posture held during elbow extension, independent of implement wording and dynamic forearm rotation.",
      "allowedValues": [
        "supinated",
        "neutral",
        "pronated"
      ]
    },
    {
      "id": "wristMotion",
      "valueType": "enum",
      "required": true,
      "description": "Whether wrist angle is held or changes deliberately during the repetition.",
      "allowedValues": [
        "angleHeld"
      ]
    },
    {
      "id": "wristPosture",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed wrist posture held during elbow extension; neutral is an authoring target rather than a zero-error measurement claim.",
      "allowedValues": [
        "neutral"
      ]
    },
    {
      "id": "handTask",
      "valueType": "enum",
      "required": true,
      "description": "The task performed by the fingers while the elbow creates the repetition.",
      "allowedValues": [
        "staticImplementHold"
      ]
    },
    {
      "id": "handleType",
      "valueType": "enum",
      "required": true,
      "description": "The reviewed load-to-hand interface used by the cable or dumbbell fixture.",
      "allowedValues": [
        "singleCableHandle",
        "unreportedCableInterface",
        "dumbbellHandle"
      ]
    },
    {
      "id": "resistanceGeometry",
      "valueType": "enum",
      "required": true,
      "description": "How the reviewed task creates elbow-extension resistance without implying a guided external path. highCablePushdown records Villalba's at-side pulley setup; overheadCableExtension identifies Maeo's 180-degree cable task but deliberately does not claim an unreported pulley height or cable angle; gravityLoadedDumbbell records the Alves fixtures.",
      "allowedValues": [
        "highCablePushdown",
        "overheadCableExtension",
        "gravityLoadedDumbbell"
      ]
    },
    {
      "id": "fixedPath",
      "valueType": "boolean",
      "required": true,
      "fixedValue": false,
      "description": "Whether rails or a lever machine constrain the external load path; cable direction alone is not a fixed path."
    },
    {
      "id": "lowerBodyContribution",
      "valueType": "enum",
      "required": true,
      "description": "Whether hip, knee, or ankle drive contributes to elbow extension.",
      "allowedValues": [
        "none"
      ]
    }
  ],
  "recommended": {
    "defaultReps": {
      "minimum": 8,
      "maximum": 20
    }
  },
  "exerciseRules": [
    {
      "id": "cable-extension-uses-reviewed-cable-interface",
      "description": "A cable extension uses the directly reported single handle or preserves the overhead study's unreported interface rather than inventing a dumbbell interface.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "cable"
      },
      "then": [
        {
          "field": "variant.handleType",
          "allowedValues": [
            "singleCableHandle",
            "unreportedCableInterface"
          ]
        },
        {
          "field": "variant.resistanceGeometry",
          "allowedValues": [
            "highCablePushdown",
            "overheadCableExtension"
          ]
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "dumbbell-extension-uses-dumbbell-handle",
      "description": "Every reviewed dumbbell extension uses a dumbbell handle rather than a cable interface.",
      "when": {
        "field": "equipment",
        "operator": "equals",
        "value": "dumbbell"
      },
      "then": [
        {
          "field": "variant.handleType",
          "value": "dumbbellHandle"
        },
        {
          "field": "variant.resistanceGeometry",
          "value": "gravityLoadedDumbbell"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "standing-extension-uses-reviewed-cable-setups",
      "description": "The reviewed standing branch uses an unsupported free-scapula cable setup with the upper arm at the side or overhead and the forearm supinated or pronated.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "equals",
        "value": "standing"
      },
      "then": [
        {
          "field": "equipment",
          "value": "cable"
        },
        {
          "field": "variant.torsoSupport",
          "value": "none"
        },
        {
          "field": "variant.scapularTranslation",
          "value": "free"
        },
        {
          "field": "variant.upperArmPosition",
          "allowedValues": [
            "atSide",
            "overhead"
          ]
        },
        {
          "field": "variant.forearmOrientation",
          "allowedValues": [
            "supinated",
            "pronated"
          ]
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "seated-extension-is-unsupported-overhead-dumbbell",
      "description": "The directly reviewed seated extension is an unsupported neutral-forearm overhead dumbbell fixture with free scapular translation.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "equals",
        "value": "seated"
      },
      "then": [
        {
          "field": "equipment",
          "value": "dumbbell"
        },
        {
          "field": "variant.torsoSupport",
          "value": "none"
        },
        {
          "field": "variant.scapularTranslation",
          "value": "free"
        },
        {
          "field": "variant.upperArmPosition",
          "value": "overhead"
        },
        {
          "field": "variant.forearmOrientation",
          "value": "neutral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "supine-extension-is-supported-flexed90-dumbbell",
      "description": "The directly reviewed lying extension is a neutral-forearm dumbbell fixture with the torso bench-supported and upper arm held at 90 degrees of shoulder flexion.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "equals",
        "value": "supine"
      },
      "then": [
        {
          "field": "equipment",
          "value": "dumbbell"
        },
        {
          "field": "variant.torsoSupport",
          "value": "bench"
        },
        {
          "field": "variant.scapularTranslation",
          "value": "supportConstrained"
        },
        {
          "field": "variant.upperArmPosition",
          "value": "flexed90"
        },
        {
          "field": "variant.forearmOrientation",
          "value": "neutral"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "pronated-extension-is-at-side-pushdown",
      "description": "The pronated orientation is admitted only in the directly reviewed standing at-side cable pushdown.",
      "when": {
        "field": "variant.forearmOrientation",
        "operator": "equals",
        "value": "pronated"
      },
      "then": [
        {
          "field": "variant.bodyPosition",
          "value": "standing"
        },
        {
          "field": "equipment",
          "value": "cable"
        },
        {
          "field": "variant.upperArmPosition",
          "value": "atSide"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "overhead-extension-uses-lower-trapezius-stability",
      "description": "The reviewed overhead setups use lower trapezius as the categorical scapular stabilizer.",
      "when": {
        "field": "variant.upperArmPosition",
        "operator": "equals",
        "value": "overhead"
      },
      "then": [
        {
          "field": "variant.resistanceGeometry",
          "allowedValues": [
            "overheadCableExtension",
            "gravityLoadedDumbbell"
          ]
        }
      ],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "trapeziusLower",
          "role": "stabilizer"
        }
      ]
    },
    {
      "id": "at-side-extension-uses-high-cable-resistance",
      "description": "Every admitted at-side extension is one of the reviewed high-cable pushdown fixtures.",
      "when": {
        "field": "variant.upperArmPosition",
        "operator": "equals",
        "value": "atSide"
      },
      "then": [
        {
          "field": "variant.resistanceGeometry",
          "value": "highCablePushdown"
        },
        {
          "field": "variant.handleType",
          "value": "singleCableHandle"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "overhead-cable-preserves-unreported-interface",
      "description": "Maeo reports the overhead cable task but not its attachment, pulley height, or cable angle, so the record preserves an unreported interface rather than manufacturing one.",
      "when": {
        "field": "variant.resistanceGeometry",
        "operator": "equals",
        "value": "overheadCableExtension"
      },
      "then": [
        {
          "field": "equipment",
          "value": "cable"
        },
        {
          "field": "variant.upperArmPosition",
          "value": "overhead"
        },
        {
          "field": "variant.handleType",
          "value": "unreportedCableInterface"
        }
      ],
      "requirePresent": [],
      "requireAbsent": []
    },
    {
      "id": "non-overhead-extension-uses-middle-trapezius-stability",
      "description": "The at-side and bench-supported non-overhead setups use middle trapezius as the categorical scapular stabilizer.",
      "when": {
        "field": "variant.upperArmPosition",
        "operator": "notEquals",
        "value": "overhead"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "trapeziusMiddle",
          "role": "stabilizer"
        }
      ]
    },
    {
      "id": "unsupported-extension-requires-trunk-control",
      "description": "Standing and unsupported seated extensions require explicit spine and pelvis stability with obliques assigned as a stabilizer.",
      "when": {
        "field": "variant.bodyPosition",
        "operator": "notEquals",
        "value": "supine"
      },
      "then": [],
      "requirePresent": [],
      "requireAbsent": [],
      "requireInvolvement": [
        {
          "muscle": "obliques",
          "role": "stabilizer"
        }
      ],
      "requireAdditionalStabilityDemands": [
        "spine",
        "pelvis"
      ]
    }
  ],
