---
import PhoneFrame from "../components/PhoneFrame.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Vivobody — Your workout. Nothing else.";
const description =
  "Focused iPhone workout tracking for starting, logging, resting, and understanding your training—all on-device.";

const moments = [
  {
    key: "start",
    label: "Start",
    word: "START",
    description: "See what is ready and begin without hunting through menus.",
  },
  {
    key: "log",
    label: "Log",
    word: "LOG",
    description: "Adjust weight and reps, then finish a set with one tap.",
  },
  {
    key: "rest",
    label: "Rest",
    word: "REST",
    description: "Let the next set come to you while the timer takes over.",
  },
  {
    key: "see",
    label: "See",
    word: "SEE",
    description: "Read the shape, balance, and meaning of your training.",
  },
];
---

<BaseLayout title={title} description={description} currentPath="/" bodyClass="home-minimal">
  <section class="landing-story" data-story-root data-phase="start" aria-labelledby="landing-title">
    <h1 id="landing-title" class="visually-hidden">Focused workout tracking for iPhone</h1>

    <div class="story-aura" aria-hidden="true"></div>

    <div class="story-words" aria-hidden="true">
      {
        moments.map((moment, index) => (
          <span class:list={["story-word", { "is-active": index === 0 }]} data-story-word={index}>
            {moment.word}
          </span>
        ))
      }
    </div>

    <div class="story-visual" aria-hidden="true">
      <PhoneFrame className="story-phone" eager={true}>
        <div slot="screen" class="story-media">
          <video
            class="story-video"
            data-story-video
            poster="/video/vivobody-demo-poster.jpg"
            autoplay
            muted
            playsinline
            loop
            preload="auto"
            disablepictureinpicture
          >
            <source src="/video/vivobody-demo.mp4" type="video/mp4" />
            <img
              class="story-fallback"
              src="/screens/body-status.jpg"
              alt=""
              width="1206"
              height="2622"
            />
          </video>
        </div>
      </PhoneFrame>
    </div>

    <div class="story-interface" id="app-store">
      <p class="story-positioning">Your workout. <em>Nothing else.</em></p>

      <div class="story-controls" role="group" aria-label="Preview Vivobody moments">
        {
          moments.map((moment, index) => (
            <button
              class:list={["story-control", { "is-active": index === 0 }]}
              type="button"
              data-story-control={index}
              aria-pressed={index === 0 ? "true" : "false"}
              aria-label={`${moment.label}: ${moment.description}`}
            >
              <span>{moment.label}</span>
            </button>
          ))
        }
      </div>

      <div class="story-meta">
        <p>No account <span aria-hidden="true">·</span> On-device</p>
        <nav aria-label="Information">
          <a href="/privacy/">Privacy</a>
          <a href="/support/">Support</a>
        </nav>
      </div>
    </div>

    <p class="visually-hidden" aria-live="polite" data-story-announcer>
      {moments[0].label}. {moments[0].description}
    </p>
  </section>

  <script>
    const storyRoot = document.querySelector("[data-story-root]");

    if (storyRoot) {
      const video = storyRoot.querySelector("[data-story-video]");
      const words = Array.from(storyRoot.querySelectorAll("[data-story-word]"));
      const controls = Array.from(storyRoot.querySelectorAll("[data-story-control]"));
      const announcer = storyRoot.querySelector("[data-story-announcer]");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const storyMoments = [
        ["start", "Start. See what is ready and begin without hunting through menus."],
        ["log", "Log. Adjust weight and reps, then finish a set with one tap."],
        ["rest", "Rest. Let the next set come to you while the timer takes over."],
        ["see", "See. Read the shape, balance, and meaning of your training."],
      ];
      const chapterDuration = 4.2;
      let currentMoment = -1;
      let animationFrame = 0;

      const showMoment = (index, announce = false) => {
        if (index === currentMoment && !announce) return;
        currentMoment = index;
        storyRoot.dataset.phase = storyMoments[index][0];

        words.forEach((word, wordIndex) => {
          word.classList.toggle("is-active", wordIndex === index);
        });
        controls.forEach((control, controlIndex) => {
          control.classList.remove("is-active");
          control.setAttribute("aria-pressed", controlIndex === index ? "true" : "false");
        });

        void storyRoot.offsetWidth;
        controls[index].classList.add("is-active");

        if (announce && announcer) {
          announcer.textContent = storyMoments[index][1];
        }
      };

      const syncStory = () => {
        if (!(video instanceof HTMLVideoElement)) return;

        const time = Number.isFinite(video.currentTime) ? video.currentTime : 0;
        const index = Math.min(storyMoments.length - 1, Math.floor(time / chapterDuration));
        const progress = (time - index * chapterDuration) / chapterDuration;

        showMoment(index);
        storyRoot.style.setProperty("--story-progress", String(Math.min(1, Math.max(0, progress))));
      };

      const animateStory = () => {
        if (!(video instanceof HTMLVideoElement)) return;

        if (!video.paused && !document.hidden) {
          syncStory();
          animationFrame = window.requestAnimationFrame(animateStory);
        }
      };

      const stopStorySync = () => {
        window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      };

      const startStorySync = () => {
        stopStorySync();
        syncStory();
        animateStory();
      };

      const applyMotionPreference = () => {
        if (!(video instanceof HTMLVideoElement)) return;

        stopStorySync();
        if (reduceMotion.matches || document.hidden) {
          video.pause();
          syncStory();
          return;
        }

        video.play().catch(syncStory);
      };

      controls.forEach((control, index) => {
        control.addEventListener("click", () => {
          if (video instanceof HTMLVideoElement) {
            video.currentTime = index * chapterDuration + 0.02;
          }
          showMoment(index, true);
          storyRoot.style.setProperty("--story-progress", "0");
          applyMotionPreference();
        });
      });

      if (video instanceof HTMLVideoElement) {
        video.addEventListener("loadedmetadata", syncStory);
        video.addEventListener("play", startStorySync);
        video.addEventListener("pause", stopStorySync);
        video.addEventListener("seeked", syncStory);
        video.addEventListener("timeupdate", syncStory);
      }

      document.addEventListener("visibilitychange", applyMotionPreference);
      reduceMotion.addEventListener("change", applyMotionPreference);
      showMoment(0);
      applyMotionPreference();
    }
  </script>
</BaseLayout>
