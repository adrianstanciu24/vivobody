---
interface Props {
  src?: string;
  alt?: string;
  className?: string;
  eager?: boolean;
}

const { src, alt = "", className = "", eager = false } = Astro.props;
---

<figure class:list={["phone-frame", className]}>
  <div class="phone-shell">
    <div class="phone-screen">
      {
        src ? (
          <img
            class="phone-screen-media"
            src={src}
            alt={alt}
            width="1206"
            height="2622"
            loading={eager ? "eager" : "lazy"}
            fetchpriority={eager ? "high" : "auto"}
            decoding="async"
          />
        ) : (
          <slot name="screen" />
        )
      }
    </div>
    <img
      class="phone-hardware"
      src="/device/iphone-17-pro-cosmic-orange.png"
      alt=""
      width="1350"
      height="2760"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding="async"
      aria-hidden="true"
    />
  </div>
</figure>
