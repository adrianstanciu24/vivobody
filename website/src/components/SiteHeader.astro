---
const { currentPath = "/" } = Astro.props;

const links = [
  { href: "/#features", label: "Features", match: "/" },
  { href: "/privacy/", label: "Privacy", match: "/privacy/" },
  { href: "/support/", label: "Support", match: "/support/" },
];
---

<header class="site-header">
  <div class="header-inner page-width">
    <a class="brand" href="/" aria-label="Vivobody home">
      <img src="/logo-mark.svg" alt="" width="30" height="29" />
      <span>Vivobody</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={currentPath === link.match ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a class="header-cta" href="/#download">
      <span>App Store</span>
      <span class="header-cta-status">Soon</span>
    </a>
  </div>
</header>
