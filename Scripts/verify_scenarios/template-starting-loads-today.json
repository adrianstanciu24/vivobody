{
  "name": "template-starting-loads-today",
  "launch": {
    "reset": true,
    "tab": "today",
    "arguments": [
      "--ui-test-template-starting-loads",
      "--ui-test-remembered-template-load",
      "--static-body",
      "-settings.appearance",
      "dark",
      "-settings.weightUnit",
      "lb"
    ]
  },
  "steps": [
    {
      "scrollTo": {
        "selector": {
          "identifier": "todayUpNextLastTime"
        },
        "direction": "up"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "todayUpNextPreview"
          }
        ],
        "forbidden": [
          {
            "labelContains": "Last used:"
          },
          {
            "labelContains": "Fixed:"
          },
          {
            "labelContains": "Starting load:"
          }
        ]
      }
    },
    {
      "tap": {
        "identifier": "todayUpNextPreview"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Barbell Bench Press, Chest",
            "role": "AXButton"
          }
        ],
        "forbidden": [
          {
            "labelContains": "Last used:"
          },
          {
            "labelContains": "Fixed:"
          },
          {
            "labelContains": "Starting load:"
          },
          {
            "labelContains": "3 × 8"
          }
        ]
      }
    }
  ],
  "required": [
    {
      "label": "Barbell Bench Press, Chest",
      "role": "AXButton"
    }
  ],
  "forbidden": [
    {
      "labelContains": "Last used:"
    },
    {
      "labelContains": "Fixed:"
    },
    {
      "labelContains": "Starting load:"
    },
    {
      "labelContains": "3 × 8"
    }
  ],
  "forbiddenLogs": [
    "event=storage.open outcome=fallback_memory"
  ]
}
