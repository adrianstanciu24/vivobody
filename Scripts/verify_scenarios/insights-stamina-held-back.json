{
  "name": "insights-stamina-held-back",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": [
      "--ui-test-insights-dimensions",
      "--static-body"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsShapeInstrument"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsStaminaLink"
        },
        "direction": "up",
        "maxSwipes": 40
      }
    }
  ],
  "required": [
    {
      "identifier": "insightsStaminaLink",
      "labelContains": "1 held-back series excluded"
    }
  ],
  "forbidden": [
    {
      "identifier": "exerciseStaminaTrend"
    }
  ]
}
