{
  "name": "insights-stamina-series-accessibility",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": [
      "--ui-test-insights-dimensions",
      "--static-body",
      "-settings.appearance",
      "light",
      "-UIPreferredContentSizeCategoryName",
      "UICTContentSizeCategoryAccessibilityXXXL"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsShapeInstrument"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsStaminaLink"
        },
        "direction": "up",
        "maxSwipes": 40
      }
    },
    {
      "tap": {
        "identifier": "insightsStaminaLink"
      }
    },
    {
      "wait": {
        "identifier": "staminaPatterns"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "staminaTypicalSets-push"
        },
        "direction": "up",
        "maxSwipes": 10
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "staminaTypicalSets-push",
            "labelContains": "Set 1, 10 reps from 8 series"
          }
        ]
      }
    }
  ],
  "required": [
    {
      "identifier": "staminaTypicalSets-push",
      "labelContains": "Set 1, 10 reps from 8 series"
    }
  ],
  "forbidden": [
    {
      "identifier": "exerciseStaminaTrend"
    },
    {
      "label": "Exercise series · all time"
    },
    {
      "identifier": "staminaExercise-bundled:barbell-bench-press"
    },
    {
      "label": "What counts"
    }
  ]
}
