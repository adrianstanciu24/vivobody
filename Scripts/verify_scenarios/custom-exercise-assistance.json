{
  "name": "custom-exercise-assistance",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--ui-test-custom-exercise-editor",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "New Exercise",
        "role": "AXHeading"
      }
    },
    {
      "swipe": {
        "direction": "down",
        "count": 1
      }
    },
    {
      "scrollTo": {
        "selector": {
          "label": "Load interpretation",
          "value": "External Load"
        },
        "direction": "up"
      }
    },
    {
      "tap": {
        "label": "Load interpretation",
        "value": "External Load"
      }
    },
    {
      "wait": {
        "label": "Assistance · Assisted pull-up/chin-up machine",
        "role": "AXButton"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "External Load",
            "role": "AXButton"
          },
          {
            "label": "Bodyweight + Load",
            "role": "AXButton"
          },
          {
            "label": "Assistance · Assisted pull-up/chin-up machine",
            "role": "AXButton"
          },
          {
            "label": "Non-comparable",
            "role": "AXButton"
          }
        ]
      }
    },
    {
      "tap": {
        "label": "Assistance · Assisted pull-up/chin-up machine",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "label": "Load interpretation",
        "value": "Assistance"
      }
    }
  ],
  "required": [
    {
      "label": "Load interpretation",
      "value": "Assistance"
    },
    {
      "label": "Bodyweight carried"
    }
  ]
}
