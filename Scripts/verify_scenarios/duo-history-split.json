{
  "name": "duo-history-split",
  "interfaceRotation": "counterclockwise",
  "launch": {
    "reset": true,
    "tab": "history",
    "arguments": [
      "--seed-history",
      "--static-body",
      "-settings.weightUnit",
      "lb",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "14880 pounds of volume"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "History",
            "role": "AXHeading"
          },
          {
            "label": "Session",
            "role": "AXHeading"
          },
          {
            "identifierContains": "historySessionRow",
            "labelContains": "14880 pounds of volume",
            "role": "AXButton"
          }
        ]
      }
    },
    {
      "tap": {
        "identifierContains": "historySessionRow",
        "labelContains": "14640 pounds of volume",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "label": "14640 pounds of volume"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "History",
            "role": "AXHeading"
          },
          {
            "identifierContains": "historySessionRow",
            "labelContains": "14880 pounds of volume",
            "role": "AXButton"
          }
        ],
        "forbidden": [
          {
            "label": "14880 pounds of volume"
          }
        ]
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1,
        "lane": {
          "label": "Session",
          "role": "AXHeading"
        }
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifierContains": "historySessionRow",
            "labelContains": "14880 pounds of volume",
            "role": "AXButton"
          }
        ],
        "forbidden": [
          {
            "label": "14640 pounds of volume"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifierContains": "historySessionRow",
          "labelContains": "10800 pounds of volume",
          "role": "AXButton"
        },
        "direction": "up",
        "maxSwipes": 6,
        "lane": {
          "label": "History",
          "role": "AXHeading"
        }
      }
    },
    {
      "tap": {
        "identifierContains": "historySessionRow",
        "labelContains": "10800 pounds of volume",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "label": "10800 pounds of volume"
      }
    }
  ],
  "required": [
    {
      "label": "History",
      "role": "AXHeading"
    },
    {
      "identifierContains": "historySessionRow",
      "labelContains": "10800 pounds of volume",
      "role": "AXButton"
    },
    {
      "identifier": "workoutLoadComparisonChart"
    }
  ],
  "forbidden": [
    {
      "identifier": "BackButton"
    }
  ],
  "forbiddenLogs": [
    "event=storage.open outcome=fallback_memory"
  ]
}
