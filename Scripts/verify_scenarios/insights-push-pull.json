{
  "name": "insights-push-pull",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": ["--ui-test-insights-showcase", "--pro"]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsShapeInstrument",
        "role": "AXHeading"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsBalanceInstrument",
          "role": "AXHeading"
        },
        "direction": "up",
        "maxSwipes": 40
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsBalanceAllLink"
        },
        "direction": "up"
      }
    },
    {
      "tap": {
        "identifier": "insightsBalanceAllLink"
      }
    },
    {
      "wait": {
        "identifier": "insightsBalanceAllInstrument",
        "role": "AXHeading"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsBalance-compound-push-pull"
        },
        "direction": "up"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "insightsBalance-compound-push-pull",
            "labelContains": "Compound Push"
          }
        ],
        "forbidden": []
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsBalance-isolation-push-pull"
        },
        "direction": "up"
      }
    }
  ],
  "required": [
    {
      "identifier": "insightsBalance-isolation-push-pull",
      "labelContains": "Isolation Push"
    }
  ],
  "forbidden": []
}
