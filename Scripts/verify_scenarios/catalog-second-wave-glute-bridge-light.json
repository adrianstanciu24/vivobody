{
  "name": "catalog-second-wave-glute-bridge-light",
  "launch": {
    "reset": false,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "light"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "tap": {
        "identifier": "libraryExerciseFilterLegs"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Single-Leg Bodyweight Glute Bridge,"
        },
        "direction": "up",
        "maxSwipes": 65
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "labelRegex": "^Single-Leg Bodyweight Glute Bridge,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH · REPS"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Single-Leg Bodyweight Glute Bridge"
          },
          {
            "labelContains": "Muscles used by Single-Leg Bodyweight Glute Bridge"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-how-to-perform"
        },
        "direction": "up",
        "maxSwipes": 12
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "identifier": "exercise-how-to-perform"
      }
    },
    {
      "wait": {
        "identifier": "exercise-execution-starting-position"
      }
    }
  ],
  "required": [
    {
      "identifier": "exercise-execution-starting-position"
    },
    {
      "labelContains": "hold both its hip and knee at 90 degrees"
    },
    {
      "labelContains": "mirrored training adaptation"
    }
  ],
  "forbidden": []
}
