{
  "name": "catalog-jump-rope-dark-accessibility",
  "launch": {
    "reset": false,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "dark",
      "-UIPreferredContentSizeCategoryName",
      "UICTContentSizeCategoryAccessibilityL"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "wait": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "tap": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "typeText": "Rope Skipping"
    },
    {
      "wait": {
        "labelRegex": "^Jump Rope,"
      }
    },
    {
      "tap": {
        "labelRegex": "^Jump Rope,"
      }
    },
    {
      "wait": {
        "label": "POWER / EXPLOSIVE"
      }
    }
  ],
  "required": [
    {
      "label": "Jump Rope"
    },
    {
      "labelContains": "Muscles used by Jump Rope"
    }
  ],
  "forbidden": []
}
