{
  "name": "catalog-exercise-consolidation-light",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "light"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "wait": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "tap": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "typeText": "reverse fly"
    },
    {
      "wait": {
        "labelRegex": "^Machine Reverse Fly,"
      }
    },
    {
      "assert": {
        "required": [
          {
            "labelRegex": "^Machine Reverse Fly,"
          }
        ],
        "forbidden": [
          {
            "labelRegex": "^Neutral-Grip Machine Reverse Fly,"
          },
          {
            "labelRegex": "^Pronated-Grip Machine Reverse Fly,"
          }
        ]
      }
    },
    {
      "relaunch": {
        "reset": false,
        "tab": "library",
        "arguments": [
          "--static-body",
          "-settings.appearance",
          "light"
        ]
      }
    },
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "wait": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "tap": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "typeText": "front raise"
    },
    {
      "wait": {
        "labelRegex": "^Front Raise,"
      }
    },
    {
      "assert": {
        "required": [
          {
            "labelRegex": "^Front Raise,"
          }
        ],
        "forbidden": [
          {
            "labelRegex": "^Single-Arm Dumbbell Front Raise,"
          },
          {
            "labelRegex": "^Two-Dumbbell Front Raise,"
          },
          {
            "labelRegex": "^Simultaneous Bilateral Dumbbell Front Raise,"
          }
        ]
      }
    },
    {
      "relaunch": {
        "reset": false,
        "tab": "library",
        "arguments": [
          "--static-body",
          "-settings.appearance",
          "light"
        ]
      }
    },
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "wait": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "tap": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "typeText": "split squat"
    },
    {
      "wait": {
        "labelRegex": "^Split Squat,"
      }
    },
    {
      "assert": {
        "required": [
          {
            "labelRegex": "^Split Squat,"
          },
          {
            "labelRegex": "^Bulgarian Split Squat,"
          }
        ],
        "forbidden": [
          {
            "labelRegex": "^Barbell Split Squat,"
          },
          {
            "labelRegex": "^Bodyweight Split Squat,"
          },
          {
            "labelRegex": "^Goblet Split Squat,"
          },
          {
            "labelRegex": "^Dumbbell Split Squat,"
          },
          {
            "labelRegex": "^Barbell Bulgarian Split Squat,"
          },
          {
            "labelRegex": "^Bodyweight Bulgarian Split Squat,"
          },
          {
            "labelRegex": "^Dumbbell Bulgarian Split Squat,"
          }
        ]
      }
    },
    {
      "relaunch": {
        "reset": false,
        "tab": "library",
        "arguments": [
          "--static-body",
          "-settings.appearance",
          "light"
        ]
      }
    },
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "wait": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "tap": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "typeText": "romanian deadlift"
    },
    {
      "wait": {
        "labelRegex": "^Romanian Deadlift,"
      }
    },
    {
      "assert": {
        "required": [
          {
            "labelRegex": "^Romanian Deadlift,"
          }
        ],
        "forbidden": [
          {
            "labelRegex": "^Barbell RDL (Floor Touch),"
          },
          {
            "labelRegex": "^Barbell Deficit RDL,"
          },
          {
            "labelRegex": "^Two-Dumbbell RDL (Continuous),"
          },
          {
            "labelRegex": "^Kettlebell RDL,"
          }
        ]
      }
    },
    {
      "relaunch": {
        "reset": false,
        "tab": "library",
        "arguments": [
          "--static-body",
          "-settings.appearance",
          "light"
        ]
      }
    },
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "wait": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "tap": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "typeText": "pull-up"
    },
    {
      "wait": {
        "labelRegex": "^Pull-Up,"
      }
    },
    {
      "assert": {
        "required": [
          {
            "labelRegex": "^Pull-Up,"
          }
        ],
        "forbidden": [
          {
            "labelRegex": "^Neutral-Grip Pull-Up,"
          },
          {
            "labelRegex": "^Wide-Grip Pull-Up,"
          }
        ]
      }
    },
    {
      "tap": {
        "labelRegex": "^Pull-Up,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH · REPS"
      }
    }
  ],
  "required": [
    {
      "label": "Pull-Up"
    },
    {
      "labelContains": "Muscles used by Pull-Up"
    }
  ],
  "forbidden": []
}
