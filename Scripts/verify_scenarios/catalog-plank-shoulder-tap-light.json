{
  "name": "catalog-plank-shoulder-tap-light",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": ["--static-body", "-settings.appearance", "light"]
  },
  "steps": [
    {"wait": {"label": "Exercises", "value": "Selected"}},
    {"tap": {"identifier": "libraryExerciseFilterCore"}},
    {"scrollTo": {"selector": {"labelRegex": "^High-Plank Shoulder Tap,"}, "direction": "up", "maxSwipes": 100}},
    {"tap": {"labelRegex": "^High-Plank Shoulder Tap,"}},
    {"wait": {"label": "STRENGTH · REPS"}}
  ],
  "required": [
    {"label": "High-Plank Shoulder Tap"},
    {"labelContains": "Muscles used by High-Plank Shoulder Tap"}
  ],
  "forbidden": []
}
