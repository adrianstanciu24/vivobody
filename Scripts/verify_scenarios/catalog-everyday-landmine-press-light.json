{
  "name": "catalog-everyday-landmine-press-light",
  "launch": {
    "reset": false,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "light"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "tap": {
        "identifier": "libraryExerciseFilterPush"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Standing Single-Arm Landmine Press,"
        },
        "direction": "up",
        "maxSwipes": 65
      }
    },
    {
      "tap": {
        "labelRegex": "^Standing Single-Arm Landmine Press,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH · REPS"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Standing Single-Arm Landmine Press"
          },
          {
            "labelContains": "Muscles used by Standing Single-Arm Landmine Press"
          }
        ],
        "forbidden": []
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-how-to-perform"
        },
        "direction": "up"
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "identifier": "exercise-how-to-perform"
      }
    },
    {
      "wait": {
        "identifier": "exercise-execution-movement"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exercise-execution-starting-position",
            "labelContains": "log only their combined weight"
          },
          {
            "identifier": "exercise-execution-movement",
            "labelContains": "pivoted arc under control"
          }
        ],
        "forbidden": []
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-execution-compensations"
        },
        "direction": "up"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exercise-execution-compensations",
            "labelContains": "push press"
          }
        ],
        "forbidden": []
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-execution-side-direction"
        },
        "direction": "up"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exercise-execution-side-direction",
            "labelContains": "Enter the added-plate load once"
          }
        ],
        "forbidden": []
      }
    }
  ],
  "required": [],
  "forbidden": []
}
