{
  "name": "catalog-russian-twist",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "tap": {
        "identifier": "libraryExerciseFilterCore"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Seated Medicine Ball Russian Twist,"
        },
        "direction": "up",
        "maxSwipes": 65
      }
    },
    {
      "tap": {
        "labelRegex": "^Seated Medicine Ball Russian Twist,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH · REPS"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Seated Medicine Ball Russian Twist"
          },
          {
            "labelContains": "Muscles used by Seated Medicine Ball Russian Twist"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-how-to-perform"
        },
        "direction": "up",
        "maxSwipes": 12
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "identifier": "exercise-how-to-perform"
      }
    },
    {
      "wait": {
        "identifier": "exercise-execution-movement"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exercise-execution-starting-position",
            "labelContains": "both feet flat"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-execution-side-direction"
        },
        "direction": "up",
        "maxSwipes": 12
      }
    }
  ],
  "required": [
    {
      "identifier": "exercise-execution-side-direction",
      "labelContains": "Count each completed side as one repetition"
    }
  ],
  "forbidden": []
}
