{
  "name": "today-up-next",
  "launch": {
    "reset": true,
    "tab": "today",
    "arguments": [
      "--ui-test-scheduled-template",
      "--static-body"
    ]
  },
  "steps": [
    {
      "scrollTo": {
        "selector": {
          "identifier": "todayUpNextLastTime"
        },
        "direction": "up",
        "maxSwipes": 4
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Up next",
            "role": "AXHeading"
          },
          {
            "label": "Barbell Bench Press, 2 \u00d7 8, Chest"
          },
          {
            "identifier": "todayUpNextLastTime",
            "label": "First time with this workout"
          },
          {
            "identifier": "todayStartWorkoutButton",
            "label": "Start Workout"
          }
        ],
        "forbidden": [
          {
            "labelContains": "Fixed:"
          },
          {
            "identifier": "todayPreviewPlan"
          },
          {
            "identifier": "todayPreviewHistory"
          }
        ]
      }
    },
    {
      "tap": {
        "identifier": "todayUpNextPreview"
      }
    },
    {
      "wait": {
        "labelContains": "Barbell Bench Press, 2 \u00d7 8 \u00b7 Fixed:"
      }
    },
    {
      "relaunch": {
        "reset": true,
        "tab": "today",
        "arguments": [
          "--ui-test-scheduled-template",
          "--seed-history",
          "--static-body"
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "todayUpNextLastTime"
        },
        "direction": "up"
      }
    },
    {
      "wait": {
        "identifier": "todayUpNextLastTime",
        "labelContains": "Last time, "
      }
    }
  ],
  "required": [
    {
      "identifier": "todayUpNextLastTime",
      "labelRegex": "^Last time, Today, 12 sets, 96 reps, \\d+ (pounds|kilograms) of volume$"
    },
    {
      "label": "Barbell Bench Press, 2 \u00d7 8, Chest"
    },
    {
      "identifier": "todayStartWorkoutButton",
      "label": "Start Workout"
    }
  ],
  "forbidden": [
    {
      "labelContains": "Fixed:"
    },
    {
      "identifier": "scheduledWorkoutStartButton"
    },
    {
      "identifier": "activeWorkoutResumeBar"
    },
    {
      "label": "Training load",
      "visible": false
    }
  ]
}
