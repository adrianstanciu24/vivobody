{
  "name": "custom-exercise-type",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--ui-test-custom-exercise-editor",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "New Exercise",
        "role": "AXHeading"
      }
    },
    {
      "swipe": {
        "direction": "down",
        "count": 1
      }
    },
    {
      "scrollTo": {
        "selector": {
          "label": "Exercise type",
          "value": "Strength · Reps"
        },
        "direction": "up"
      }
    },
    {
      "tap": {
        "label": "Exercise type",
        "value": "Strength · Reps"
      }
    },
    {
      "wait": {
        "label": "Strength · Hold",
        "role": "AXButton"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Strength · Reps",
            "role": "AXButton"
          },
          {
            "label": "Strength · Hold",
            "role": "AXButton"
          },
          {
            "label": "Power / Explosive",
            "role": "AXButton"
          }
        ],
        "forbidden": [
          {
            "label": "Conditioning"
          },
          {
            "label": "Mobility"
          }
        ]
      }
    },
    {
      "tap": {
        "label": "Strength · Hold",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "label": "Exercise type",
        "value": "Strength · Hold"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Exercise type",
            "value": "Strength · Hold"
          }
        ],
        "forbidden": [
          {
            "label": "Measure"
          },
          {
            "label": "Conditioning"
          },
          {
            "label": "Mobility"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "label": "1s",
          "role": "AXButton"
        },
        "direction": "up"
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "label": "1s",
        "role": "AXButton"
      }
    }
  ],
  "required": [
    {
      "label": "Hold step",
      "role": "AXGroup"
    },
    {
      "label": "10s",
      "role": "AXButton"
    },
    {
      "label": "Weight step",
      "role": "AXGroup"
    }
  ],
  "forbidden": [
    {
      "label": "Conditioning"
    },
    {
      "label": "Mobility"
    },
    {
      "label": "Measure"
    }
  ]
}
