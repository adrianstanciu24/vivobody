{
  "name": "custom-exercise-type",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--ui-test-custom-exercise-editor",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "scrollTo": {
        "selector": {
          "label": "Exercise type",
          "value": "Strength · Reps"
        },
        "direction": "up"
      }
    },
    {
      "tap": {
        "label": "Exercise type",
        "value": "Strength · Reps"
      }
    },
    {
      "wait": {
        "label": "Strength · Reps",
        "value": "Selected"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Strength · Reps",
            "value": "Selected"
          },
          {
            "label": "Strength · Hold",
            "value": "Not selected"
          },
          {
            "label": "Power / Explosive",
            "value": "Not selected"
          }
        ],
        "forbidden": [
          {
            "label": "Conditioning"
          },
          {
            "label": "Mobility"
          }
        ]
      }
    },
    {
      "tap": {
        "label": "Strength · Hold",
        "value": "Not selected"
      }
    },
    {
      "wait": {
        "label": "Exercise type",
        "value": "Strength · Hold"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Exercise type",
            "value": "Strength · Hold"
          }
        ],
        "forbidden": [
          {
            "label": "Measure"
          },
          {
            "label": "Conditioning"
          },
          {
            "label": "Mobility"
          }
        ]
      }
    }
  ],
  "required": [
    {
      "label": "Exercise type",
      "value": "Strength · Hold"
    }
  ],
  "forbidden": [
    {
      "label": "Conditioning"
    },
    {
      "label": "Mobility"
    },
    {
      "label": "Measure"
    }
  ]
}
