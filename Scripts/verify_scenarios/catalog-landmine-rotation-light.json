{
  "name": "catalog-landmine-rotation-light",
  "launch": {
    "reset": false,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "light"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "tap": {
        "identifier": "libraryExerciseFilterCore"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Standing Two-Hand Landmine Rotation,"
        },
        "direction": "up",
        "maxSwipes": 65
      }
    },
    {
      "tap": {
        "labelRegex": "^Standing Two-Hand Landmine Rotation,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH · REPS"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Standing Two-Hand Landmine Rotation"
          },
          {
            "labelContains": "Muscles used by Standing Two-Hand Landmine Rotation"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-how-to-perform"
        },
        "direction": "up",
        "maxSwipes": 12
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "identifier": "exercise-how-to-perform"
      }
    },
    {
      "wait": {
        "identifier": "exercise-execution-movement"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exercise-execution-starting-position",
            "labelContains": "Log only the added plates"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-execution-return"
        },
        "direction": "up",
        "maxSwipes": 12
      }
    }
  ],
  "required": [
    {
      "identifier": "exercise-execution-return",
      "labelContains": "complete one logged repetition"
    }
  ],
  "forbidden": []
}
