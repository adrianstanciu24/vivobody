{
  "name": "insights-muscle-directness",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": [
      "--ui-test-insights-dimensions",
      "--static-body"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsShapeInstrument"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsMuscleDirectnessLink"
        },
        "direction": "up",
        "maxSwipes": 40
      }
    },
    {
      "tap": {
        "identifier": "insightsMuscleDirectnessLink"
      }
    },
    {
      "wait": {
        "identifier": "muscleDirectnessRoster"
      }
    }
  ],
  "required": [
    {
      "identifier": "muscleDirectnessRoster",
      "role": "AXHeading",
      "label": "Muscle work"
    },
    {
      "label": "Targeted work",
      "role": "AXHeading"
    }
  ],
  "forbidden": [
    {
      "identifier": "insightsEmptyState"
    }
  ]
}
