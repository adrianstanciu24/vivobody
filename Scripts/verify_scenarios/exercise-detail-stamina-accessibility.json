{
  "name": "exercise-detail-stamina-accessibility",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--ui-test-insights-dimensions",
      "--static-body",
      "-settings.appearance",
      "light",
      "-UIPreferredContentSizeCategoryName",
      "UICTContentSizeCategoryAccessibilityXXXL"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelContains": "Barbell Bench Press, Barbell \u00b7 Horizontal Push"
        },
        "direction": "up",
        "maxSwipes": 20
      }
    },
    {
      "tap": {
        "labelContains": "Barbell Bench Press, Barbell \u00b7 Horizontal Push"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exerciseStaminaSection"
        },
        "direction": "up",
        "maxSwipes": 40
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exerciseStaminaSteps"
        },
        "direction": "up",
        "maxSwipes": 10
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exerciseStaminaSteps",
            "labelContains": "fewer reps on 16 of 16 set-to-set steps"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exerciseStaminaTypicalSets"
        },
        "direction": "up",
        "maxSwipes": 10
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exerciseStaminaTypicalSets",
            "labelContains": "Set 3, 7 reps from 8 series"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exerciseStaminaTrend"
        },
        "direction": "up",
        "maxSwipes": 15
      }
    }
  ],
  "required": [
    {
      "identifier": "exerciseStaminaTrend",
      "labelContains": "Set-series history. All time."
    }
  ],
  "forbidden": [
    {
      "identifier": "insightsEmptyState"
    },
    {
      "labelContains": "Unlock Vivobody Pro"
    },
    {
      "identifier": "exerciseStaminaTrace"
    },
    {
      "label": "What counts"
    }
  ]
}
