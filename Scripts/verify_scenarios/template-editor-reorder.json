{
  "name": "template-editor-reorder",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--seed-templates",
      "-settings.appearance",
      "dark",
      "-settings.weightUnit",
      "lb"
    ]
  },
  "steps": [
    {
      "tap": {
        "label": "Templates",
        "value": "Not selected"
      }
    },
    {
      "tap": {
        "labelContains": "Upper Day A",
        "labelRegex": "^(?!Start).*",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "label": "Cancel",
        "role": "AXButton"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "templateEditToggle",
          "label": "Edit"
        },
        "direction": "up"
      }
    },
    {
      "tap": {
        "identifier": "templateEditToggle",
        "label": "Edit"
      }
    },
    {
      "wait": {
        "identifier": "templateEditToggle",
        "label": "Done"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "templateEditToggle",
            "label": "Done"
          },
          {
            "labelContains": "Superset position A1",
            "labelRegex": ".*Barbell Bench Press.*"
          },
          {
            "labelContains": "Superset position A2",
            "labelRegex": ".*Barbell Bent-Over Row.*"
          },
          {
            "labelContains": "Seated Dumbbell Overhead Press"
          },
          {
            "labelContains": "Supinated Straight-Bar Cable Curl"
          }
        ],
        "forbidden": [
          {
            "label": "Add exercise",
            "role": "AXButton"
          },
          {
            "labelContains": "Link Barbell Bent-Over Row"
          }
        ]
      }
    },
    {
      "tapIn": {
        "selector": {
          "label": "Remove, Superset position A2, Barbell Bent-Over Row"
        },
        "xFraction": 0.07,
        "yFraction": 0.5
      }
    },
    {
      "tap": {
        "label": "Delete",
        "role": "AXButton"
      }
    },
    {
      "waitAbsent": {
        "labelContains": "Barbell Bent-Over Row"
      }
    }
  ],
  "required": [
    {
      "identifier": "templateEditToggle",
      "label": "Done"
    },
    {
      "label": "Remove, Barbell Bench Press"
    },
    {
      "labelContains": "Seated Dumbbell Overhead Press"
    },
    {
      "labelContains": "Supinated Straight-Bar Cable Curl"
    }
  ],
  "forbidden": [
    {
      "label": "Add exercise",
      "role": "AXButton"
    },
    {
      "labelContains": "Barbell Bent-Over Row"
    },
    {
      "labelContains": "Superset position"
    }
  ],
  "forbiddenLogs": [
    "event=storage.open outcome=fallback_memory"
  ]
}
