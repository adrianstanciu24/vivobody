{
  "name": "insights-movement-gaps",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": [
      "--ui-test-insights-dimensions",
      "--static-body",
      "--pro"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsShapeInstrument"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsMovementCoverageLink"
        },
        "direction": "up",
        "maxSwipes": 40
      }
    },
    {
      "tap": {
        "identifier": "insightsMovementCoverageLink"
      }
    },
    {
      "wait": {
        "identifier": "movementCoverageGaps"
      }
    },
    {
      "tap": {
        "label": "Frontal"
      }
    },
    {
      "wait": {
        "label": "Lateral Lunge"
      }
    }
  ],
  "required": [
    {
      "label": "Lateral Lunge"
    },
    {
      "label": "Suitcase Carry"
    },
    {
      "label": "Hip Abduction"
    },
    {
      "identifier": "movementCoverageGaps",
      "labelContains": "all time"
    }
  ],
  "forbidden": [
    {
      "identifier": "insightsEmptyState"
    }
  ]
}
