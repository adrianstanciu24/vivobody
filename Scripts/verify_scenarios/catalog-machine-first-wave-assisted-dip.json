{
  "name": "catalog-machine-first-wave-assisted-dip",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Machine-Assisted Dip,"
        },
        "direction": "up",
        "maxSwipes": 45
      }
    },
    {
      "tap": {
        "labelRegex": "^Machine-Assisted Dip,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH · REPS"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "label": "Movement",
          "valueContains": "compound"
        },
        "direction": "up"
      }
    }
  ],
  "required": [
    {
      "label": "Machine-Assisted Dip"
    },
    {
      "labelContains": "Muscles used by Machine-Assisted Dip"
    },
    {
      "label": "Movement",
      "valueContains": "compound"
    },
    {
      "label": "Movement",
      "valueContains": "push"
    }
  ],
  "forbidden": []
}
