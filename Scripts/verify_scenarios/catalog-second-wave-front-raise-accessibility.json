{
  "name": "catalog-second-wave-front-raise-accessibility",
  "launch": {
    "reset": false,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "dark",
      "-UIPreferredContentSizeCategoryName",
      "UICTContentSizeCategoryAccessibilityXXXL"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "tap": {
        "identifier": "libraryExerciseFilterPush"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Two-Dumbbell Front Raise,"
        },
        "direction": "up",
        "maxSwipes": 65
      }
    },
    {
      "tap": {
        "labelRegex": "^Two-Dumbbell Front Raise,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH · REPS"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Two-Dumbbell Front Raise"
          },
          {
            "labelContains": "Muscles used by Two-Dumbbell Front Raise"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-how-to-perform"
        },
        "direction": "up",
        "maxSwipes": 20
      }
    },
    {
      "tap": {
        "identifier": "exercise-how-to-perform"
      }
    },
    {
      "wait": {
        "identifier": "exercise-execution-starting-position"
      }
    }
  ],
  "required": [
    {
      "identifier": "exercise-execution-starting-position"
    },
    {
      "labelContains": "Log one dumbbell's weight, not the pair total"
    }
  ],
  "forbidden": []
}
