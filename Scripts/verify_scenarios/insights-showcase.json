{
  "name": "insights-showcase",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": [
      "--ui-test-insights-showcase"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsShapeInstrument",
        "role": "AXHeading"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Training signature. All-time volume split: Chest 13 percent, Back 21 percent, Shoulders 17 percent, Legs 22 percent, Arms 26 percent. Balance 88 percent, with 5 of 6 regions represented. Arms-led \u00b7 5 regions. Dashed outlines show an even six-way split.",
            "role": "AXGenericElement"
          },
          {
            "identifier": "insightsExerciseMixLink",
            "labelContains": "Other exercises",
            "role": "AXButton"
          }
        ],
        "forbidden": [
          {
            "identifierContains": "insightsMode"
          },
          {
            "identifier": "insightsEmptyState"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsRepMixLink"
        },
        "direction": "up"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "insightsRepMixLink",
            "labelContains": "Other rep ranges",
            "role": "AXButton"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsLoadInstrument",
          "role": "AXHeading"
        },
        "direction": "up",
        "maxSwipes": 16
      }
    },
    {
      "wait": {
        "identifier": "insightsLoadInstrument",
        "role": "AXHeading"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsRhythmInstrument",
          "role": "AXHeading"
        },
        "direction": "up",
        "maxSwipes": 16
      }
    },
    {
      "wait": {
        "identifier": "insightsRhythmInstrument",
        "role": "AXHeading"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsBalanceInstrument",
          "role": "AXHeading"
        },
        "direction": "up",
        "maxSwipes": 16
      }
    },
    {
      "wait": {
        "identifier": "insightsBalanceInstrument",
        "role": "AXHeading"
      }
    }
  ],
  "required": [
    {
      "identifier": "insightsBalanceInstrument",
      "role": "AXHeading"
    }
  ],
  "forbidden": [
    {
      "identifierContains": "insightsMode"
    },
    {
      "identifier": "insightsEmptyState"
    },
    {
      "identifier": "insightsLockedPreview"
    },
    {
      "identifier": "insightsUnlockButton"
    }
  ]
}
