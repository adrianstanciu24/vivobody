{
  "name": "insights-showcase",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": ["--ui-test-insights-showcase", "--pro"]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsShapeInstrument",
        "role": "AXHeading"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "insightsModeShape",
            "value": "Selected"
          },
          {
            "identifier": "insightsExerciseMixLink",
            "labelContains": "Other exercises",
            "role": "AXButton"
          },
          {
            "identifier": "insightsRepMixLink",
            "labelContains": "Other rep ranges",
            "role": "AXButton",
            "visible": false
          }
        ],
        "forbidden": [
          {
            "identifier": "insightsEmptyState"
          }
        ]
      }
    },
    {
      "tap": {
        "identifier": "insightsModeLoad"
      }
    },
    {
      "wait": {
        "identifier": "insightsLoadInstrument",
        "role": "AXHeading"
      }
    },
    {
      "tap": {
        "identifier": "insightsModeRhythm"
      }
    },
    {
      "wait": {
        "identifier": "insightsRhythmInstrument",
        "role": "AXHeading"
      }
    },
    {
      "tap": {
        "identifier": "insightsModeBalance"
      }
    },
    {
      "wait": {
        "identifier": "insightsBalanceInstrument",
        "role": "AXHeading"
      }
    },
    {
      "tap": {
        "identifier": "insightsModeShape"
      }
    }
  ],
  "required": [
    {
      "identifier": "insightsShapeInstrument",
      "role": "AXHeading"
    },
    {
      "label": "Training signature. All-time volume split: Chest 13 percent, Back 21 percent, Shoulders 17 percent, Legs 22 percent, Arms 26 percent. Balance 88 percent, with 5 of 6 regions represented. Arms-led · 5 regions. Dashed outlines show an even six-way split.",
      "role": "AXGenericElement"
    },
    {
      "identifier": "insightsModeShape",
      "value": "Selected"
    },
    {
      "identifier": "insightsExerciseMixLink",
      "labelContains": "Other exercises",
      "role": "AXButton"
    }
  ],
  "forbidden": [
    {
      "identifier": "insightsEmptyState"
    }
  ]
}
