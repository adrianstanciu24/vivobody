{
  "name": "library-training-role-filters",
  "launch": {
    "reset": true,
    "tab": "library"
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "tap": {
        "identifier": "libraryExerciseFilterPush"
      }
    },
    {
      "assert": {
        "required": [
          {
            "labelContains": "Flat Dumbbell Fly"
          },
          {
            "labelContains": "Decline Barbell Bench Press"
          }
        ],
        "forbidden": [
          {
            "labelContains": "Seated Diagonal Cable Pulldown"
          }
        ]
      }
    },
    {
      "tap": {
        "identifier": "libraryExerciseFilterPull"
      }
    },
    {
      "assert": {
        "required": [
          {
            "labelContains": "Seated Diagonal Cable Pulldown"
          },
          {
            "labelContains": "Standing Band Scapular Depression"
          }
        ],
        "forbidden": [
          {
            "labelContains": "Flat Dumbbell Fly"
          }
        ]
      }
    }
  ],
  "required": [
    {
      "identifier": "libraryExerciseFilterPull",
      "value": "Selected"
    },
    {
      "labelContains": "Seated Diagonal Cable Pulldown"
    },
    {
      "labelContains": "Standing Band Scapular Depression"
    }
  ],
  "forbidden": [
    {
      "labelContains": "Flat Dumbbell Fly"
    }
  ]
}
