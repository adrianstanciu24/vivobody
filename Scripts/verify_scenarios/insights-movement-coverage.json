{
  "name": "insights-movement-coverage",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": [
      "--ui-test-insights-dimensions",
      "--static-body"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsShapeInstrument"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsMovementCoverageCard"
        },
        "direction": "up",
        "maxSwipes": 40
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    }
  ],
  "required": [
    {
      "identifier": "insightsMovementCoverageCard",
      "labelContains": "All time"
    }
  ],
  "forbidden": [
    {
      "identifier": "insightsEmptyState"
    },
    {
      "identifier": "insightsMovementCoverageCard",
      "role": "AXButton"
    }
  ]
}
