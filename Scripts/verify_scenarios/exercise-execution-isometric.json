{
  "name": "exercise-execution-isometric",
  "launch": {
    "reset": true,
    "tab": "library"
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Not selected"
      }
    },
    {
      "tap": {
        "label": "Exercises",
        "value": "Not selected"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Side Plank,"
        },
        "direction": "up",
        "maxSwipes": 40
      }
    },
    {
      "tap": {
        "labelRegex": "^Side Plank,"
      }
    },
    {
      "wait": {
        "label": "Movement"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-how-to-perform"
        },
        "direction": "up"
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "identifier": "exercise-how-to-perform"
      }
    },
    {
      "wait": {
        "identifier": "exercise-execution-movement"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exercise-execution-starting-position"
          },
          {
            "identifier": "exercise-execution-movement",
            "labelContains": "straight line"
          },
          {
            "identifier": "exercise-execution-endpoint",
            "labelContains": "set time"
          }
        ],
        "forbidden": [
          {
            "identifier": "exercise-execution-return"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-execution-compensations"
        },
        "direction": "up"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exercise-execution-controlled-joints"
          },
          {
            "identifier": "exercise-execution-support-posture"
          },
          {
            "identifier": "exercise-execution-compensations",
            "labelContains": "turns the"
          },
          {
            "identifier": "exercise-execution-side-direction",
            "labelContains": "other side"
          }
        ],
        "forbidden": [
          {
            "identifier": "exercise-execution-return"
          }
        ]
      }
    }
  ],
  "required": [],
  "forbidden": []
}
