{
  "name": "catalog-plyometric-skater-jump-light-accessibility",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": ["--static-body", "-settings.appearance", "light", "-UIPreferredContentSizeCategoryName", "UICTContentSizeCategoryAccessibilityXXXL"]
  },
  "steps": [
    {"wait": {"label": "Exercises", "value": "Selected"}},
    {"wait": {"role": "AXTextField", "value": "Search exercises"}},
    {"tap": {"role": "AXTextField", "value": "Search exercises"}},
    {"typeText": "Skater Hop to Vertical Jump"},
    {"wait": {"labelRegex": "^Skater Hop to Vertical Jump,"}},
    {"tap": {"labelRegex": "^Skater Hop to Vertical Jump,"}},
    {"wait": {"label": "POWER / EXPLOSIVE"}}
  ],
  "required": [
    {"label": "Skater Hop to Vertical Jump"},
    {"labelContains": "Muscles used by Skater Hop to Vertical Jump"}
  ],
  "forbidden": []
}
