{
  "name": "catalog-must-have-expansion",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Barbell Clean and Jerk,"
        },
        "direction": "up",
        "maxSwipes": 40
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "labelRegex": "^Two-Dumbbell Forward Lunge,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH · REPS"
      }
    }
  ],
  "required": [
    {
      "label": "Two-Dumbbell Forward Lunge"
    },
    {
      "label": "STRENGTH · REPS"
    },
    {
      "labelContains": "Muscles used by Two-Dumbbell Forward Lunge"
    }
  ],
  "forbidden": []
}
