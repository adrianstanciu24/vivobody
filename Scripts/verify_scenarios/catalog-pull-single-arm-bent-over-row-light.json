{
  "name": "catalog-pull-single-arm-bent-over-row-light",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": ["--static-body", "-settings.appearance", "light"]
  },
  "steps": [
    {"wait": {"label": "Exercises", "value": "Selected"}},
    {"wait": {"role": "AXTextField", "value": "Search exercises"}},
    {"tap": {"role": "AXTextField", "value": "Search exercises"}},
    {"typeText": "One-Arm Dumbbell Row (Hand on Bench)"},
    {"wait": {"labelRegex": "^One-Arm Dumbbell Row \\(Hand on Bench\\), Dumbbell · Horizontal Pull"}},
    {"tap": {"labelRegex": "^One-Arm Dumbbell Row \\(Hand on Bench\\), Dumbbell · Horizontal Pull"}},
    {"wait": {"label": "STRENGTH · REPS"}}
  ],
  "required": [
    {"label": "One-Arm Dumbbell Row (Hand on Bench)"},
    {"labelContains": "Muscles used by One-Arm Dumbbell Row (Hand on Bench)"}
  ],
  "forbidden": []
}
