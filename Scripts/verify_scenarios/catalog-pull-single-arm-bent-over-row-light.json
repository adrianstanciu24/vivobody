    {"wait": {"role": "AXTextField", "value": "Search exercises"}},
    {"tap": {"role": "AXTextField", "value": "Search exercises"}},
    {"typeText": "Single-Arm Bent-Over Row"},
    {"wait": {"labelRegex": "^Single-Arm Bent-Over Row, Dumbbell · Horizontal Pull"}},
    {"tap": {"labelRegex": "^Single-Arm Bent-Over Row, Dumbbell · Horizontal Pull"}},
    {"wait": {"label": "STRENGTH · REPS"}}
  ],
  "required": [
    {"label": "Single-Arm Bent-Over Row"},
    {"labelContains": "Muscles used by Single-Arm Bent-Over Row"}
  ],
  "forbidden": []
}
