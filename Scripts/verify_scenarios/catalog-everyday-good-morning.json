{
  "name": "catalog-everyday-good-morning",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "tap": {
        "identifier": "libraryExerciseFilterBarbell"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Barbell Good Morning,"
        },
        "direction": "up",
        "maxSwipes": 65
      }
    },
    {
      "tap": {
        "labelRegex": "^Barbell Good Morning,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH · REPS"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Barbell Good Morning"
          },
          {
            "labelContains": "Muscles used by Barbell Good Morning"
          }
        ],
        "forbidden": []
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-how-to-perform"
        },
        "direction": "up"
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "identifier": "exercise-how-to-perform"
      }
    },
    {
      "wait": {
        "identifier": "exercise-execution-movement"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exercise-execution-starting-position",
            "labelContains": "approximately hip-width"
          },
          {
            "identifier": "exercise-execution-movement",
            "labelContains": "neutral and controlled"
          }
        ],
        "forbidden": []
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-execution-return"
        },
        "direction": "up"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exercise-execution-return",
            "labelContains": "bring your trunk back to upright"
          }
        ],
        "forbidden": []
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-execution-compensations"
        },
        "direction": "up"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "exercise-execution-controlled-joints",
            "labelContains": "heavier loads can increase knee excursion"
          },
          {
            "identifier": "exercise-execution-compensations",
            "labelContains": "controlled neutral back position"
          }
        ],
        "forbidden": [
          {
            "identifier": "exercise-execution-side-direction"
          }
        ]
      }
    }
  ],
  "required": [],
  "forbidden": []
}
