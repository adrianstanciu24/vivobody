{
  "name": "active-duration",
  "launch": {
    "reset": true,
    "tab": "today",
    "arguments": [
      "--ui-test-active-bodyweight-duration",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "activeWorkoutResumeBar",
        "role": "AXButton"
      }
    },
    {
      "tap": {
        "identifier": "activeWorkoutResumeBar",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "identifier": "completeSetButton",
        "role": "AXButton",
        "value": "not completed"
      }
    },
    {
      "wait": {
        "label": "Time increment",
        "role": "AXButton",
        "value": "5 seconds"
      }
    },
    {
      "tap": {
        "label": "Time increment",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "label": "Time increment",
        "role": "AXButton",
        "value": "10 seconds"
      }
    }
  ],
  "required": [
    {
      "label": "Time increment",
      "role": "AXButton",
      "value": "10 seconds"
    },
    {
      "label": "Weighted Hang Fixture"
    },
    {
      "label": "Hold",
      "role": "AXSlider"
    },
    {
      "label": "Bodyweight"
    },
    {
      "label": "Added load",
      "role": "AXSlider"
    },
    {
      "identifier": "completeSetButton",
      "role": "AXButton",
      "enabled": true
    }
  ],
  "forbidden": [
    {
      "label": "Reps left in the tank",
      "role": "AXSlider",
      "visible": true
    },
    {
      "label": "Weight increment",
      "visible": true
    }
  ],
  "forbiddenLogs": [
    "event=storage.open outcome=fallback_memory"
  ]
}
