{
  "name": "catalog-common-machines-light",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "light"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Life\\ Fitness\\ Insignia\\ Machine\\ Glute\\ Bridge,"
        },
        "direction": "up",
        "maxSwipes": 60
      }
    },
    {
      "tap": {
        "labelRegex": "^Life\\ Fitness\\ Insignia\\ Machine\\ Glute\\ Bridge,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH \u00b7 REPS"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Life Fitness Insignia Machine Glute Bridge"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelContains": "Muscles used by Life Fitness Insignia Machine Glute Bridge"
        },
        "direction": "up"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Primary.*Glute Max"
        },
        "direction": "up"
      }
    },
    {
      "assert": {
        "required": [
          {
            "labelRegex": "^Primary.*Glute Max"
          }
        ]
      }
    }
  ],
  "required": [],
  "forbidden": []
}
