{
  "name": "insights-rhythm-cadence",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": [
      "--ui-test-insights-dimensions",
      "--static-body"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsShapeInstrument"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsRhythmInstrument"
        },
        "direction": "up",
        "maxSwipes": 30
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    }
  ],
  "required": [
    {
      "identifier": "insightsRecentCadence",
      "labelContains": "workouts per week, last 4 weeks"
    },
    {
      "identifier": "insightsLifetimeCadence",
      "labelContains": "workouts per week, all time"
    }
  ]
}
