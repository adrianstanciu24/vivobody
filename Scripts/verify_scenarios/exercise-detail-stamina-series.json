{
  "name": "exercise-detail-stamina-series",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--ui-test-insights-dimensions",
      "--static-body"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelContains": "Barbell Bench Press, Barbell \u00b7 Horizontal Push"
        },
        "direction": "up",
        "maxSwipes": 20
      }
    },
    {
      "tap": {
        "labelContains": "Barbell Bench Press, Barbell \u00b7 Horizontal Push"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exerciseStaminaSection"
        },
        "direction": "up",
        "maxSwipes": 40
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exerciseStaminaSeriesLink"
        },
        "direction": "up",
        "maxSwipes": 15
      }
    },
    {
      "tap": {
        "identifier": "exerciseStaminaSeriesLink"
      }
    },
    {
      "tap": {
        "identifier": "exerciseStaminaLatestSeries"
      }
    },
    {
      "wait": {
        "identifier": "exerciseStaminaTrace"
      }
    }
  ],
  "required": [
    {
      "identifier": "exerciseStaminaTrace",
      "labelContains": "80 percent"
    }
  ],
  "forbidden": [
    {
      "identifier": "exerciseStaminaTrend"
    }
  ]
}
