{
  "name": "duo-library-split-accessibility",
  "interfaceRotation": "counterclockwise",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--ui-test-template-starting-loads",
      "--static-body",
      "-settings.weightUnit",
      "lb",
      "-settings.appearance",
      "dark",
      "-UIPreferredContentSizeCategoryName",
      "UICTContentSizeCategoryAccessibilityL"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "wait": {
        "role": "AXStaticText",
        "label": "Flat Dumbbell Fly"
      }
    },
    {
      "tap": {
        "role": "AXButton",
        "labelRegex": "^Standing Band Fly,"
      }
    },
    {
      "wait": {
        "role": "AXStaticText",
        "label": "Standing Band Fly"
      }
    },
    {
      "assert": {
        "forbidden": [
          {
            "role": "AXStaticText",
            "label": "Flat Dumbbell Fly"
          },
          {
            "identifier": "BackButton"
          }
        ]
      }
    },
    {
      "tap": {
        "label": "Templates",
        "value": "Not selected"
      }
    },
    {
      "wait": {
        "label": "Name",
        "role": "AXTextField"
      }
    }
  ],
  "required": [
    {
      "label": "Templates",
      "value": "Selected"
    },
    {
      "label": "Name",
      "role": "AXTextField"
    },
    {
      "labelContains": "Barbell Bench Press",
      "role": "AXButton"
    }
  ],
  "forbiddenLogs": [
    "event=storage.open outcome=fallback_memory"
  ],
  "forbidden": [
    {
      "role": "AXButton",
      "labelContains": "Start Workout"
    },
    {
      "identifier": "BackButton"
    }
  ]
}
