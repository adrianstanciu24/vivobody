{
  "name": "insights-locked",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": ["--ui-test-insights-showcase"]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsLockedPreview",
        "label": "Insights, locked",
        "role": "AXButton"
      }
    }
  ],
  "required": [
    {
      "identifier": "insightsUnlockButton",
      "role": "AXButton"
    },
    {
      "identifier": "insightsLockedPreview",
      "label": "Insights, locked",
      "role": "AXButton"
    }
  ],
  "forbidden": [
    {
      "identifierContains": "insightsMode"
    },
    {
      "identifier": "insightsLoadInstrument"
    },
    {
      "identifier": "insightsEmptyState"
    }
  ]
}
