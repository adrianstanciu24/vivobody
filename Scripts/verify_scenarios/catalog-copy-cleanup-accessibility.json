{
  "name": "catalog-copy-cleanup-accessibility",
  "launch": {
    "reset": false,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "light",
      "-UIPreferredContentSizeCategoryName",
      "UICTContentSizeCategoryAccessibilityL"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "wait": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "tap": {
        "role": "AXTextField",
        "value": "Search exercises"
      }
    },
    {
      "typeText": "Seated Single-Leg Machine Calf Raise"
    },
    {
      "wait": {
        "labelRegex": "^Seated Single-Leg Machine Calf Raise,"
      }
    },
    {
      "assert": {
        "required": [
          {
            "labelRegex": "^Seated Single-Leg Machine Calf Raise,"
          }
        ],
        "forbidden": []
      }
    },
    {
      "tap": {
        "labelRegex": "^Seated Single-Leg Machine Calf Raise,"
      }
    },
    {
      "wait": {
        "label": "Seated Single-Leg Machine Calf Raise"
      }
    },
    {
      "wait": {
        "label": "STRENGTH \u00b7 REPS"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-how-to-perform"
        },
        "direction": "up",
        "maxSwipes": 10
      }
    },
    {
      "tap": {
        "identifier": "exercise-how-to-perform"
      }
    },
    {
      "wait": {
        "identifier": "exercise-execution-starting-position"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-execution-controlled-joints"
        },
        "direction": "up",
        "maxSwipes": 10
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    }
  ],
  "required": [
    {
      "identifier": "exercise-execution-controlled-joints"
    },
    {
      "labelContains": "Keep the working knee bent near 90 degrees and hold your hip, pelvis, and back steady. Keep your toe posture and foot alignment unchanged, with the forefoot supported on the platform, as your heel rises and lowers."
    }
  ],
  "forbidden": [
    {
      "labelContains": "Keep the working knee bent near 90 degrees and hold the hip, pelvis, back, knee, and foot still."
    }
  ]
}
