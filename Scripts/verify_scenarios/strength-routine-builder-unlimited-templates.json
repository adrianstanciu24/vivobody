{
  "name": "strength-routine-builder-unlimited-templates",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--seed-templates",
      "--ui-test-strength-routine-builder"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "strengthRoutineBuilder"
      }
    },
    {
      "tap": {
        "identifier": "strengthRoutineEquipmentBarbell",
        "role": "AXButton"
      }
    },
    {
      "tap": {
        "identifier": "strengthRoutineEquipmentDumbbell",
        "role": "AXButton"
      }
    },
    {
      "tap": {
        "identifier": "strengthRoutineEquipmentCable",
        "role": "AXButton"
      }
    },
    {
      "tap": {
        "identifier": "strengthRoutineEquipmentMachine",
        "role": "AXButton"
      }
    },
    {
      "tap": {
        "identifier": "strengthRoutineBuild",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "identifier": "strengthRoutineSave",
        "role": "AXButton",
        "enabled": true
      }
    },
    {
      "tap": {
        "identifier": "strengthRoutineSave",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "label": "Templates",
        "value": "Not selected"
      }
    },
    {
      "tap": {
        "label": "Templates",
        "value": "Not selected"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelContains": "Full Body A"
        },
        "direction": "up"
      }
    },
    {
      "relaunch": {
        "reset": false,
        "tab": "library",
        "arguments": []
      }
    },
    {
      "wait": {
        "label": "Templates",
        "value": "Not selected"
      }
    },
    {
      "tap": {
        "label": "Templates",
        "value": "Not selected"
      }
    },
    {
      "wait": {
        "labelContains": "Lower Day B"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelContains": "Full Body A"
        },
        "direction": "up"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelContains": "Full Body C"
        },
        "direction": "up"
      }
    },
    {
      "assert": {
        "required": [
          {
            "labelContains": "Full Body C"
          }
        ]
      }
    }
  ],
  "required": [
    {
      "labelContains": "Full Body C"
    }
  ],
  "forbidden": [
    {
      "labelContains": "Unlock Vivobody Pro"
    }
  ],
  "forbiddenLogs": [
    "event=storage.open outcome=fallback_memory"
  ]
}
