{
  "name": "catalog-second-wave-bicycle-crunch",
  "launch": {
    "reset": false,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "tap": {
        "identifier": "libraryExerciseFilterCore"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Alternating Supine Bicycle Crunch,"
        },
        "direction": "up",
        "maxSwipes": 65
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "labelRegex": "^Alternating Supine Bicycle Crunch,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH · REPS"
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Alternating Supine Bicycle Crunch"
          },
          {
            "labelContains": "Muscles used by Alternating Supine Bicycle Crunch"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "exercise-how-to-perform"
        },
        "direction": "up",
        "maxSwipes": 12
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "identifier": "exercise-how-to-perform"
      }
    },
    {
      "wait": {
        "identifier": "exercise-execution-starting-position"
      }
    }
  ],
  "required": [
    {
      "identifier": "exercise-execution-starting-position"
    },
    {
      "labelContains": "Count each completed shoulder-to-opposite-knee curl as one repetition"
    }
  ],
  "forbidden": []
}
