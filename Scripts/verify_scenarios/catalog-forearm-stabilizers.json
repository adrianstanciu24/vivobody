          {
            "labelRegex": "^Stabilizer, .*Flexor Carpi Radialis.*Flexor Carpi Ulnaris.*Extensor Carpi Ulnaris.*Finger Extensors"
          },
          {
            "label": "Standing Dumbbell Overhead Press"
          }
        ],
        "forbidden": [
          {
            "labelRegex": "^(Primary|Secondary), .*Extensor Carpi Ulnaris"
          },
          {
            "labelRegex": "^(Primary|Secondary), .*Finger Extensors"
          },
          {
            "labelRegex": "^(Primary|Secondary), .*Flexor Carpi Radialis"
          },
          {
            "labelRegex": "^(Primary|Secondary), .*Flexor Carpi Ulnaris"
          }
        ]
      }
    }
  ],
  "required": [
    {
      "labelRegex": "^Stabilizer, .*Flexor Carpi Radialis.*Flexor Carpi Ulnaris.*Extensor Carpi Ulnaris.*Finger Extensors"
    },
    {
      "label": "Standing Dumbbell Overhead Press"
    }
  ],
  "forbidden": [
    {
      "labelRegex": "^(Primary|Secondary), .*Extensor Carpi Ulnaris"
    },
    {
      "labelRegex": "^(Primary|Secondary), .*Finger Extensors"
    },
    {
      "labelRegex": "^(Primary|Secondary), .*Flexor Carpi Radialis"
    },
    {
      "labelRegex": "^(Primary|Secondary), .*Flexor Carpi Ulnaris"
    }
  ]
}
