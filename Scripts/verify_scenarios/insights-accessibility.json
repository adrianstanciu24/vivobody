{
  "name": "insights-accessibility",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": [
      "--ui-test-insights-showcase",
      "--pro",
      "-UIPreferredContentSizeCategoryName",
      "UICTContentSizeCategoryAccessibilityL"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsShapeInstrument",
        "role": "AXHeading"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsLoadInstrument",
          "role": "AXHeading"
        },
        "direction": "up",
        "maxSwipes": 30
      }
    },
    {
      "wait": {
        "identifier": "insightsLoadInstrument",
        "role": "AXHeading"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsRhythmInstrument",
          "role": "AXHeading"
        },
        "direction": "up",
        "maxSwipes": 30
      }
    },
    {
      "wait": {
        "identifier": "insightsRhythmInstrument",
        "role": "AXHeading"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsBalanceInstrument",
          "role": "AXHeading"
        },
        "direction": "up",
        "maxSwipes": 30
      }
    },
    {
      "wait": {
        "identifier": "insightsBalanceInstrument",
        "role": "AXHeading"
      }
    }
  ],
  "required": [
    {
      "identifier": "insightsBalanceInstrument",
      "role": "AXHeading"
    }
  ],
  "forbidden": [
    {
      "identifierContains": "insightsMode"
    },
    {
      "identifier": "insightsEmptyState"
    }
  ]
}
