    {"tap": {"labelRegex": "^Box Jumps,"}},
    {"wait": {"label": "POWER / EXPLOSIVE"}}
  ],
  "required": [
    {"label": "Box Jumps"},
    {"labelContains": "Muscles used by Box Jumps"}
  ],
  "forbidden": []
}
