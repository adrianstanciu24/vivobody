{
  "name": "catalog-plyometric-box-jump-dark",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": ["--static-body", "-settings.appearance", "dark"]
  },
  "steps": [
    {"wait": {"label": "Exercises", "value": "Selected"}},
    {"wait": {"role": "AXTextField", "value": "Search exercises"}},
    {"tap": {"role": "AXTextField", "value": "Search exercises"}},
    {"typeText": "Box Jump"},
    {"wait": {"labelRegex": "^Box Jump,"}},
    {"tap": {"labelRegex": "^Box Jump,"}},
    {"wait": {"label": "POWER / EXPLOSIVE"}}
  ],
  "required": [
    {"label": "Box Jump"},
    {"labelContains": "Muscles used by Box Jump"}
  ],
  "forbidden": []
}
