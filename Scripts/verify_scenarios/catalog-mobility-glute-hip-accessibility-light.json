{
  "name": "catalog-mobility-glute-hip-accessibility-light",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "light",
      "-UIPreferredContentSizeCategoryName",
      "UICTContentSizeCategoryAccessibilityL"
    ]
  },
  "steps": [
    {"wait": {"label": "Exercises", "value": "Selected"}},
    {"wait": {"role": "AXTextField", "value": "Search exercises"}},
    {"tap": {"role": "AXTextField", "value": "Search exercises"}},
    {"typeText": "Above-Knee Band Lateral Walk"},
    {"wait": {"labelRegex": "^Above-Knee Band Lateral Walk, Band · Legs"}},
    {"tap": {"labelRegex": "^Above-Knee Band Lateral Walk, Band · Legs"}},
    {"wait": {"label": "STRENGTH · REPS"}}
  ],
  "required": [
    {"label": "Above-Knee Band Lateral Walk"},
    {"labelContains": "Muscles used by Above-Knee Band Lateral Walk"}
  ],
  "forbidden": []
}
