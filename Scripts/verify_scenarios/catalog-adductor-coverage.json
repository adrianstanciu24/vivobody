{
  "name": "catalog-adductor-coverage",
  "launch": {
    "reset": false,
    "tab": "library",
    "arguments": [
      "--static-body",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Supported Standing Cable Hip Adduction,"
        },
        "direction": "up",
        "maxSwipes": 60
      }
    },
    {
      "tap": {
        "labelRegex": "^Supported Standing Cable Hip Adduction,"
      }
    },
    {
      "wait": {
        "label": "STRENGTH \u00b7 REPS"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelRegex": "^Secondary, (?=.*Adductor Magnus)(?=.*Pectineus)(?=.*Gracilis)"
        },
        "direction": "up",
        "maxSwipes": 8
      }
    }
  ],
  "required": [
    {
      "label": "Primary, Adductor Longus / Brevis"
    },
    {
      "labelRegex": "^Secondary, (?=.*Adductor Magnus)(?=.*Pectineus)(?=.*Gracilis)"
    }
  ],
  "forbidden": [
    {
      "labelRegex": "^Primary, .*Pectineus"
    }
  ]
}
