{
  "name": "insights-muscle-directness-light",
  "launch": {
    "reset": true,
    "tab": "insights",
    "arguments": [
      "--ui-test-insights-dimensions",
      "--static-body",
      "--pro",
      "-settings.appearance",
      "light"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "insightsShapeInstrument"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "insightsMuscleDirectnessLink"
        },
        "direction": "up",
        "maxSwipes": 40
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 2
      }
    }
  ],
  "required": [
    {
      "identifier": "insightsMuscleDirectnessLink",
      "role": "AXButton",
      "labelContains": "All time"
    }
  ],
  "forbidden": [
    {
      "identifier": "insightsEmptyState"
    }
  ]
}
