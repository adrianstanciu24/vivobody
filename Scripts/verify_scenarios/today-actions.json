{
  "name": "today-actions",
  "launch": {
    "reset": true,
    "tab": "today",
    "arguments": [
      "--static-body"
    ]
  },
  "steps": [
    {
      "wait": {
        "identifier": "todayStartWorkoutButton",
        "label": "Start Fresh Workout",
        "role": "AXButton"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "todayStartWorkoutButton",
            "label": "Start Fresh Workout",
            "role": "AXButton"
          }
        ],
        "forbidden": [
          {
            "identifier": "scheduledWorkoutStartButton"
          },
          {
            "identifier": "activeWorkoutResumeBar"
          },
          {
            "identifier": "scheduledWorkoutOptionsButton"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "todayUpNextPlaceholder"
        },
        "direction": "up",
        "maxSwipes": 4
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "todayUpNextPlaceholder",
            "label": "Up next. No workout planned. Schedule a template in Library to see it here.",
            "role": "AXGenericElement"
          },
          {
            "identifier": "todayStartWorkoutButton",
            "label": "Start Fresh Workout",
            "role": "AXButton"
          }
        ],
        "forbidden": [
          {
            "identifier": "todayUpNextPreview"
          }
        ]
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "todayLastWorkoutPlaceholder"
        },
        "direction": "up",
        "maxSwipes": 6
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "todayConsistencyOverview",
            "label": "Training consistency",
            "role": "AXGenericElement",
            "value": "0 sessions in the last 14 days"
          },
          {
            "label": "Last workout",
            "role": "AXHeading"
          },
          {
            "identifier": "todayLastWorkoutPlaceholder",
            "label": "No workouts yet. Finish a workout to see its time, volume, and sets.",
            "role": "AXGenericElement"
          },
          {
            "identifier": "todayStartWorkoutButton",
            "label": "Start Fresh Workout",
            "role": "AXButton"
          }
        ]
      }
    },
    {
      "tap": {
        "identifier": "todayStartWorkoutButton",
        "label": "Start Fresh Workout",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "identifier": "Add Exercise",
        "role": "AXGroup"
      }
    },
    {
      "relaunch": {
        "reset": true,
        "tab": "today",
        "arguments": [
          "--seed-history",
          "--static-body"
        ]
      }
    },
    {
      "wait": {
        "identifier": "todayStartWorkoutButton",
        "label": "Start Workout",
        "role": "AXButton"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "label": "Last workout",
          "role": "AXHeading"
        },
        "direction": "up",
        "maxSwipes": 6
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "todayConsistencyOverview",
            "label": "Training consistency",
            "role": "AXGenericElement",
            "valueRegex": "^[1-9]\\d* sessions? in the last 14 days\\. Training days: .+"
          }
        ],
        "forbidden": [
          {
            "identifier": "todayLastWorkoutPlaceholder"
          },
          {
            "identifier": "todayLastWorkoutPlaceholder",
            "visible": false
          }
        ]
      }
    },
    {
      "tap": {
        "identifier": "todayStartWorkoutButton",
        "label": "Start Workout",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "label": "Repeat Last Workout",
        "role": "AXButton"
      }
    },
    {
      "relaunch": {
        "reset": true,
        "tab": "today",
        "arguments": [
          "--ui-test-scheduled-template",
          "--static-body"
        ]
      }
    },
    {
      "wait": {
        "identifier": "todayStartWorkoutButton",
        "label": "Start Workout",
        "role": "AXButton"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "todayUpNextPreview"
        },
        "direction": "up",
        "maxSwipes": 4
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "todayStartWorkoutButton",
            "label": "Start Workout",
            "role": "AXButton"
          }
        ],
        "forbidden": [
          {
            "identifier": "scheduledWorkoutStartButton"
          },
          {
            "identifier": "activeWorkoutResumeBar"
          },
          {
            "identifier": "scheduledWorkoutOptionsButton"
          },
          {
            "identifier": "todayUpNextPlaceholder"
          },
          {
            "identifier": "todayUpNextPlaceholder",
            "visible": false
          }
        ]
      }
    },
    {
      "tap": {
        "identifier": "todayStartWorkoutButton",
        "label": "Start Workout",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "identifier": "scheduledWorkoutStartButton",
        "label": "Start today's plan, Scheduled Test",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "label": "Start Fresh",
        "role": "AXButton"
      }
    },
    {
      "tap": {
        "label": "Start Fresh",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "identifier": "Add Exercise",
        "role": "AXGroup"
      }
    },
    {
      "relaunch": {
        "reset": true,
        "tab": "today",
        "arguments": [
          "--ui-test-active-partial",
          "--ui-test-scheduled-template",
          "--static-body"
        ]
      }
    },
    {
      "wait": {
        "identifier": "activeWorkoutResumeBar",
        "labelContains": "Resume Workout",
        "role": "AXButton"
      }
    },
    {
      "assert": {
        "required": [
          {
            "identifier": "activeWorkoutResumeBar",
            "labelContains": "Resume Workout",
            "role": "AXButton"
          }
        ],
        "forbidden": [
          {
            "identifier": "scheduledWorkoutStartButton"
          },
          {
            "identifier": "todayStartWorkoutButton"
          },
          {
            "identifier": "scheduledWorkoutOptionsButton"
          },
          {
            "identifier": "todayUpNextPlaceholder"
          },
          {
            "identifier": "todayUpNextPlaceholder",
            "visible": false
          },
          {
            "identifier": "todayUpNextPreview"
          },
          {
            "identifier": "todayUpNextPreview",
            "visible": false
          }
        ]
      }
    },
    {
      "tap": {
        "identifier": "activeWorkoutResumeBar",
        "labelContains": "Resume Workout",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "identifier": "endWorkoutButton",
        "role": "AXButton"
      }
    },
    {
      "relaunch": {
        "reset": false,
        "tab": "today",
        "arguments": [
          "--static-body"
        ]
      }
    }
  ],
  "required": [
    {
      "identifier": "activeWorkoutResumeBar",
      "labelContains": "Resume Workout",
      "role": "AXButton"
    }
  ],
  "forbidden": [
    {
      "identifier": "scheduledWorkoutStartButton"
    },
    {
      "identifier": "todayStartWorkoutButton"
    },
    {
      "identifier": "scheduledWorkoutOptionsButton"
    }
  ]
}
