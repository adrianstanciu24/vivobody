    {
      "assert": {
        "required": [
          {
            "label": "Sounds",
            "role": "AXCheckBox",
            "value": "0"
          }
        ]
      }
    },
    {
      "tap": {
        "label": "Sounds",
        "role": "AXCheckBox"
      }
    },
    {
      "wait": {
        "label": "Sounds",
        "role": "AXCheckBox",
        "value": "1"
