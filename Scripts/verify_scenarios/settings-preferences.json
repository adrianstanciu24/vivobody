        "label": "Settings",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "labelContains": "Unlock Vivobody Pro",
        "role": "AXButton"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "label": "Haptics",
          "role": "AXCheckBox"
        },
        "direction": "up",
        "maxSwipes": 6
      }
    },
    {
      "swipe": {
