{
  "name": "settings-preferences",
  "launch": {
    "reset": true,
    "tab": "me",
    "arguments": [
      "--static-body",
      "--no-iap",
      "-settings.hapticsEnabled",
      "YES",
      "-settings.soundsEnabled",
      "YES"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Settings",
        "role": "AXButton"
      }
    },
    {
      "tap": {
        "label": "Settings",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "labelContains": "Unlock Vivobody Pro",
        "role": "AXButton"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "label": "Haptics",
          "role": "AXCheckBox"
        },
        "direction": "up",
        "maxSwipes": 6
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Haptics",
            "role": "AXCheckBox",
            "value": "1"
          }
        ]
      }
    },
    {
      "tap": {
        "label": "Haptics",
        "role": "AXCheckBox"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "label": "Sounds",
          "role": "AXCheckBox"
        },
        "direction": "up",
        "maxSwipes": 3
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Sounds",
            "role": "AXCheckBox",
            "value": "1"
          }
        ]
      }
    },
    {
      "tap": {
        "label": "Sounds",
        "role": "AXCheckBox"
      }
    },
    {
      "relaunch": {
        "reset": false,
        "tab": "me",
        "arguments": [
          "--static-body",
          "--no-iap"
        ]
      }
    },
    {
      "wait": {
        "label": "Settings",
        "role": "AXButton"
      }
    },
    {
      "tap": {
        "label": "Settings",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "labelContains": "Unlock Vivobody Pro",
        "role": "AXButton"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "label": "Haptics",
          "role": "AXCheckBox"
        },
        "direction": "up",
        "maxSwipes": 6
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "assert": {
        "required": [
          {
            "label": "Haptics",
            "role": "AXCheckBox",
            "value": "0"
          }
        ]
      }
    },
    {
      "tap": {
        "label": "Haptics",
        "role": "AXCheckBox"
      }
    },
    {
      "wait": {
        "label": "Haptics",
        "role": "AXCheckBox",
        "value": "1"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "label": "Sounds",
          "role": "AXCheckBox"
        },
        "direction": "up",
        "maxSwipes": 3
      }
