        },
        "direction": "up",
        "maxSwipes": 4
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "labelContains": "Reset Exercise Catalog",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "label": "Cancel",
