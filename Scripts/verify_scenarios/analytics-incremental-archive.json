{
  "name": "analytics-incremental-archive",
  "launch": {
    "reset": true,
    "tab": "today",
    "arguments": [
      "--ui-test-active-complete-summary",
      "--ui-test-widget-start-request",
      "--seed-history",
      "--static-body",
      "-settings.weightUnit",
      "lb",
      "-settings.appearance",
      "dark"
    ]
  },
  "steps": [
    {
      "scrollTo": {
        "selector": {
          "identifier": "workoutLoadComparisonChart",
          "label": "Workout load comparison",
          "valueContains": "across 10 comparable workouts"
        },
        "direction": "up",
        "maxSwipes": 20
      }
    },
    {
      "scrollTo": {
        "selector": {
          "label": "Finish workout and return to home",
          "role": "AXButton"
        },
        "direction": "up",
        "maxSwipes": 20
      }
    },
    {
      "swipe": {
        "direction": "up",
        "count": 1
      }
    },
    {
      "tap": {
        "label": "Finish workout and return to home",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "identifier": "todayStartWorkoutButton",
        "role": "AXButton"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "identifier": "todayConsistencyOverview",
          "valueContains": "9 sessions in the last 14 days"
        },
        "direction": "up",
        "maxSwipes": 30
      }
    },
    {
      "wait": {
        "identifier": "todayConsistencyOverview",
        "valueContains": "9 sessions in the last 14 days"
      }
    }
  ],
  "required": [
    {
      "identifier": "todayConsistencyOverview",
      "valueContains": "9 sessions in the last 14 days"
    }
  ],
  "forbidden": [],
  "requiredLogs": [
    "event=session.transition kind=archive outcome=success",
    "event=analytics.snapshot_refresh rebuilt_sessions=1 mode=delta outcome=changed"
  ],
  "forbiddenLogs": [
    "event=storage.open outcome=fallback_memory"
  ]
}
