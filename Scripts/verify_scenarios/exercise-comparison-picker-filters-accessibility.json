{
  "name": "exercise-comparison-picker-filters-accessibility",
  "launch": {
    "reset": true,
    "tab": "library",
    "arguments": [
      "-UIPreferredContentSizeCategoryName",
      "UICTContentSizeCategoryAccessibilityL"
    ]
  },
  "steps": [
    {
      "wait": {
        "label": "Exercises",
        "value": "Selected"
      }
    },
    {
      "scrollTo": {
        "selector": {
          "labelContains": "Barbell Bench Press, Barbell · Horizontal Push"
        },
        "direction": "up"
      }
    },
    {
      "tap": {
        "labelContains": "Barbell Bench Press, Barbell · Horizontal Push"
      }
    },
    {
      "tapAt": {
        "xFraction": 0.89,
        "yFraction": 0.11
      }
    },
    {
      "wait": {
        "label": "Compare with Another Exercise",
        "role": "AXButton"
      }
    },
    {
      "tap": {
        "label": "Compare with Another Exercise",
        "role": "AXButton"
      }
    },
    {
      "wait": {
        "identifier": "exercisePickerFilterAll",
        "value": "Selected"
      }
    }
  ],
  "required": [
    {
      "identifier": "exercisePickerFilterAll",
      "value": "Selected"
    },
    {
      "identifier": "exercisePickerFilterFavorites",
      "value": "Not selected"
    }
  ],
  "forbidden": [
    {
      "label": "Barbell Bench Press, Barbell · Horizontal Push"
    }
  ]
}
